---
/**
 * Page shell: <head> with SEO + fonts + JSON-LD, header, main, footer, mobile bar.
 * Every page passes `lang`, `title`, `description`, `pageKey` (+ `subs` for item pages).
 */
import '@/styles/fonts.css';
import '@/styles/global.css';
import onestLatin from '@/assets/fonts/onest-latin.woff2?url';
import onestCyrillic from '@/assets/fonts/onest-cyrillic.woff2?url';
import { langMeta, pick, sourceOf, type Locale } from '@/i18n/config';
import { alternates as buildAlternates, pagePath, subFor, type PageKey } from '@/i18n/routes';
import { site } from '@/lib/site';
import { organizationNode, websiteNode, webPageNode, breadcrumbNode, type Crumb } from '@/lib/schema';
import Seo from '@/components/Seo.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBar from '@/components/MobileBar.astro';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  pageKey: PageKey;
  /** Item slug per locale. uzc may be omitted — it is looked up in the routes table instead. */
  subs?: Partial<Record<Locale, string>>;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Extra schema.org nodes appended to the page @graph. */
  jsonLd?: Array<Record<string, unknown>>;
  breadcrumbs?: Crumb[];
  datePublished?: string;
  dateModified?: string;
  bodyClass?: string;
  hideMobileBar?: boolean;
}
const { lang, title, description, pageKey, subs, ogImage, ogType, noindex, jsonLd = [], breadcrumbs, datePublished, dateModified, bodyClass, hideMobileBar = false } = Astro.props;
const siteUrl = Astro.site ?? new URL(site.url);
const alternates = buildAlternates(siteUrl, pageKey, subs);
// `subFor`, not `subs?.[lang]`: most `subs` maps come from content and carry only uz/ru/en, so
// on /kirill/ the item slug has to come from the hand-written table in routes.ts.
const currentPath = pagePath(lang, pageKey, subs && subFor(lang, pageKey, subs));
const pageUrlAbs = new URL(currentPath, siteUrl).toString();
const graph: Array<Record<string, unknown>> = [
  organizationNode(lang),
  websiteNode(lang),
  webPageNode(lang, { url: pageUrlAbs, name: title, description, datePublished, dateModified, type: ogType === 'article' ? 'WebPage' : 'WebPage' }),
  ...(breadcrumbs?.length ? [breadcrumbNode(lang, breadcrumbs)] : []),
  ...jsonLd,
];
const skipLink = pick(lang, { uz: 'Asosiy kontentga oʻtish', ru: 'Перейти к содержанию', en: 'Skip to content' });
// There is no /og/uzc.png: the OG card is a picture of a brand, not a translated page, and
// `sourceOf` sends the Cyrillic locale to the Latin Uzbek card rather than to a 404. Drop a real
// uzc card into public/og/ (scripts/generate-og.mjs) and change this line to use `lang` directly.
const localeOg = ogImage ?? `/og/${sourceOf(lang)}.png`;
---
<!doctype html>
<html lang={langMeta[lang].htmlLang} dir="ltr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo lang={lang} title={title} description={description} pageKey={pageKey} subs={subs} ogImage={localeOg} ogType={ogType} noindex={noindex} publishedTime={datePublished} modifiedTime={dateModified} />
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    {/* Cyrillic subset: preloaded on the two locales whose body text is Cyrillic. On uz/en it is
        still declared in fonts.css by unicode-range, so the switcher's two Cyrillic labels do not
        pull it down. */}
    {(lang === 'ru' || lang === 'uzc') && <link rel="preload" href={onestCyrillic} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <JsonLd data={graph} />
    <slot name="head" />
  </head>
  <body class:list={[bodyClass, !hideMobileBar && 'has-mobile-bar']}>
    <a href="#main" class="skip-link">{skipLink}</a>
    <Header lang={lang} alternates={alternates} currentPath={currentPath} />
    <main id="main" tabindex="-1" class="page-main">
      <div class="gutter-line" aria-hidden="true"></div>
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
    {!hideMobileBar && <MobileBar lang={lang} />}
    <script>
      // Reveal-on-scroll: adds .is-in to .reveal elements as they enter; respects reduced motion.
      // Scroll hint: mark scrollers that overflow so global.css fades their trailing edge.
      const scrollers = Array.from(document.querySelectorAll<HTMLElement>('.table-wrap, .scroll-x'));
      const markScroll = (el: HTMLElement) => {
        const over = el.scrollWidth - el.clientWidth > 2;
        if (!over) { el.removeAttribute('data-overflow'); return; }
        el.dataset.overflow = el.scrollLeft + el.clientWidth >= el.scrollWidth - 2 ? 'end' : el.scrollLeft > 2 ? 'mid' : 'start';
      };
      scrollers.forEach((el) => { markScroll(el); el.addEventListener('scroll', () => markScroll(el), { passive: true }); });
      window.addEventListener('resize', () => scrollers.forEach(markScroll));

      // Tag every table with its column count so a 2-column table can drop the mobile min-width
      // instead of pushing its value column off-screen.
      document.querySelectorAll<HTMLTableElement>('table').forEach((t) => {
        const row = t.querySelector('tr');
        if (row) t.dataset.cols = String(row.children.length);
      });
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (els.length) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); }
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
          els.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>
<style is:global>
  .page-main { position: relative; }
</style>
