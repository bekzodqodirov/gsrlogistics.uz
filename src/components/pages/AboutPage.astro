---
/** /biz-haqimizda/ — company story, values, places, team roles, verifiable facts, CTA. Props: { lang }. */
import type { Lang } from '@/i18n/config';
import { common } from '@/i18n/common';
import { about } from '@/i18n/about';
import { servicesStrings } from '@/i18n/services';
import { pagePath } from '@/i18n/routes';
import { site, phoneUrl, telegramChat } from '@/lib/site';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = about[lang];
const c = common[lang];
const sv = servicesStrings[lang];
const aboutLabel = c.nav.find((n) => n.key === 'about')?.label ?? t.eyebrow;
const breadcrumbs = [{ name: c.breadcrumbHome, key: 'home' as const }, { name: aboutLabel, key: 'about' as const }];
const aboutNode = { '@type': 'AboutPage', name: t.h1, description: t.seoDescription, mainEntity: { '@id': `${site.url}/#organization` } };
---
<Base lang={lang} title={t.seoTitle} description={t.seoDescription} pageKey="about" breadcrumbs={breadcrumbs} jsonLd={[aboutNode]}>
  <article class="page">
    <header class="hero">
      <div class="container">
        <Breadcrumbs lang={lang} items={[{ name: aboutLabel }]} />
        <Eyebrow class="eyebrow-gap">{t.eyebrow}</Eyebrow>
        <h1 class="display-2 measure-head">{t.h1}</h1>
        <p class="intro answer">{t.intro}</p>
      </div>
    </header>

    <div class="facts-wrap">
      <div class="container">
        <ul class="facts" role="list" aria-label={sv.page.factsLabel} data-count={t.facts.length}>
          {t.facts.map((f) => (
            <li class="fact">
              <p class:list={['fact-value', 'tnum', f.value.length > 12 && 'is-long']}>{f.value}</p>
              <p class="caption fact-label">{f.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <section class="section-sm">
      <div class="container two">
        <h2 class="h2 sticky">{t.story.heading}</h2>
        <div class="prose-col">{t.story.paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>

    <section class="section-sm">
      <div class="container">
        <h2 class="h2 mb">{t.how.heading}</h2>
        <ol class="values" role="list">
          {t.how.items.map((it, i) => <li class="card"><span class="idx tnum">0{i + 1}</span><h3 class="h4">{it.title}</h3><p class="fg2">{it.text}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="section-sm">
      <div class="container">
        <h2 class="h2 mb">{t.places.heading}</h2>
        <div class="grid grid-2">
          <div class="card place">
            <Icon name="warehouse" size={28} />
            <h3 class="h4">{t.places.china.title}</h3>
            <p class="fg2">{t.places.china.text}</p>
            <dl class="cities">
              <dt>{t.places.china.citiesLabel}</dt>
              <dd>{site.chinaWarehouses.map((w, i) => <><span>{w.city[lang]}<span class="zh" lang="zh">{w.cityZh}</span></span>{i < site.chinaWarehouses.length - 1 ? <span class="sep" aria-hidden="true">·</span> : null}</>)}</dd>
            </dl>
            <div class="cluster">
              <a class="link" href={`${pagePath(lang, 'contact')}#xitoy`}>{t.places.china.addressesLink}</a>
            </div>
          </div>
          <div class="card place">
            <Icon name="map-pin" size={28} />
            <h3 class="h4">{t.places.tashkent.title}</h3>
            <p class="fg2">{t.places.tashkent.text}</p>
            <p class="small muted">{t.places.tashkent.directions}</p>
            <div class="cluster">
              <a class="link" href={site.yandexMapsUrl} target="_blank" rel="noopener">{c.strings.viewOnMap}</a>
              <a class="link" href={pagePath(lang, 'contact')}>{c.nav.find((n) => n.key === 'contact')?.label}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-sm">
      <div class="container two">
        <div class="sticky"><h2 class="h2">{t.team.heading}</h2><p class="muted" style="margin-top:12px;max-width:40ch">{t.team.text}</p></div>
        <ul class="roles" role="list">
          {t.team.roles.map((r) => <li><h3 class="h4">{r.title}</h3><p class="fg2">{r.text}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="section-sm">
      <div class="container">
        <div class="honesty">
          <h2 class="h3">{t.honesty.heading}</h2>
          <p class="fg2">{t.honesty.text}</p>
        </div>
      </div>
    </section>

    <section class="section dark cta">
      <div class="container">
        <Eyebrow>{c.nav.find((n) => n.key === 'contact')?.label}</Eyebrow>
        <h2 class="display-2 measure-head">{t.cta.title}</h2>
        <p class="intro" style="margin-top:12px;max-width:52ch">{t.cta.text}</p>
        <div class="cluster" style="margin-top:28px">
          <Button href={telegramChat(c.telegramDraft.general)} variant="primary" icon="telegram">{c.cta.telegram}</Button>
          <Button href={phoneUrl} variant="secondary" icon="phone">{c.cta.call}</Button>
        </div>
        <p class="caption tnum" style="margin-top:20px">{site.phoneDisplay} · {site.hours[lang]}</p>
      </div>
    </section>
  </article>
</Base>
<style>
  .hero { padding-top: clamp(24px, 3vw, 40px); padding-bottom: clamp(24px, 4vw, 48px); }
  .hero :global(.breadcrumbs-nav) { margin-bottom: clamp(24px, 4vw, 48px); }
  .hero :global(.eyebrow-gap) { margin-bottom: 16px; }
  .answer { margin-top: 20px; max-width: 62ch; }
  /* same proof strip as the service pages and the pricing page: a full-bleed band, not a bare rule */
  .facts-wrap { background: var(--bg-3); border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .facts[data-count='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fact { padding: 24px 24px 20px 0; display: grid; align-content: start; gap: 8px; min-width: 0; }
  .fact + .fact { border-left: 1px solid var(--border-soft); padding-left: 24px; }
  .fact-value { font-size: clamp(1.5rem, 1.6vw + 0.9rem, 2.25rem); line-height: 1.05; font-weight: 700; letter-spacing: -0.025em; color: var(--fg); text-wrap: balance; overflow-wrap: anywhere; }
  .fact-value.is-long { font-size: clamp(1.25rem, 0.6vw + 1rem, 1.5rem); letter-spacing: -0.012em; line-height: 1.2; }
  .fact-label { max-width: 28ch; text-wrap: pretty; }
  @media (max-width: 899px) {
    .facts, .facts[data-count='3'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fact { padding: 18px 16px 16px 0; }
    .fact + .fact { border-left: 0; padding-left: 0; }
    .fact:nth-child(even) { border-left: 1px solid var(--border-soft); padding-left: 16px; }
    .fact:nth-child(n + 3) { border-top: 1px solid var(--border-soft); }
  }
  .stat-sm { font-size: clamp(28px, 2vw + 16px, 40px); font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .two { display: grid; gap: 24px; }
  @media (min-width: 900px) { .two { grid-template-columns: 5fr 7fr; gap: 48px; } .sticky { position: sticky; top: 96px; align-self: start; } }
  .prose-col { max-width: 62ch; }
  .prose-col p + p { margin-top: 1em; }
  .prose-col p { color: var(--fg-2); }
  .mb { margin-bottom: 28px; }
  .values { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .values li { display: grid; gap: 10px; align-content: start; }
  .idx { font-size: var(--text-small); color: var(--fg); font-weight: 600; }
  .values li:first-child .idx { color: var(--accent-text); } /* one red index per section */
  .fg2 { color: var(--fg-2); }
  .place { display: grid; gap: 12px; align-content: start; }
  .cities { display: grid; gap: 4px; margin: 0; }
  .cities dt { font-size: var(--text-small); color: var(--muted); }
  .cities dd { display: flex; flex-wrap: wrap; align-items: baseline; margin: 0; font-weight: 600; color: var(--fg); }
  .cities .zh { margin-left: 6px; font-size: var(--text-small); font-weight: 500; color: var(--meta); }
  .cities .sep { margin: 0 8px; color: var(--meta); font-weight: 400; }
  .roles { display: grid; gap: 0; }
  .roles li { padding: 20px 0; border-top: 1px solid var(--border-soft); display: grid; gap: 6px; }
  .roles li:last-child { border-bottom: 1px solid var(--border-soft); }
  .honesty { border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: clamp(20px, 3vw, 32px); display: grid; gap: 10px; max-width: 72ch; }
  .cta { padding-top: 96px; }
</style>
