---
/**
 * Service page template (DESIGN_BRIEF §7.1). Renders the ServiceContent shape from
 * src/data/services/<key>.content.ts; when that file is missing it falls back to the
 * short copy in src/data/services.ts so the build never fails.
 * Props: { lang, service, content? }.
 *
 * Two kinds of page, decided by the registry (`ServiceMeta.quote`):
 *   · a tariff page (the nine China → Tashkent services): calculator button, "Estimate · Updated" captions,
 *     the "Price and time" sticky card with its headline figure, Telegram + phone in the closing band;
 *   · an on-request page (`quote: 'request'` — cargo to Afghanistan, transit documents, the warehouse under
 *     customs control): no price or transit time is published for it, and the calculator prices China →
 *     Tashkent only, so the page links to no calculator and prints no estimate caption. Its buttons are
 *     Telegram and WhatsApp, the two channels these clients are told to use. See `onRequest` below.
 *     The phone bar follows: the layout's own bar (Telegram · call · price calculator) is told to show WhatsApp
 *     in the calculator's place (`mobileBarWhatsapp`), so it stays where it is on every page — after the footer,
 *     outside <main>.
 */
import { langMeta, pick, type Locale } from '@/i18n/config';
import { common } from '@/i18n/common';
import { servicesStrings, serviceNumberLine, tpl } from '@/i18n/services';
import { pagePath, itemPath, itemUrl, subFor } from '@/i18n/routes';
import { services, serviceByKey, serviceSubs, type ServiceMeta } from '@/data/services';
import type { ServiceContent, ServiceSection } from '@/data/services/types';
import { guideSlugs } from '@/data/guides';
import { site, phoneUrl, phone2Url, whatsappChat } from '@/lib/site';
import { BIDI_CONTROLS, leadAttrs, serviceTeam, telegramFor } from '@/lib/leads';
import { colon, fmtDate, fmtInt, fmtNumRange, sep } from '@/lib/format';
import { faqNode, serviceNode } from '@/lib/schema';
import tariffs from '@/data/tariffs.json';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

/**
 * `content` arrives ALREADY RESOLVED to one locale — the page reads `getServiceContent(key)` and
 * hands over one branch. A /kirill/ page must resolve it with `pick('uzc', byLang)`, never with
 * `.uz`: this component transliterates nothing itself, so the Latin branch would print a Latin body
 * under Cyrillic chrome. Everything else on the page goes through `pick` here.
 */
interface Props { lang: Locale; service: ServiceMeta; content?: ServiceContent }
const { lang, service, content } = Astro.props;
const t = pick(lang, servicesStrings);
const c = pick(lang, common);
const name = pick(lang, service.name);
const short = pick(lang, service.short);
const index = services.indexOf(service) + 1;
const indexLabel = fmtInt(index, lang, 2);
const updatedIso = content?.updated ?? tariffs.updated;
const updated = fmtDate(updatedIso, lang);
const estimateMeta = `${c.strings.estimateMeta}${colon(lang)}${fmtDate(tariffs.updated, lang)}`;
/**
 * No tariff is published for this service (owner, 2026-11-11: price, transit time and the smallest lot are on
 * request). Everything below that would print a price caption, a headline figure or a calculator link asks this
 * first. A tariff page must render exactly as it did before this switch existed — which is why each button in the
 * markup is its own `onRequest ? … : …` expression, standing where its element stood: wrapping a pair of buttons
 * in a fragment changed the white space between them on the nine tariff pages.
 */
const onRequest = service.quote === 'request';

/* ---------- Resolve page model (content or fallback) ---------- */
const fb = t.page.fallback;
const seoTitle = content?.seo.title ?? tpl(fb.seoTitle, { name });
const seoDescription = content?.seo.description ?? tpl(fb.seoDescription, { short });
const eyebrow = content?.hero.eyebrow ?? `${tpl(t.page.serviceIndex, { n: indexLabel })} — ${fb.eyebrow}`;
const h1 = content?.hero.h1 ?? name;
const intro = content?.hero.intro ?? tpl(fb.intro, { short });
const facts = (content?.hero.facts?.length ? content.hero.facts : fb.facts).slice(0, 4);
const sections: ServiceSection[] = content?.sections ?? [{ heading: fb.sectionTitle, body: fb.sectionBody }];
const faq = content?.faq ?? [];
const relatedKeys = (content?.related?.length ? content.related : services.filter((s) => s.key !== service.key).slice(0, 3).map((s) => s.key)).filter((k) => k !== service.key).slice(0, 3);
const related = relatedKeys.map((k) => serviceByKey(k)).filter(Boolean);
const guides = (content?.guideKeys ?? []).map((k) => ({ key: k, slug: guideSlugs[k]?.[lang], title: t.guideTitles[k] })).filter((g) => g.slug && g.title);
const cta = content?.cta ?? { title: fb.ctaTitle, text: fb.ctaText, draft: tpl(fb.draft, { name }) };
/** This page already knows its service, so its Telegram buttons skip the picker and open that service's team. */
const team = serviceTeam[service.key];
const tgHref = telegramFor(team, cta.draft, Astro.url.pathname);
/** With JavaScript: GSR's system picks the team's manager, filed under the service's Uzbek slug. */
const tgLead = leadAttrs(team, service.slug.uz, name);
/**
 * On-request pages: WhatsApp with the page's own draft (`cta.draft`), opened in a new tab by Button like every
 * external link. A plain link — no team, topic or code goes with it. Bidi controls never leave the site in a
 * message (see lib/leads.ts); the ZWNJ of Persian words is not one of them and stays.
 */
const waHref = whatsappChat(cta.draft.replace(BIDI_CONTROLS, '').trim());
/* The number printed under the buttons. On an on-request page it is the WhatsApp number the page's own text gives —
   a trader saves the number he sees under the WhatsApp button, and the main line is not on WhatsApp. Elsewhere the
   main line, as before. */
const shownPhone = onRequest ? { url: phone2Url, display: site.phone2Display } : { url: phoneUrl, display: site.phoneDisplay };
const daysFor: Partial<Record<string, [number, number]>> = { truck: tariffs.truck.days as [number, number], air: tariffs.air.days as [number, number], rail: tariffs.rail.days as [number, number] };
const days = daysFor[service.key];
/** A figure in ASCII or Persian digits (a fa fact reads "۱۵ تا ۲۵"). */
const DIGIT = /[0-9۰-۹]/;
const digitFact = facts.find((f) => DIGIT.test(f.value));
/* An on-request page has no headline figure, whatever its facts say: a digit in a fact there is not a price or a
   transit time, and the card's label already reads "price and timing — on request". */
const stickyStat = onRequest ? undefined : days
  ? { value: fmtNumRange(days[0], days[1], lang), unit: t.line.days, label: t.page.stickyDays }
  : digitFact ? { value: digitFact.value, unit: '', label: digitFact.label } : undefined;
/* Under a table: its own note, else the "Estimate · Updated" caption — which an on-request page never prints. */
/* The related cards below: an on-request page prints no price figure, so there the number line of a related TARIFF
   service ("commission from 3%", "insurance 1%") is left out; a related on-request service keeps its line. */
const tableNote = (note?: string) => note ?? (onRequest ? undefined : estimateMeta);
const numberLine = serviceNumberLine(lang, service.key);
const subs = serviceSubs(service);
const pageAbs = itemUrl(site.url, lang, 'services', service.slug);

/* ---------- Breadcrumbs ---------- */
const servicesLabel = c.nav.find((n) => n.key === 'services')?.label ?? t.index.eyebrow;
const breadcrumbs = [
  { name: c.breadcrumbHome, key: 'home' as const },
  { name: servicesLabel, key: 'services' as const },
  { name, key: 'services' as const, sub: subFor(lang, 'services', service.slug) },
];

/* ---------- JSON-LD: Service (+ offers from tariffs.json / site.ts for truck, air, rail, buying) + FAQPage ---------- */
const offers = service.key === 'truck'
  ? [
      ...tariffs.truck.lclPerM3ByDensity.map((r, i, all) => ({ price: r.rate, unitCode: 'MTQ' as const, minM3: tariffs.truck.minM3, validThrough: tariffs.validThrough, description: r.maxKgM3 ? `≤ ${r.maxKgM3} kg/m³` : `< ${tariffs.truck.perKgFromDensityKgM3} kg/m³` })),
      { price: tariffs.truck.perKgAboveDensity, unitCode: 'KGM' as const, minM3: tariffs.truck.minM3, validThrough: tariffs.validThrough, description: `≥ ${tariffs.truck.perKgFromDensityKgM3} kg/m³, per kg` },
    ]
  : service.key === 'air'
    ? [{ price: tariffs.air.perKg.standard, unitCode: 'KGM' as const, validThrough: tariffs.validThrough, description: 'standard' }]
    : service.key === 'rail'
      ? [
          { minPrice: tariffs.rail.container20ft[0], maxPrice: tariffs.rail.container20ft[1], unitText: '20 ft container, China → Tashkent, estimate', validThrough: tariffs.validThrough, description: '20 ft container' },
          { minPrice: tariffs.rail.container40ft[0], maxPrice: tariffs.rail.container40ft[1], unitText: '40 ft container, China → Tashkent, estimate', validThrough: tariffs.validThrough, description: '40 ft container' },
        ]
      : service.key === 'buying'
        ? [{ price: site.sourcingCommissionPct, percent: true, unitText: '% of the order value', validThrough: tariffs.validThrough, description: 'buying-agent commission, from' }]
        : undefined;
const jsonLd: Array<Record<string, unknown>> = [
  serviceNode(lang, { name, description: seoDescription, url: pageAbs, serviceType: service.name.en, offers, areaServed: service.area }),
  ...(faq.length ? [faqNode(faq)] : []),
];

/* ---------- Helpers ---------- */
/* A table cell that is a figure: ASCII or Persian digits, their separators (٫ ٬ ٪ included), then units
   in any of the site's scripts — Latin, Cyrillic, Persian (with ZWNJ: "۱۵ تا ۲۵ روز") or Chinese ("15–25 天"). */
const isNumeric = (s: string) => /^[\s\d۰-۹.,٫٬–\-−+~≈$%٪€₽/×÷]*[\d۰-۹][\s\d۰-۹.,٫٬–\-−+~≈$%٪€₽/×÷a-zA-Zа-яА-Я³²ʻʼ؀-ۿ‌一-鿿]*$/.test(s.trim()) && s.trim().length <= 24 && DIGIT.test(s);
/* Every locale: a 2-column table (label + value) gets .fits and stops scrolling on phones. Under the 560px minimum
   its value column — the price the table exists to show — sat off-screen behind the edge fade (on RTL pages the
   values, end-aligned, were the LEFT edge). Decided here on the server, not from Base.astro's data-cols: this
   page's own 560px minimum (.tbl .table) outranks global.css's [data-cols='2'] rule, which cannot free it.
   RTL (fa) only, so the other locales render byte-identical: a table cell with no Persian letter ("1688.com",
   "Taobao / Tmall") is one left-to-right island; left to the bidi algorithm, a domain that starts with a digit
   reads "com.1688". */
const rtl = langMeta[lang].dir === 'rtl';
const ltrCell = (s: string) => rtl && /[A-Za-z]/.test(s) && !/[\u0600-\u06FF]/.test(s);
const fitsTable = (head: string[]) => head.length < 3;
/* On phones global.css end-aligns the value column of every 2-column table: right for a price ("1 $/kg"), ragged
   for a sentence. An on-request page has no price tables — its 2-column tables are a term and its description — so
   there the value cell reads from the start. Inline on the cell, and absent on a tariff page, so the stylesheet
   shared with the nine tariff pages stays the same file. */
const proseCell = (head: string[]) => (onRequest && fitsTable(head) ? 'text-align:start' : undefined);
/* zh (decided here too, so the other locales render byte-identical):
   - a fact value is "long" by its width, a Han character counting as two Latin ones: «110 美元/m³ 起» (11 characters)
     stayed at 36px, wrapped and tore «美 / 元»;
   - a value cell is end-aligned when its whole column is figures, like the head: per cell, «3% 起» or «300 kg 以上的
     同类货物» (a figure first, the postposition after) went to the end while «最高 5%» or «每件 1 美元» stayed at the start;
     such a figure keeps .fig, which only stops it wrapping («0.40 / 美元/kg» in a narrow value column).
   Where Chinese headings, cells and labels may break is decided after the build, on the zh pages only, by
   scripts/zh-breaks.mjs (polish-html): this template prints plain text in every locale. */
const zh = lang === 'zh';
const longFact = (v: string) => (zh ? [...v].reduce((n, ch) => n + (/[\u2E80-\u9FFF\uF900-\uFAFF\uFF00-\uFFEF]/.test(ch) ? 2 : 1), 0) > 11 : v.length > 12);
const numCol = (rows: string[][], ci: number) => ci > 0 && rows.every((r) => !r[ci] || isNumeric(r[ci]));
const slugify = (_s: string, i: number) => `s-${i + 1}`;
const toneIcon = (tone?: 'info' | 'warn' | 'success') => (tone === 'success' ? 'check-circle' : 'info');
---
<Base lang={lang} title={seoTitle} description={seoDescription} pageKey="services" subs={subs} breadcrumbs={breadcrumbs} jsonLd={jsonLd} dateModified={updatedIso} mobileBarWhatsapp={onRequest ? waHref : undefined}>
  <article class="page">
    <header class="hero">
      <div class="container">
        <Breadcrumbs lang={lang} items={[{ name: servicesLabel, key: 'services' }, { name }]} />
        <Eyebrow class="eyebrow-gap">{eyebrow}</Eyebrow>
        <h1 class="display-2 measure-head">{h1}</h1>
        <p class="intro answer">{intro}</p>
        <div class="cta-row">
          {onRequest
            ? <Button href={tgHref} variant="primary" icon="telegram" {...tgLead}>{c.cta.telegram}</Button>
            : <Button href={pagePath(lang, 'calculator')} variant="primary">{c.cta.calculate}</Button>}
          {onRequest
            ? <Button href={waHref} variant="secondary" icon="whatsapp">{c.cta.whatsapp}</Button>
            : <Button href={tgHref} variant="secondary" icon="telegram" {...tgLead}>{c.cta.telegram}</Button>}
        </div>
      </div>
    </header>

    <div class="facts-wrap">
      <div class="container">
        <ul class="facts" role="list" aria-label={t.page.factsLabel} data-count={facts.length}>
          {facts.map((f) => (
            <li class="fact">
              <p class:list={['fact-value', 'tnum', longFact(f.value) && 'is-long']}>{f.value}</p>
              <p class="caption fact-label">{f.label}</p>
            </li>
          ))}
        </ul>
        <p class="caption facts-meta">{onRequest ? t.page.requestMeta : estimateMeta}</p>
      </div>
    </div>

    <div class="container body-grid">
      <div class="body">
        {sections.map((sec, i) => (
          <section class="block" id={slugify(sec.heading, i)} aria-labelledby={`${slugify(sec.heading, i)}-h`}>
            <h2 id={`${slugify(sec.heading, i)}-h`}>{sec.heading}</h2>
            {sec.body.map((p) => <p class="para">{p}</p>)}
            {sec.bullets?.length ? (
              <ul class="bullets">
                {sec.bullets.map((b) => <li><span class="tick" aria-hidden="true"><Icon name="check" size={16} /></span><span>{b}</span></li>)}
              </ul>
            ) : null}
            {sec.steps?.length ? (
              <ol class="steps">
                {sec.steps.map((st, j) => (
                  <li class="step">
                    <span class="step-index tnum" aria-hidden="true">{fmtInt(j + 1, lang, 2)}</span>
                    <div class="step-body">
                      <h3 class="step-title">{st.title}</h3>
                      <p class="step-text">{st.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            ) : null}
            {sec.table ? (
              <figure class="tbl">
                {sec.table.caption && <figcaption class="tbl-caption">{sec.table.caption}</figcaption>}
                <div class="table-wrap">
                  <table class:list={['table', fitsTable(sec.table.head) && 'fits']}>
                    <thead>
                      <tr>{sec.table.head.map((h, hi) => <th scope="col" class:list={[numCol(sec.table!.rows, hi) && 'num']}>{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {sec.table.rows.map((r) => (
                        <tr>{r.map((cell, ci) => ci === 0 ? <th scope="row">{ltrCell(cell) ? <span dir="ltr">{cell}</span> : cell}</th> : <td class:list={[(zh ? numCol(sec.table!.rows, ci) : isNumeric(cell)) && 'num', zh && isNumeric(cell) && 'fig']} style={proseCell(sec.table!.head)}>{ltrCell(cell) ? <span dir="ltr">{cell}</span> : cell}</td>)}</tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {tableNote(sec.table.note) && <p class="caption tbl-meta">{tableNote(sec.table.note)}</p>}
              </figure>
            ) : null}
            {sec.callout ? (
              <aside class:list={['callout', `tone-${sec.callout.tone ?? 'info'}`]}>
                <span class="callout-icon" aria-hidden="true">
                  {sec.callout.tone === 'warn'
                    ? <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 3 20h18L12 4Z"/><path d="M12 10v4M12 17h0"/></svg>
                    : <Icon name={toneIcon(sec.callout.tone)} size={20} />}
                </span>
                <div>
                  <p class="callout-title">{sec.callout.title}</p>
                  <p class="callout-text">{sec.callout.text}</p>
                </div>
              </aside>
            ) : null}
          </section>
        ))}

        {faq.length > 0 && (
          <section class="block faq" aria-labelledby="faq-h">
            <h2 id="faq-h">{t.page.faqTitle}</h2>
            <div class="faq-list">
              {faq.map((f) => (
                <details class="faq-item">
                  <summary>{f.q}</summary>
                  <div class="faq-body"><p>{f.a}</p></div>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="side">
        <div class="card side-card">
          <p class="caption side-label">{onRequest ? t.page.requestLabel : t.page.stickyLabel}</p>
          {stickyStat && <p class="side-stat"><span class="stat">{stickyStat.value}</span>{stickyStat.unit && <span class="num-unit">{stickyStat.unit}</span>}</p>}
          {stickyStat && <p class="caption side-fact">{stickyStat.label}</p>}
          <p class="side-line tnum">{numberLine}</p>
          <div class="side-actions">
            <Button href={tgHref} variant="primary" icon="telegram" block {...tgLead}>{c.cta.telegram}</Button>
            {onRequest
              ? <Button href={waHref} variant="secondary" icon="whatsapp" block>{c.cta.whatsapp}</Button>
              : <Button href={pagePath(lang, 'calculator')} variant="secondary" block>{c.cta.calculate}</Button>}
          </div>
          <p class="side-hint">{t.page.stickyHint}</p>
          {/* The number is the LTR island; the icon stays outside it, at the inline start. */}
          <p class="side-phone"><a href={shownPhone.url} class="tnum"><Icon name="phone" size={16} /><span dir="ltr">{shownPhone.display}</span></a></p>
          <p class="caption side-hours tnum">{pick(lang, site.hours)}</p>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related below-fold" aria-labelledby="related-h">
        <div class="container">
          <h2 id="related-h" class="related-title">{t.page.relatedTitle}</h2>
          <ul class="related-grid" role="list">
            {related.map((r) => (
              <li>
                <a href={itemPath(lang, 'services', r.slug)} class="card card-hover rel-card">
                  <span class="rel-glyph"><Icon name={r.icon} size={24} /></span>
                  <h3 class="rel-name">{pick(lang, r.name)}</h3>
                  <p class="rel-short">{pick(lang, r.short)}</p>
                  {(!onRequest || r.quote === 'request') && <p class="rel-num tnum">{serviceNumberLine(lang, r.key)}</p>}
                  <span class="link">{c.cta.details}</span>
                </a>
              </li>
            ))}
          </ul>
          {guides.length > 0 && (
            <div class="guides">
              <div class="guides-head">
                <h2 class="guides-title">{t.page.guidesTitle}</h2>
                <p class="guides-intro">{t.page.guidesIntro}</p>
              </div>
              <ul class="guides-list" role="list">
                {guides.map((g) => (
                  <li><a href={pagePath(lang, 'guides', g.slug)} class="guide-link"><Icon name="document" size={18} /><span>{g.title}</span><span class="chev" aria-hidden="true">›</span></a></li>
                ))}
              </ul>
            </div>
          )}
          <p class="caption updated"><Icon name="clock" size={14} />{c.updated}{colon(lang)}<time datetime={updatedIso}>{updated}</time></p>
        </div>
      </section>
    )}

    <section class="section dark noise cta below-fold" aria-labelledby="cta-h">
      <div class="container cta-inner">
        <Eyebrow>{t.page.ctaEyebrow}</Eyebrow>
        <h2 id="cta-h" class="display-2 measure-head cta-h2">{cta.title}</h2>
        <p class="intro cta-text">{cta.text}</p>
        <div class="cta-row">
          <Button href={tgHref} variant="primary" icon="telegram" {...tgLead}>{c.cta.telegram}</Button>
          {onRequest
            ? <Button href={waHref} variant="secondary" icon="whatsapp">{c.cta.whatsapp}</Button>
            : <Button href={phoneUrl} variant="secondary" icon="phone">{c.cta.call}</Button>}
        </div>
        <p class="caption cta-meta"><a href={shownPhone.url} class="tnum" dir="ltr">{shownPhone.display}</a>{sep(lang)}<span class="tnum">{pick(lang, site.hours)}</span></p>
      </div>
    </section>
  </article>
</Base>

<style>
  /* ----- Hero ----- */
  .hero { padding-top: clamp(24px, 3vw, 40px); padding-bottom: clamp(40px, 5vw, 64px); }
  .hero :global(.breadcrumbs-nav) { margin-bottom: clamp(24px, 4vw, 48px); }
  .hero :global(.eyebrow-gap) { margin-bottom: 16px; }
  .answer { max-width: 62ch; margin-top: 20px; color: var(--muted); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  /* ----- Fact rail ----- */
  .facts-wrap { background: var(--bg-3); border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .facts[data-count='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fact { padding-block: 24px 20px; padding-inline: 0 24px; display: grid; align-content: start; gap: 8px; min-width: 0; }
  .fact + .fact { border-inline-start: 1px solid var(--border-soft); padding-inline-start: 24px; }
  .fact-value { font-size: clamp(1.5rem, 1.6vw + 0.9rem, 2.25rem); line-height: 1.05; font-weight: 700; letter-spacing: -0.025em; color: var(--fg); text-wrap: balance; overflow-wrap: anywhere; }
  .fact-value.is-long { font-size: clamp(1.25rem, 0.6vw + 1rem, 1.5rem); letter-spacing: -0.012em; line-height: 1.2; }
  .fact-label { max-width: 28ch; text-wrap: pretty; }
  /* zh: a value breaks at its spaces only (110 / 美元/m³ 起, 比亚迪 · 极氪 / · 理想汽车), never inside 美元 or 极氪. */
  :global(:root:lang(zh)) .fact-value { word-break: keep-all; }
  :global(:root:lang(zh)) .tbl td.fig { white-space: nowrap; }
  .facts-meta { padding-bottom: 16px; }

  /* ----- Body + sticky side ----- */
  .body-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); padding-top: clamp(40px, 5vw, 72px); padding-bottom: clamp(40px, 5vw, 72px); }
  .body { max-width: var(--container-text); min-width: 0; }
  .block + .block { margin-top: clamp(40px, 5vw, 64px); padding-top: clamp(32px, 4vw, 48px); border-top: 1px solid var(--border-soft); }
  .block h2 { font-size: var(--text-h2); max-width: 32ch; margin-bottom: 16px; }
  .para { color: var(--fg-2); max-width: 70ch; text-wrap: pretty; }
  .para + .para { margin-top: 0.9em; }
