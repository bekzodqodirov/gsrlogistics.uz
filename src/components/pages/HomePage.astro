---
/**
 * Home page composition — shared by /, /ru/ and /en/.
 *
 * Order, and why (DESIGN_BRIEF §3 plus the 2026-09-10 refocus):
 *   hero (light) → journey (dark, pinned) → services (light) → HOW WE TRACK (dark) →
 *   SEGMENTS (grey band) → what you get (dark) → process (light) → pricing (surface) →
 *   tracking (dark) → FAQ (light) → CTA (dark).
 *
 * HowWeTrack sits immediately after Services because Services has just narrowed the company to
 * one business ("what do you do"), and the QR-per-carton + 24/7 bot is the answer to the question
 * the audit said the page never answered ("why you"). It is the strongest thing GSR has and it
 * belongs in the first half of the page, not next to the tracking form at 06.
 *
 * Segments then sits between HowWeTrack and Proof for two reasons: "is this for me" is the next
 * question a visitor asks once he believes the company can do the job, and the band's light plate
 * is the only breather between two dark sections — HowWeTrack's own file asks not to be placed
 * directly beside another dark band, and Proof cannot move without breaking the 03–08 eyebrow
 * numbering that PricingTeaser and TrackingTeaser hard-code.
 *
 * The two new sections carry no number in the eyebrow, like Journey: the numbered spine (02
 * services → 03 what you get → 04 process → 05 pricing → 06 tracking → 07 FAQ → 08 contact)
 * stays intact because 05 and 06 live in i18n files this stream does not own.
 */
import type { Lang } from '@/i18n/config';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import Journey from '@/components/journey/Journey.astro';
import Services from '@/components/sections/Services.astro';
import HowWeTrack from '@/components/sections/HowWeTrack.astro';
import Segments from '@/components/sections/Segments.astro';
import Proof from '@/components/sections/Proof.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import PricingTeaser from '@/components/sections/PricingTeaser.astro';
import TrackingTeaser from '@/components/sections/TrackingTeaser.astro';
import FaqShort from '@/components/sections/FaqShort.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { serviceNode } from '@/lib/schema';
import { pageUrl } from '@/i18n/routes';
import { site } from '@/lib/site';
import { services } from '@/data/services';
import tariffs from '@/data/tariffs.json';
import { fmtUsd } from '@/lib/format';

interface Props { lang: Lang }
const { lang } = Astro.props;

const fromRate = tariffs.truck.lclPerM3ByDensity[0].rate;
const seo: Record<Lang, { title: string; description: string }> = {
  uz: {
    title: 'Xitoydan Toshkentga kargo: yigʻma yuk 15–25 kun, avia 5–10 kun — GSR Logistics',
    description: `Xitoydan Oʻzbekistonga yuk tashish, tovar topish va sotib olish. Qabul manzillari: Ivu, Guanchjou va Qashqar. Ivu omboridan Xorgos orqali Toshkentgacha: yigʻma yuk taxminan 15–25 kun, avia 5–10 kun, ${fmtUsd(fromRate, 'uz')}/m³ dan. Bojxona rasmiylashtiruvi, foto-hisobot, 1688/Taobaodan xarid. Toshkent, 2018-yildan.`.replace('’', 'ʼ'),
  },
  ru: {
    title: 'Карго из Китая в Ташкент: сборный груз 15–25 дней, авиа 5–10 — GSR Logistics',
    description: `Доставка грузов из Китая в Узбекистан, поиск и выкуп товаров. Адреса приёма: Иу, Гуанчжоу и Кашгар. Со склада в Иу через Хоргос до Ташкента: сборный груз ориентировочно 15–25 дней, авиа 5–10 дней, от ${fmtUsd(fromRate, 'ru')}/м³. Растаможка, фотоотчёт, выкуп с 1688/Taobao. Ташкент, с 2018 года.`,
  },
  en: {
    title: 'Cargo from China to Tashkent: consolidated 15–25 days, air 5–10 — GSR Logistics',
    description: `Freight from China to Uzbekistan, product sourcing and buying. Receiving addresses in Yiwu, Guangzhou and Kashgar. From the Yiwu warehouse via Khorgos to Tashkent: consolidated truck cargo in roughly 15–25 days, air in 5–10, from ${fmtUsd(fromRate, 'en')}/m³. Customs clearance, photo reports, 1688/Taobao buying. Tashkent, since 2018.`,
  },
};
const siteUrl = Astro.site ?? new URL(site.url);
const serviceGraph = services.slice(0, 3).map((s) =>
  serviceNode(lang, {
    name: s.name[lang],
    description: s.short[lang],
    url: pageUrl(siteUrl, lang, 'services', s.slug[lang]),
    serviceType: s.key === 'air' ? 'Air freight' : s.key === 'rail' ? 'Rail freight' : 'Consolidated truck freight',
    offers: s.key === 'truck'
      ? [{ price: tariffs.truck.lclPerM3ByDensity[0].rate, unitCode: 'MTQ', validThrough: tariffs.validThrough, description: 'Consolidated truck cargo China → Tashkent, per m³ by density (estimate)' }]
      : s.key === 'air'
        ? [{ price: tariffs.air.perKg.standard, unitCode: 'KGM', validThrough: tariffs.validThrough, description: 'Air cargo China → Tashkent, per kg (estimate)' }]
        : undefined,
  }),
);
---
<Base lang={lang} title={seo[lang].title} description={seo[lang].description} pageKey="home" jsonLd={serviceGraph} dateModified={tariffs.updated}>
  <Hero lang={lang} />
  <Journey lang={lang} />
  <Services lang={lang} />
  <HowWeTrack lang={lang} />
  <Segments lang={lang} />
  <Proof lang={lang} index="03" />
  <HowItWorks lang={lang} index="04" />
  <PricingTeaser lang={lang} calculator />
  <TrackingTeaser lang={lang} />
  <FaqShort lang={lang} index="07" />
  <CtaBand lang={lang} number="08" />
</Base>
