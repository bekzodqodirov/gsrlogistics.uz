---
/**
 * Journey — the pinned, scroll-scrubbed cargo story (PROJECT_BRIEF §6, DESIGN_BRIEF §3.2 / §4).
 *
 * Server HTML carries everything: eyebrow + headline, the map, six caption cards, the progress rail, footnote.
 * Two layouts share that markup:
 *   static  — default. Route fully drawn, six cards stacked in normal flow, no pin. Used for no-JS,
 *             prefers-reduced-motion, the low-end gate, or if the GSAP chunk fails to load.
 *   live    — `.is-live` (set synchronously by the inline gate below). Stage is 100svh, the section
 *             reserves the full pin distance in CSS (6.5 × 100svh desktop / 5.5 mobile → CLS 0), and
 *             ./journey.ts (GSAP core + ScrollTrigger + MotionPathPlugin) is imported only when the
 *             section comes within 100 % rootMargin, and the observer that watches for that is armed
 *             after `load` so the chunk never competes with the hero; init() waits for idle (INP).
 * Props: { lang }.
 */
import { pick, type Lang } from '@/i18n/config';
import { journey } from '@/i18n/journey';
import { common } from '@/i18n/common';
import { pagePath } from '@/i18n/routes';
import { telegramChat } from '@/lib/site';
import { fmtRange, fmtDate, fmtNumber } from '@/lib/format';
import tariffs from '@/data/tariffs.json';
import { ROUTE_KM, ROUTE_KM_VERIFIED } from '@/data/route';
import Icon from '@/components/ui/Icon.astro';
import RouteMap from './RouteMap.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pick(lang, journey);
const c = common[lang];

const days = {
  truck: fmtRange(tariffs.truck.days[0], tariffs.truck.days[1], t.daysUnit, lang),
  rail: fmtRange(tariffs.rail.days[0], tariffs.rail.days[1], t.daysUnit, lang),
  air: fmtRange(tariffs.air.days[0], tariffs.air.days[1], t.daysUnit, lang),
};
const updated = `${c.updated}: ${fmtDate(tariffs.updated, lang)}`;
const kmFinal = `${fmtNumber(ROUTE_KM, lang)}${ROUTE_KM_VERIFIED ? '' : '+'}`;
/** Mode chips; `cap` is the km caption tail shown while that chip is active ("avto, taxminan 15–25 kun"). */
const chips = (['truck', 'rail', 'air'] as const).map((key) => ({ key, label: t.chips[key], days: days[key], cap: `${t.km.daysCaption[key]} ${days[key]}` }));
const idx = (i: number) => String(i + 1).padStart(2, '0');
const markL = 'M0 -50 L-43.3 -25 L-43.3 25 L-22.3 37.1 L20 12.7 L20 -5.77 L-28.3 22.1 L-33.3 19.23 L-33.3 -19.23 L10 -44.2 Z';
const markR = 'M0 50 L43.3 25 L43.3 -25 L22.3 -37.1 L-20 -12.7 L-20 5.77 L28.3 -22.1 L33.3 -19.23 L33.3 19.23 L-10 44.2 Z';
---
<section id="yol" class="journey dark" data-journey data-lang={lang} data-km={ROUTE_KM} data-km-verified={ROUTE_KM_VERIFIED ? '1' : '0'} data-stage="0" aria-labelledby="journey-title">
  <div class="journey-stage" data-j="stage">
    <div class="journey-map" data-j="map">
      <div class="cam" data-j="cam"><RouteMap lang={lang} /></div>
    </div>

    <header class="journey-head" data-j="head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="journey-title" class="display-2 measure-head" data-j="title">{t.title}</h2>
      <p class="journey-sub intro" data-j="sub">{t.sub}</p>
    </header>

    <div class="journey-sheet" data-j="sheet">
      <span class="sheet-handle" aria-hidden="true"></span>

      <nav class="journey-rail" aria-label={t.railLabel} data-j="rail">
        {t.stages.map((s, i) => (
          <button type="button" class="jrail-btn" data-j="rail-btn" data-stage={i + 1} aria-label={`${t.stageWord} ${i + 1}: ${s.short}`}>
            <svg viewBox="0 0 12 13" width="12" height="13" aria-hidden="true" focusable="false"><polygon points="6,0.8 11.2,3.55 11.2,9.45 6,12.2 0.8,9.45 0.8,3.55"></polygon></svg>
          </button>
        ))}
      </nav>

      <ol class="journey-cards" role="list" data-j="cards">
        {t.stages.map((s, i) => (
          <li class="jcard" data-j="card" data-stage={i + 1}>
            <article aria-labelledby={`jcard-${i + 1}`}>
              <p class="jcard-index tnum">
                {i === 5 && (
                  <span class="jmark" aria-hidden="true">
                    <svg viewBox="-50 -52 100 104" width="22" height="23"><path class="jmark-l" data-j="mark-l" d={markL}></path><path class="jmark-r" data-j="mark-r" d={markR}></path></svg>
                  </span>
                )}
                <span class="jcard-num">{idx(i)}</span>
                <span class="jcard-tick" data-j="tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2.5 12.5 4 4 7-8"></path><path d="m10.5 16 1 1 8-9"></path></svg><span class="sr-only">{t.done}</span></span>
              </p>
              <h3 class="jcard-title h3" id={`jcard-${i + 1}`}>{s.title}</h3>
              <p class="jcard-body">{s.body}</p>
              {s.facts.length > 0 && <p class="jcard-facts tnum">{s.facts.join(' · ')}</p>}
              {i === 2 && (
                <div class="jcard-transit">
                  <div class="jchips" role="group" aria-label={t.chipsLabel}>
                    {chips.map((ch, k) => (
                      <button type="button" class="jchip" data-j="chip" data-chip={k} data-cap={ch.cap} aria-pressed={k === 0 ? 'true' : 'false'}>
                        <span class="jchip-label">{ch.label}</span><span class="jchip-days tnum">{ch.days}</span>
                      </button>
                    ))}
                  </div>
                  <p class="jkm"><span class="jkm-num tnum" data-j="km">{kmFinal}</span><span class="num-unit">{t.km.unit}</span></p>
                  <p class="jkm-cap caption">{t.km.caption} · <span data-j="kmcap">{chips[0].cap}</span></p>
                </div>
              )}
              {i === 5 && (
                <div class="jcard-cta" data-j="cta">
                  <a class="btn btn-primary" href={pagePath(lang, 'calculator')}><Icon name="calculator" size={18} />{c.cta.calculate}</a>
                  <a class="link jcard-tg" href={telegramChat(c.telegramDraft.general)} target="_blank" rel="noopener">{c.cta.telegram}</a>
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>

      <p class="journey-foot caption" data-j="foot">{t.footnote} {updated}{lang === 'ru' ? '' : '.'}</p>
    </div>
  </div>
</section>

<!-- Synchronous gate: decides the layout before the next paint. Reduced motion, Save-Data and low-end devices keep the static layout.
     DESIGN_BRIEF §4.6: on phones ≤ 4 cores is static even when deviceMemory is unknown (Firefox/Safari never expose it);
     on desktop the same core count also needs ≤ 4 GB — a 4-thread laptop is not a Redmi. -->
<script is:inline>
  (function () {
    var el = document.getElementById('yol');
    if (!el || !('IntersectionObserver' in window)) return;
    var n = navigator, mem = n.deviceMemory, cores = n.hardwareConcurrency;
    var saveData = !!(n.connection && n.connection.saveData);
    var phone = /Mobi|Android/i.test(n.userAgent || '');
    var lowEnd = saveData || (mem && mem <= 2) || (cores && cores <= 4 && (phone || (mem && mem <= 4)));
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && !lowEnd) el.classList.add('is-live');
  })();
</script>

<script>
  // Lazy-load the GSAP module only when the live journey is within one viewport of the fold, and run its setup
  // only once the main thread is idle (≤ 1.5 s wait) so a tap on the hero CTAs never lands inside it (INP).
  // The observer itself is armed after `load`: with a one-viewport rootMargin it fires immediately on a
  // 900px-tall screen, which put the 55 KB gz GSAP chunk on the critical path against the hero's own resources.
  const root = document.querySelector<HTMLElement>('[data-journey].is-live');
  if (root) {
    const fail = () => { root.classList.remove('is-live'); };
    const idle = (fn: () => void) => ('requestIdleCallback' in window ? window.requestIdleCallback(fn, { timeout: 1500 }) : window.setTimeout(fn, 300));
    const load = () => {
      import('./journey')
        .then((m) => { idle(() => { try { m.init(root); } catch { fail(); } }); })
        .catch(fail);
    };
    const observe = () => {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '100% 0px 100% 0px' });
      io.observe(root);
    };
    if (document.readyState === 'complete') observe();
    else window.addEventListener('load', observe, { once: true });
  }
</script>

<style is:global>
  /* ============ section shell ============ */
  .journey { position: relative; background: var(--bg); color: var(--fg); overflow: clip; --j-card-w: 360px; --j-edge: max(var(--gutter), calc((100% - var(--container)) / 2)); }
  .journey .journey-stage { position: relative; display: flex; flex-direction: column; max-width: calc(var(--container) + 2 * var(--gutter)); margin-inline: auto; padding: var(--section-y) var(--gutter); }
  .journey .journey-head { order: -1; }
  .journey .journey-head { max-width: 40ch; margin-bottom: clamp(24px, 3vw, 40px); }
  .journey .journey-head .eyebrow { margin-bottom: 16px; }
  .journey .journey-sub { margin-top: 12px; color: var(--muted); }
  .journey .journey-map { position: relative; aspect-ratio: 1600 / 923; }
  .journey .cam { position: absolute; inset: 0; transform-origin: 0 0; }
  .journey .jmap { width: 100%; height: 100%; display: block; overflow: visible; font-family: var(--font-sans); --lbl: 14px; }
  .journey .sheet-handle { display: none; }
  .journey .journey-rail { display: none; }
  /* start, so a short card in the static fallback does not stretch to the tallest one in its row */
  .journey .journey-cards { display: grid; align-items: start; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); margin-top: clamp(24px, 3vw, 40px); }
  .journey .journey-foot { margin-top: 20px; color: var(--muted); max-width: 70ch; }

  /* ============ caption cards ============ */
  .journey .jcard { position: relative; background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius-lg); padding: 24px; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06); }
  .journey .jcard-index { display: flex; align-items: center; gap: 8px; font-size: var(--text-small); font-weight: 600; color: var(--accent-text); margin-bottom: 10px; line-height: 1; }
  .journey .jcard-tick { display: inline-flex; color: var(--muted); }
  .journey .jcard-title { margin-bottom: 8px; }
  .journey .jcard-body { color: var(--muted); font-size: var(--text-body); text-wrap: pretty; }
  .journey .jcard-facts { margin-top: 14px; font-size: var(--text-small); font-weight: 500; color: var(--fg-2); }
  .journey .jcard-transit { margin-top: 16px; }
  /* three equal columns, label over range: a single flex row wraps 1+2 once the ranges are printed,
     and the wrap point differs between desktop and mobile, so the same card reads differently on each */
  .journey .jchips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .journey .jchip { display: grid; justify-items: center; align-content: center; gap: 3px; min-height: 44px; padding: 6px 8px; border-radius: var(--radius-lg); border: 1px solid rgb(255 255 255 / 0.22); color: var(--muted); font-size: var(--text-small); font-weight: 500; line-height: 1.1; text-align: center; transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .journey .jchip-days { color: inherit; opacity: 0.8; font-size: 0.75rem; white-space: nowrap; }
  .journey .jchip[aria-pressed='true'] { background: var(--gray-100); border-color: var(--gray-100); color: var(--black); }
  .journey .jchip[aria-pressed='true'] .jchip-days { opacity: 0.7; }
  .journey .jkm { display: flex; align-items: baseline; gap: 4px; margin-top: 16px; }
  /* reserved width and a fixed line box: the counter runs 0 → 5 000+ during the scrub, and without them
     the unit beside it steps 3px vertically as digits are added */
  .journey .jkm-num { display: inline-block; min-width: 5ch; text-align: right; font-size: clamp(2rem, 1.5vw + 1.4rem, 2.5rem); line-height: 1; letter-spacing: -0.03em; font-weight: 700; }
  .journey .jkm-cap { margin-top: 6px; color: var(--muted); }
  .journey .jcard-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 20px; }
  .journey .jcard-tg { font-size: var(--text-small); }
  .journey .jmark { display: inline-flex; color: var(--red-600); margin-right: 4px; }
  .journey .jmark path { fill: currentColor; transform-box: fill-box; transform-origin: center; }
  .journey .jrail-btn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 44px; color: rgb(255 255 255 / 0.35); border-radius: var(--radius-sm); }
  .journey .jrail-btn svg { display: block; fill: none; stroke: currentColor; stroke-width: 1; transition: fill var(--dur) var(--ease), color var(--dur) var(--ease); }
  .journey .jrail-btn[data-done='1'] { color: var(--muted); }
  .journey .jrail-btn[data-done='1'] svg { fill: currentColor; }
  .journey .jrail-btn[aria-current='step'] { color: var(--accent-text); }
  .journey .jrail-btn[aria-current='step'] svg { fill: currentColor; }

  /* ============ map styling (global because the paths are injected) ============ */
  .journey .jmap .land { fill: var(--map-land); stroke: var(--map-stroke); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .journey .jmap .land-cn, .journey .jmap .land-uz { fill: color-mix(in oklab, var(--map-land), #fff 4%); }
  .journey:not(.is-live) .jmap { overflow: hidden; }
  .journey .jmap .jm-route-idle { fill: none; stroke: var(--route-idle); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .journey .jmap .jm-route { fill: none; stroke: var(--accent-text); stroke-width: 2; stroke-linecap: butt; stroke-linejoin: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .journey .jmap .jm-rail-idle { fill: none; stroke: rgb(255 255 255 / 0.08); stroke-width: 1; stroke-dasharray: 6 4; vector-effect: non-scaling-stroke; }
  .journey .jmap .jm-rail { fill: none; stroke: rgb(255 255 255 / 0.24); stroke-width: 1; stroke-dasharray: 6 4; vector-effect: non-scaling-stroke; }
  .journey .jmap .jm-rail-mask { stroke-dashoffset: 0; vector-effect: non-scaling-stroke; }
  .journey .jmap .jm-air { fill: none; stroke: rgb(255 255 255 / 0.12); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .journey .jmap .jm-kg { fill: none; stroke: rgb(255 255 255 / 0.1); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .journey .jmap .jm-dot { fill: var(--muted); }
  .journey .jmap .jm-city text { font-size: var(--lbl); font-weight: 500; fill: var(--muted); letter-spacing: 0; paint-order: stroke; stroke: var(--bg); stroke-width: 3px; stroke-linejoin: round; }
  .journey .jmap .jm-faint { opacity: 0.45; }
  .journey .jmap .jm-alt text { font-weight: 400; }
  .journey .jmap .j-mark { color: var(--gray-100); opacity: 0.7; }
  .journey .jmap .j-shed, .journey .jmap .j-parcel, .journey .jmap .j-container, .journey .jmap .j-pin, .journey .jmap .j-stamp, .journey .jmap .j-barrier { color: var(--gray-100); }
  .journey .jmap .j-post { stroke: var(--gray-100); stroke-width: 1.5; stroke-linecap: round; }
  .journey .jmap .j-door { fill: var(--accent-text); opacity: 0; transition: opacity var(--dur-slow) var(--ease); }
  .journey .jmap .j-capsule { fill: var(--black); stroke: var(--gray-100); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .journey .jmap .j-vehicle, .journey .jmap .j-van, .journey .jmap .j-plane { color: var(--gray-100); }
  .journey .jmap .j-head { fill: var(--accent-text); }
  .journey .jmap .j-halo { fill: var(--accent-text); opacity: 0.2; }
  .journey .jmap .j-plane { opacity: 0.5; }

  /* static final state (no JS / reduced motion / low-end / chunk failed) */
  .journey:not(.is-live) .jmap .j-parcel, .journey:not(.is-live) .jmap .j-container, .journey:not(.is-live) .jmap .j-vehicle, .journey:not(.is-live) .jmap .j-plane { opacity: 0; }
  .journey:not(.is-live) .jmap .j-bar { transform-box: fill-box; transform-origin: 100% 50%; transform: rotate(-60deg); }
  .journey:not(.is-live) .jmap .j-van { transform: translate(160px, 343px); }
  .journey:not(.is-live) .jmap .j-shed-tash .j-door { opacity: 1; }
  .journey:not(.is-live) .jcard-tick { opacity: 1; }
  @media (max-width: 599px) {
    .journey:not(.is-live) .jmap .jm-minor, .journey:not(.is-live) .jmap .jm-actors, .journey:not(.is-live) .jmap .jm-secondary { display: none; }
    .journey:not(.is-live) .jmap { --lbl: 34px; }
  }
  @media (min-width: 600px) and (max-width: 1099px) { .journey:not(.is-live) .jmap { --lbl: 20px; } }
  @media (max-width: 359px) { .journey .jmap .jm-secondary, .journey .jmap .jm-alt { display: none; } }
  @media (max-width: 899px) { .journey .jmap .j-halo, .journey .jmap .jm-alt { display: none; } }

  /* ============ live layout (pinned, scrubbed) ============ */
  .journey.is-live { height: calc(100svh * 6.5); }
  .journey.is-live .journey-stage { height: 100svh; max-width: none; padding: 0; overflow: hidden; background: var(--bg); }
  .journey.is-live .journey-map { position: absolute; inset: 0; aspect-ratio: auto; }
  .journey.is-live .journey-head { position: absolute; z-index: 2; left: var(--j-edge); top: calc(var(--header-h) + 28px); margin: 0; pointer-events: none; }
  .journey.is-live .journey-cards { margin: 0; gap: 0; grid-template-columns: 1fr; align-items: center; }
  .journey.is-live .jcard { grid-area: 1 / 1; opacity: 0; visibility: hidden; }
  .journey.is-live .jcard-tick { opacity: 0; }
  .journey.is-live .journey-rail { display: flex; gap: 2px; }
  /* initial state = stage 0 before GSAP takes over (the chunk sets everything explicitly) */
  .journey.is-live .jmap .jm-route { stroke-dashoffset: 1; }
  .journey.is-live .jmap .jm-rail-mask { stroke-dashoffset: 1; }
  .journey.is-live .jmap .j-parcel, .journey.is-live .jmap .j-container, .journey.is-live .jmap .j-vehicle, .journey.is-live .jmap .j-plane, .journey.is-live .jmap .j-stamp, .journey.is-live .jmap .j-barrier, .journey.is-live .jmap .j-van, .journey.is-live .jmap .j-pin { opacity: 0; }
  .journey.is-live[data-stage='1'] .j-shed-yiwu .j-door, .journey.is-live[data-stage='2'] .j-shed-yiwu .j-door, .journey.is-live[data-stage='5'] .j-shed-tash .j-door, .journey.is-live[data-stage='6'] .j-shed-tash .j-door { opacity: 1; }

  @media (min-width: 900px) {
    .journey.is-live .journey-sheet { display: contents; }
    .journey.is-live .journey-cards { position: absolute; right: var(--j-edge); top: 50%; transform: translateY(-50%); width: var(--j-card-w); z-index: 3; }
    .journey.is-live .journey-rail { position: absolute; left: var(--j-edge); bottom: 56px; z-index: 3; }
    .journey.is-live .journey-foot { position: absolute; left: var(--j-edge); bottom: 24px; margin: 0; max-width: 52ch; z-index: 3; }
  }
  @media (max-width: 899px) {
    .journey.is-live { height: calc(100svh * 5.5); }
    .journey.is-live .journey-map { inset: 0; }
    .journey.is-live .journey-head { top: calc(var(--header-h) + 12px); right: var(--gutter); }
    .journey.is-live .journey-head .display-2 { font-size: clamp(1.75rem, 6vw, 2.25rem); }
    .journey.is-live .journey-head .intro { font-size: 1rem; margin-top: 6px; }
    .journey.is-live .journey-sheet { position: absolute; left: 0; right: 0; bottom: calc(var(--mobile-bar-h) + env(safe-area-inset-bottom)); z-index: 40; background: var(--bg-2); border-radius: 24px 24px 0 0; padding: 8px var(--gutter) 10px; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06); }
    .journey.is-live .sheet-handle { display: block; width: 36px; height: 4px; border-radius: 2px; background: rgb(255 255 255 / 0.18); margin: 0 auto 4px; }
    .journey.is-live .journey-rail { justify-content: center; }
    .journey.is-live .journey-cards { align-items: start; }
    .journey.is-live .jmap .jm-minor { display: none; }
    .journey.is-live .jrail-btn { width: 40px; height: 40px; }
    .journey.is-live .jcard { padding: 4px 0 0; background: none; border: 0; box-shadow: none; }
    .journey.is-live .jcard-index { margin-bottom: 6px; }
    .journey.is-live .jcard-title { font-size: 1.375rem; margin-bottom: 4px; }
    .journey.is-live .jcard-body { font-size: 0.9375rem; }
    .journey.is-live .jcard-facts { margin-top: 8px; font-size: 0.8125rem; }
    .journey.is-live .jcard-transit { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: start; margin-top: 10px; }
    .journey.is-live .jchips { grid-column: 1 / -1; gap: 4px; }
    .journey.is-live .jchip { min-height: 44px; padding: 5px 4px; font-size: 0.8125rem; gap: 2px; }
    .journey.is-live .jkm { margin-top: 4px; }
    .journey.is-live .jkm-num { font-size: 1.75rem; }
    .journey.is-live .jkm-cap { margin-top: 4px; grid-column: 1 / -1; }
    .journey.is-live .jcard-cta { margin-top: 12px; gap: 8px 16px; }
    .journey.is-live .jcard-cta .btn { min-height: 44px; }
    .journey.is-live .journey-foot { margin-top: 8px; font-size: 11px; line-height: 1.3; }
  }
  @media (prefers-reduced-motion: reduce) { .journey .jmap .j-door { transition: none; } }
</style>
