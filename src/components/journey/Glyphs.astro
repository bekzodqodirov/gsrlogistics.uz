---
/**
 * Journey glyphs — one <defs> block of <symbol>s, meant to be rendered INSIDE the map <svg>.
 * Style: flat monoline on a 24-unit grid, 1.5 stroke, round caps/joins, currentColor,
 * `vector-effect="non-scaling-stroke"` so the line weight is constant at every camera zoom (width: .jm-actors).
 * Vehicles face LEFT because the route runs east → west (Yiwu → Tashkent).
 * The two half-marks are the hooks of the GSR "S" monogram (same paths as ui/Logo.astro).
 */
// No stroke-width here on purpose: it is inherited from .jm-actors (Journey.astro) so the phone can run a
// lighter line. A glyph is 39 px across on a desktop camera and 20-27 px on a phone; 1.5 px of non-scaling
// stroke is 4 % of the first and 7 % of the second, which closed the truck's cab and the pin's doorway into
// solid white blobs.
const S = 'fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"';
const V = 'vector-effect="non-scaling-stroke"';
---
<defs>
  <!-- parcel: small cube -->
  <symbol id="j-parcel" viewBox="0 0 24 24" set:html={`<g ${S}><path ${V} d="M4 8l8-4 8 4v8l-8 4-8-4Z"/><path ${V} d="M4 8l8 4 8-4M12 12v8"/></g>`}></symbol>
  <!-- container: ribbed box -->
  <symbol id="j-container" viewBox="0 0 24 24" set:html={`<g ${S}><rect ${V} x="2" y="7" width="20" height="11" rx="1.5"/><path ${V} d="M7 7v11M12 7v11M17 7v11"/></g>`}></symbol>
  <!-- warehouse: shed with a door -->
  <symbol id="j-shed" viewBox="0 0 24 24" set:html={`<g ${S}><path ${V} d="M3 21V9l9-5 9 5v12"/><path ${V} d="M2 21h20"/><path ${V} d="M8 21v-8h8v8"/><path ${V} d="M8 16.5h8"/></g>`}></symbol>
  <!-- truck: side view, cab on the left -->
  <symbol id="j-truck" viewBox="0 0 24 24" set:html={`<g ${S}><path ${V} d="M9 7h12v10H9Z"/><path ${V} d="M9 10H5.6L3 13.4V17h6"/><path ${V} d="M5.6 10v3.4H3"/><circle ${V} cx="6.5" cy="17.5" r="1.8"/><circle ${V} cx="16.5" cy="17.5" r="1.8"/></g>`}></symbol>
  <!-- rail wagon: side view -->
  <symbol id="j-wagon" viewBox="0 0 24 24" set:html={`<g ${S}><rect ${V} x="3" y="6" width="18" height="10" rx="1.5"/><path ${V} d="M3 11.5h18M2 19h20"/><circle ${V} cx="7" cy="18" r="1.5"/><circle ${V} cx="17" cy="18" r="1.5"/></g>`}></symbol>
  <!-- plane: top view, nose on the left -->
  <symbol id="j-plane" viewBox="0 0 24 24" set:html={`<g ${S}><path ${V} d="M2.5 12H20"/><path ${V} d="M8.5 12l5.5-7.5M8.5 12l5.5 7.5"/><path ${V} d="M17.5 12l3-3.5M17.5 12l3 3.5"/></g>`}></symbol>
  <!-- barrier: striped bar; pivot is the right end -->
  <symbol id="j-barrier" viewBox="0 0 24 24" set:html={`<g ${S}><rect ${V} x="2" y="10" width="20" height="4" rx="2"/><path ${V} d="M7 10v4M12 10v4M17 10v4"/></g>`}></symbol>
  <!-- stamp: ring + tick -->
  <symbol id="j-stamp" viewBox="0 0 24 24" set:html={`<g ${S}><circle ${V} cx="12" cy="12" r="9"/><path ${V} d="m8 12.5 2.5 2.5 5.5-6"/></g>`}></symbol>
  <!-- courier van: side view, cab on the left -->
  <symbol id="j-van" viewBox="0 0 24 24" set:html={`<g ${S}><path ${V} d="M21 7H8.5L4 12.5V17h17Z"/><path ${V} d="M9 7v5.5H4"/><circle ${V} cx="7.5" cy="17.5" r="1.8"/><circle ${V} cx="17" cy="17.5" r="1.8"/></g>`}></symbol>
  <!-- door pin: map pin with a door -->
  <symbol id="j-pin" viewBox="0 0 24 24" set:html={`<g ${S}><path ${V} d="M12 21.5s-6.5-5.6-6.5-10.5a6.5 6.5 0 0 1 13 0c0 4.9-6.5 10.5-6.5 10.5Z"/><path ${V} d="M10 14v-4.5h4V14"/></g>`}></symbol>
  <!-- half-marks: the two hooks of the GSR monogram -->
  <symbol id="j-mark-l" viewBox="-50 -52 100 104"><path fill="currentColor" d="M0 -50 L-43.3 -25 L-43.3 25 L-22.3 37.1 L20 12.7 L20 -5.77 L-28.3 22.1 L-33.3 19.23 L-33.3 -19.23 L10 -44.2 Z"/></symbol>
  <symbol id="j-mark-r" viewBox="-50 -52 100 104"><path fill="currentColor" d="M0 50 L43.3 25 L43.3 -25 L22.3 -37.1 L-20 -12.7 L-20 5.77 L28.3 -22.1 L33.3 -19.23 L33.3 19.23 L-10 44.2 Z"/></symbol>
</defs>
