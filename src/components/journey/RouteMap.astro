---
/**
 * The journey map: ONE inline Mercator SVG (viewBox 0 0 1600 923, lon 60–125E / lat 20–50N).
 * Country outlines come from map-paths.svg.txt (generated by build-map.mjs from Natural Earth, public domain);
 * route geometry comes from map-meta.json. City names are the per-locale toponym set in src/data/route.ts.
 *
 * Layers:  .jm-base   — land, dot grid, secondary paths, route, city labels (dims to 40 % at the last stage)
 *          .jm-actors — sheds, parcels, container, barrier, stamp, pin, van, vehicle, plane, half-marks
 * Every element the client module touches carries a data-j attribute; the static (no-JS) state is pure CSS
 * in Journey.astro. Strokes use vector-effect: non-scaling-stroke so line weight is constant at every zoom.
 */
import mapPaths from './map-paths.svg.txt?raw';
import meta from './map-meta.json';
import type { Lang } from '@/i18n/config';
import { journey } from '@/i18n/journey';
import { routeNodes, extraPlaces } from '@/data/route';
import Glyphs from './Glyphs.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = journey[lang];
const { routeD, railD, airD, kgD } = meta;

/** Label placement per node (dx, dy in map units; anchor). Chosen so labels never sit on the route line. */
const place: Record<string, { dx: number; dy: number; anchor?: 'start' | 'middle' | 'end'; minor?: boolean }> = {
  yiwu: { dx: 9, dy: 5 },
  xian: { dx: 9, dy: 15, minor: true },
  lanzhou: { dx: 9, dy: -8, minor: true },
  urumqi: { dx: 9, dy: -8 },
  khorgos: { dx: -10, dy: -9, anchor: 'end' },
  almaty: { dx: 8, dy: 16, minor: true },
  shymkent: { dx: -9, dy: -8, anchor: 'end', minor: true },
  tashkent: { dx: 11, dy: 6 },
};
const suffix: Record<string, string | undefined> = {
  yiwu: routeNodes[0].zh ? ` · ${routeNodes[0].zh}` : undefined,
  khorgos: ` · ${t.map.border}`,
};
const gz = extraPlaces.guangzhou;
const alt = extraPlaces.osh;
/** Actor anchors (map units). Sheds are anchored at their bottom-centre; the pin at its tip. */
const A = {
  yiwuShed: { x: 1548, y: 702 },
  tashShed: { x: 197, y: 341 },
  pin: { x: 122, y: 343 },
  barrier: { x: 546, y: 212 },
  stamp: { x: 562, y: 184 },
  parcels: [ { x: 1580, y: 700 }, { x: 1594, y: 692 }, { x: 1586, y: 684 }, { x: 1600, y: 706 } ],
  container: { x: 1548, y: 692 },
  markL: { x: 1466, y: 652 },
  markR: { x: 246, y: 288 },
};
---
<svg class="jmap" viewBox="0 0 1600 923" preserveAspectRatio="xMidYMid meet" role="img" aria-label={t.map.aria} focusable="false" xmlns="http://www.w3.org/2000/svg" data-j="svg">
  <Glyphs />
  <defs>
    <pattern id="j-dots" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="0.7" fill="rgb(255 255 255 / 0.06)"></circle></pattern>
    <!-- the dashed rail twin is revealed through a solid mask stroke whose dash-offset is tweened 1 → 0 -->
    <mask id="j-rail-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1600" height="923">
      <path class="jm-rail-mask" d={railD} pathLength="1" fill="none" stroke="#fff" stroke-width="6" stroke-dasharray="1" data-j="rail-mask"></path>
    </mask>
  </defs>

  <g class="jm-base" data-j="base">
    <g class="jm-land" set:html={mapPaths}></g>
    <rect class="jm-grid" width="1600" height="923" fill="url(#j-dots)"></rect>

    <!-- secondary paths -->
    <path class="jm-kg jm-secondary" d={kgD}></path>
    <path id="j-air" class="jm-air jm-secondary" d={airD}></path>
    <path class="jm-rail-idle jm-secondary" d={railD}></path>
    <path class="jm-rail jm-secondary" d={railD} mask="url(#j-rail-mask)"></path>

    <!-- main route: idle twin + drawn line (pathLength 1 → stroke-dashoffset 1 → 0) -->
    <path class="jm-route-idle" d={routeD}></path>
    <path id="route" class="jm-route" d={routeD} pathLength="1" data-j="route"></path>

    <!-- cities: each group's origin is the dot so labels can be counter-scaled at zoom -->
    <g class="jm-cities">
      {routeNodes.map((n) => {
        const p = place[n.id] ?? { dx: 9, dy: 5 };
        return (
          <g class:list={['jm-city', p.minor && 'jm-minor', n.role && `jm-${n.role}`]} data-j="city" transform={`translate(${n.x} ${n.y})`}>
            <circle r="3" class="jm-dot"></circle>
            <text x={p.dx} y={p.dy} text-anchor={p.anchor ?? 'start'} data-o={p.anchor === 'end' ? '100% 100%' : p.anchor === 'middle' ? '50% 100%' : '0% 100%'} data-j="label">{n.name[lang]}{suffix[n.id]}</text>
          </g>
        );
      })}
      <g class="jm-city jm-minor jm-faint" data-j="city" transform={`translate(${gz.x} ${gz.y})`}>
        <circle r="2.5" class="jm-dot"></circle>
        <text x="9" y="5" data-o="0% 100%" data-j="label">{gz.name[lang]}</text>
      </g>
      <g class="jm-city jm-minor jm-faint jm-alt" data-j="city" transform={`translate(${alt.x} ${alt.y})`}>
        <text x="4" y="16" text-anchor="start" data-o="0% 100%" data-j="label">{t.map.altRoute}</text>
      </g>
    </g>
  </g>

  <g class="jm-actors" data-j="actors">
    <!-- half-marks at both ends of the line -->
    <use class="j-mark" href="#j-mark-l" x={A.markL.x - 7} y={A.markL.y - 7} width="14" height="14.6"></use>
    <use class="j-mark" href="#j-mark-r" x={A.markR.x - 7} y={A.markR.y - 7} width="14" height="14.6"></use>

    <!-- Yiwu warehouse + parcels + container (stages 1–2) -->
    <g class="j-shed j-shed-yiwu" data-j="shed-yiwu" transform={`translate(${A.yiwuShed.x} ${A.yiwuShed.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-shed" x="-16" y="-32" width="32" height="32"></use><circle class="j-door" cx="0" cy="-7" r="1.6"></circle></g>
    </g>
    {A.parcels.map((p) => (
      <g class="j-parcel" data-j="parcel" transform={`translate(${p.x} ${p.y})`}>
        <g class="j-inner" data-j="inner"><use href="#j-parcel" x="-5" y="-5" width="10" height="10"></use></g>
      </g>
    ))}
    <g class="j-container" data-j="container" transform={`translate(${A.container.x} ${A.container.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-container" x="-8" y="-8" width="16" height="16"></use></g>
    </g>

    <!-- Khorgos: barrier (pivot = right end) + stamp (stage 4) -->
    <g class="j-barrier" data-j="barrier" transform={`translate(${A.barrier.x} ${A.barrier.y})`}>
      <path class="j-post" d="M0 -8v18" vector-effect="non-scaling-stroke"></path>
      <use class="j-bar" data-j="bar" href="#j-barrier" x="-24" y="-12" width="24" height="24"></use>
    </g>
    <g class="j-stamp" data-j="stamp" transform={`translate(${A.stamp.x} ${A.stamp.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-stamp" x="-11" y="-11" width="22" height="22"></use></g>
    </g>

    <!-- Tashkent: warehouse, door pin, courier van (stages 5–6) -->
    <g class="j-shed j-shed-tash" data-j="shed-tash" transform={`translate(${A.tashShed.x} ${A.tashShed.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-shed" x="-16" y="-32" width="32" height="32"></use><circle class="j-door" cx="0" cy="-7" r="1.6"></circle></g>
    </g>
    <g class="j-pin" data-j="pin" transform={`translate(${A.pin.x} ${A.pin.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-pin" x="-9" y="-20" width="18" height="20"></use></g>
    </g>
    <g class="j-van" data-j="van" transform={`translate(${A.tashShed.x} ${A.tashShed.y + 2})`}>
      <g class="j-inner" data-j="inner"><rect class="j-capsule" x="-13" y="-8" width="26" height="16" rx="8"></rect><use href="#j-van" x="-9" y="-9" width="18" height="18"></use></g>
    </g>

    <!-- plane capsule on the air arc (stage 3–5) -->
    <g class="j-plane" data-j="plane">
      <g class="j-inner" data-j="inner"><rect class="j-capsule" x="-10" y="-6" width="20" height="12" rx="6"></rect><use href="#j-plane" x="-7" y="-7" width="14" height="14"></use></g>
    </g>

    <!-- the vehicle: red head dot + halo + truck capsule; driven along #route by MotionPathPlugin -->
    <g class="j-vehicle" data-j="vehicle">
      <circle class="j-halo" r="9"></circle>
      <circle class="j-head" r="2.2"></circle>
      <g class="j-inner" data-j="inner"><rect class="j-capsule" x="-14" y="-8" width="28" height="16" rx="8"></rect><use href="#j-truck" x="-9" y="-9" width="18" height="18"></use></g>
    </g>
  </g>
</svg>
