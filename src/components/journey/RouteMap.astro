---
/**
 * The journey map: ONE inline Mercator SVG (viewBox 0 0 1600 923, lon 60–125E / lat 20–50N).
 * Country outlines come from map-paths.svg.txt (generated by build-map.mjs from Natural Earth, public domain);
 * route geometry comes from map-meta.json. City names are the per-locale toponym set in src/data/route.ts.
 *
 * Layers:  .jm-base   — sea plate, land, country + city labels, secondary paths, route (dims at the last stage)
 *          .jm-actors — sheds, parcels, container, barrier, stamp, pin, van, vehicle, plane, half-marks
 * Every element the client module touches carries a data-j attribute; the static (no-JS) state is pure CSS
 * in Journey.astro. Strokes use vector-effect: non-scaling-stroke so line weight is constant at every zoom.
 */
import mapPaths from './map-paths.svg.txt?raw';
import meta from './map-meta.json';
import type { Lang } from '@/i18n/config';
import { journey } from '@/i18n/journey';
import { routeNodes, extraPlaces } from '@/data/route';
import Glyphs from './Glyphs.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = journey[lang];
const { routeD, railD, airD, kgD } = meta;

/** Label placement per node (dx, dy in map units; anchor). Chosen so labels never sit on the route line. */
const place: Record<string, { dx: number; dy: number; anchor?: 'start' | 'middle' | 'end'; minor?: boolean }> = {
  yiwu: { dx: 9, dy: 5 },
  xian: { dx: 9, dy: 15, minor: true },
  lanzhou: { dx: 9, dy: -8, minor: true },
  urumqi: { dx: 9, dy: -8 },
  khorgos: { dx: -10, dy: -9, anchor: 'end' },
  almaty: { dx: 8, dy: 16, minor: true },
  shymkent: { dx: -9, dy: -8, anchor: 'end', minor: true },
  tashkent: { dx: 11, dy: 6 },
};
const suffix: Record<string, string | undefined> = {
  yiwu: routeNodes[0].zh ? ` · ${routeNodes[0].zh}` : undefined,
  khorgos: ` · ${t.map.border}`,
};
/** Country-name anchors (map units; 24.615 units per degree of longitude, lon 60E at x 0). Each has a
 *  second anchor for the phone, where a label is ~50 map units tall instead of ~13 and the desktop
 *  positions collide: `kz` would print straight through "Xorgos · bojxona" and `uz` would be half off
 *  the west edge. journey.ts moves them on the mobile branch.
 *  cn 100.6E Gansu / mobile 106.7E Shaanxi · cn2 84.4E Tarim basin (the only China anchor inside the
 *  border stage's frame) · kz 75.4E Balkhash (73.4E was half off the west edge of the border frame) / mobile 75.8E, which is the one point that stays in
 *  shot across the phone's stage 3, 4, 5 and 6 frames · uz 66.9E Qarshi / mobile 68.1E: at 110 the label
 *  was half off the west edge in the transit frame and printed straight through the door pin in the last one. */
const COUNTRY = [
  { id: 'cn' as const, at: 'cn', x: 1000, y: 470, mx: 1150, my: 560 },
  { id: 'cn' as const, at: 'cn2', x: 600, y: 300, mx: 600, my: 300 },
  { id: 'kz' as const, at: 'kz', x: 380, y: 178, mx: 430, my: 150 },
  { id: 'uz' as const, at: 'uz', x: 170, y: 370, mx: 200, my: 400 },
];
const gz = extraPlaces.guangzhou;
const alt = extraPlaces.osh;
/** Actor anchors (map units), mirrored in journey.ts (YIWU / TASH). Sheds are anchored at their bottom-centre; the pin at its tip.
 *  The Yiwu shed sits south-west of the city dot so it stays on land (the coast is at x ≈ 1510 on this row). */
const A = {
  yiwuShed: { x: 1450, y: 706 },
  tashShed: { x: 242, y: 294 },
  pin: { x: 182, y: 336 },
  van: { x: 238, y: 312 },
  barrier: { x: 528, y: 212 },
  stamp: { x: 546, y: 244 },
  parcels: [ { x: 1404, y: 732 }, { x: 1420, y: 744 }, { x: 1392, y: 722 }, { x: 1432, y: 752 } ],
  container: { x: 1448, y: 696 },
  markL: { x: 1508, y: 634 },
  markR: { x: 292, y: 262 },
};
---
<svg class="jmap" viewBox="0 0 1600 923" preserveAspectRatio="xMidYMid meet" role="img" aria-label={t.map.aria} focusable="false" xmlns="http://www.w3.org/2000/svg" data-j="svg">
  <Glyphs />

  <g class="jm-base" data-j="base">
    <!-- the sea is a painted plate, not the page background: land must have something to be lighter THAN.
         Oversized well past every camera window (the phone's transit frame alone is 3 644 map units tall,
         four times the map) so no plate edge is ever in shot. A flat fill costs nothing to raster. -->
    <rect class="jm-sea" x="-600" y="-1400" width="2800" height="4800"></rect>
    <g class="jm-land" set:html={mapPaths}></g>
    <!-- The generated outlines are clipped to x −123.1…1600.3, y −78.3…975.1. With a border stroke this
         visible (2.13:1 against the land, where it used to be 1.22:1) that clip reads as a bright rectangle
         ruled across the frame — most of all on a phone, where the transit shot is four map-heights tall.
         One even-odd path lays the sea colour back over the boundary, 1.5 units inside it. -->
    <path class="jm-sea" fill-rule="evenodd" d="M-600 -1400H2200V3400H-600Z M-121.6 -76.8H1598.8V973.6H-121.6Z"></path>

    <!-- secondary paths -->
    <path class="jm-kg jm-secondary" d={kgD}></path>
    <path id="j-air" class="jm-air jm-secondary" d={airD}></path>
    <path class="jm-rail-idle jm-secondary" d={railD}></path>
    <!-- no SVG mask: the drawn rail is a plain stroke with pathLength 1, revealed by stroke-dashoffset 1 → 0.
         A mask forces an offscreen surface to be re-rendered on every camera frame (measured 10.6 ms/frame). -->
    <path class="jm-rail jm-secondary" d={railD} pathLength="1" data-j="rail-mask"></path>

    <!-- main route: idle twin + drawn line (pathLength 1 → stroke-dashoffset 1 → 0) -->
    <path class="jm-route-idle" d={routeD}></path>
    <path id="route" class="jm-route" d={routeD} pathLength="1" data-j="route"></path>
    <!-- the last mile: warehouse → van → door. The headline is "from China to your door" and the payoff frame
         used to end the red line at the Toshkent dot and leave a van and a door pin floating unconnected in the
         steppe beside it. The `d` here is the desktop geometry, which is also the static fallback's (the CSS
         parks the van at 208/326 and the pin is anchored at 182/336); journey.ts rewrites it on the phone,
         where the same three glyphs are drawn at 1.6× and have to be spread further apart. -->
    <path class="jm-last" d="M229 307 L208 326 L185 335" pathLength="1" data-j="last"></path>

    <!-- country names: geography, not a claim — the one thing that makes the section read
         "China → Uzbekistan" at a glance. `cn2` is the China anchor for the border stage, where the
         main one is off-frame; CSS swaps them on [data-stage='4'], so it costs nothing per frame. -->
    <g class="jm-countries" aria-hidden="true">
      {COUNTRY.map((c) => (
        <text class:list={['jm-country', `jm-country-${c.at}`]} x={c.x} y={c.y} data-mx={c.mx} data-my={c.my} text-anchor="middle" data-o="50% 50%" data-j="label" data-j2="country">{t.map.countries[c.id]}</text>
      ))}
    </g>

    <!-- cities: each group's origin is the dot so labels can be counter-scaled at zoom -->
    <g class="jm-cities">
      {routeNodes.map((n) => {
        const p = place[n.id] ?? { dx: 9, dy: 5 };
        return (
          <g class:list={['jm-city', p.minor && 'jm-minor', n.role && `jm-${n.role}`]} data-j="city" transform={`translate(${n.x} ${n.y})`}>
            <circle r="3" class="jm-dot"></circle>
            <text x={p.dx} y={p.dy} text-anchor={p.anchor ?? 'start'} data-o={p.anchor === 'end' ? '100% 100%' : p.anchor === 'middle' ? '50% 100%' : '0% 100%'} data-j="label">{n.name[lang]}{suffix[n.id]}</text>
          </g>
        );
      })}
      <g class="jm-city jm-minor jm-faint" data-j="city" transform={`translate(${gz.x} ${gz.y})`}>
        <circle r="2.5" class="jm-dot"></circle>
        <text x="9" y="5" data-o="0% 100%" data-j="label">{gz.name[lang]}</text>
      </g>
      <g class="jm-city jm-minor jm-faint jm-alt" data-j="city" transform={`translate(${alt.x} ${alt.y})`}>
        <text x="4" y="16" text-anchor="start" data-o="0% 100%" data-j="label">{t.map.altRoute}</text>
      </g>
    </g>
  </g>

  <g class="jm-actors" data-j="actors">
    <!-- half-marks at both ends of the line, clear of what sits there: at 1466/652 the left one was
         exactly under the truck as it pulled out of Yiwu, and at 275/285 the right one printed through
         the "Toshkent" label on a phone, where every glyph is drawn at 1.6×. -->
    <use class="j-mark" href="#j-mark-l" x={A.markL.x - 7} y={A.markL.y - 7} width="14" height="14.6"></use>
    <use class="j-mark" href="#j-mark-r" x={A.markR.x - 7} y={A.markR.y - 7} width="14" height="14.6"></use>

    <!-- Yiwu warehouse + parcels + container (stages 1–2) -->
    <g class="j-shed j-shed-yiwu" data-j="shed-yiwu" transform={`translate(${A.yiwuShed.x} ${A.yiwuShed.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-shed" x="-16" y="-32" width="32" height="32"></use><circle class="j-door" cx="0" cy="-7" r="1.6"></circle></g>
    </g>
    {A.parcels.map((p) => (
      <g class="j-parcel" data-j="parcel" transform={`translate(${p.x} ${p.y})`}>
        <g class="j-inner" data-j="inner"><use href="#j-parcel" x="-5" y="-5" width="10" height="10"></use></g>
      </g>
    ))}
    <g class="j-container" data-j="container" transform={`translate(${A.container.x} ${A.container.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-container" x="-8" y="-8" width="16" height="16"></use></g>
    </g>

    <!-- Khorgos: barrier (pivot = right end, boom lifts up-left) + stamp, which sits BELOW the road: the
         raised boom sweeps map x 516-528 / y 194-212 and the stamp used to be printed straight through it. -->
    <g class="j-barrier" data-j="barrier" transform={`translate(${A.barrier.x} ${A.barrier.y})`}>
      <!-- the .j-inner wrapper is what makes the phone draw this at the same 1.6× as every other glyph. Without
           it the boom stayed 20 map units long beside a 45-unit truck and its three stripes closed into a wedge. -->
      <g class="j-inner" data-j="inner">
        <path class="j-post" d="M0 -8v18" vector-effect="non-scaling-stroke"></path>
        <use class="j-bar" data-j="bar" href="#j-barrier" x="-24" y="-12" width="24" height="24"></use>
      </g>
    </g>
    <g class="j-stamp" data-j="stamp" transform={`translate(${A.stamp.x} ${A.stamp.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-stamp" x="-11" y="-11" width="22" height="22"></use></g>
    </g>

    <!-- Tashkent: warehouse, door pin, courier van (stages 5–6) -->
    <g class="j-shed j-shed-tash" data-j="shed-tash" transform={`translate(${A.tashShed.x} ${A.tashShed.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-shed" x="-16" y="-32" width="32" height="32"></use><circle class="j-door" cx="0" cy="-7" r="1.6"></circle></g>
    </g>
    <g class="j-pin" data-j="pin" transform={`translate(${A.pin.x} ${A.pin.y})`}>
      <g class="j-inner" data-j="inner"><use href="#j-pin" x="-9" y="-20" width="18" height="20"></use></g>
    </g>
    <g class="j-van" data-j="van" transform={`translate(${A.van.x} ${A.van.y})`}>
      <g class="j-inner" data-j="inner"><rect class="j-capsule" x="-13" y="-8" width="26" height="16" rx="8"></rect><use href="#j-van" x="-9" y="-9" width="18" height="18"></use></g>
    </g>

    <!-- plane capsule on the air arc (stage 3–5) -->
    <g class="j-plane" data-j="plane">
      <g class="j-inner" data-j="inner"><rect class="j-capsule" x="-10" y="-6" width="20" height="12" rx="6"></rect><use href="#j-plane" x="-7" y="-7" width="14" height="14"></use></g>
    </g>

    <!-- the vehicle: red head dot + halo (r 3 → ≈12 px at the 2.4× stage-6 zoom, §5.1) + truck capsule; driven along #route by MotionPathPlugin -->
    <g class="j-vehicle" data-j="vehicle">
      <circle class="j-halo" r="3"></circle>
      <circle class="j-head" r="2.2"></circle>
      <g class="j-inner" data-j="inner"><rect class="j-capsule" x="-14" y="-8" width="28" height="16" rx="8"></rect><use href="#j-truck" x="-9" y="-9" width="18" height="18"></use></g>
    </g>
  </g>
</svg>
