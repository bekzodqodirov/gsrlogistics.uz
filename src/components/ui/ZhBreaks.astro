---
/**
 * A short display text — heading, FAQ question, table cell, label, one-sentence blurb — that on a Chinese page breaks
 * between words only: a <wbr> between words and `word-break: keep-all` against every other break
 * (src/lib/zh-breaks.ts says how the words are found). Any other locale gets the text exactly as
 * `{text}` would print it, with no wrapper, so its HTML does not change.
 * The single span keeps a flex parent (an FAQ <summary>) at one flex item.
 */
import { zhBreaksHtml } from '@/lib/zh-breaks';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
  text: string;
  /** A heading or question: break after its clause stops only when every clause fits a 320px line (see zh-breaks.ts). */
  clause?: number;
}
const { lang, text, clause = 0 } = Astro.props;
---
{lang === 'zh' ? <span class="zw" set:html={zhBreaksHtml(text, clause)} /> : text}

<style is:global>
  :root:lang(zh) .zw { word-break: keep-all; overflow-wrap: break-word; }
  :root:lang(zh) .zw .zc { display: inline-block; }
</style>
