---
/**
 * Inline stroke icons (24×24 grid, 1.75 stroke, round caps) — original, Lucide-style simplicity.
 * Usage: <Icon name="telegram" size={20} />
 *
 * Detail floor: at the smallest shipped size (16px) one grid unit is 0.67px and the stroke renders
 * at 1.17px, so any counter narrower than ~2.6 units closes up. Every glyph below is drawn to that
 * floor and optically centred on (12,12). Do not raise strokeWidth above 1.75 — it is what pairs
 * with the Onest 600 headings.
 */
export type IconName = keyof typeof icons;
interface Props { name: IconName; size?: number; class?: string; title?: string; strokeWidth?: number }
const icons = {
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  'chevron-right': '<path d="m9 6 6 6-6 6"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  x: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
