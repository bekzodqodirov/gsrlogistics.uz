  languages: '<path d="M2.8 6.1A1.9 1.9 0 0 1 4.7 4.2h8A1.9 1.9 0 0 1 14.6 6v4.9a1.9 1.9 0 0 1-1.9 1.9H8.2l-3.3 2.6v-2.6h-.2a1.9 1.9 0 0 1-1.9-1.9Z"/><path d="M5.8 8.5h5.8"/><path d="M17.4 9.6h1.9A1.9 1.9 0 0 1 21.2 11.5v4.9a1.9 1.9 0 0 1-1.9 1.9h-.2v2.6l-3.3-2.6"/>',
  calendar: '<rect x="3.6" y="5" width="16.8" height="15.4" rx="2.4"/><path d="M3.6 10.1h16.8M8 3.1v3.6M16 3.1v3.6"/><path d="M7.8 14.6h2.6M13.6 14.6h2.6"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h0"/>',
