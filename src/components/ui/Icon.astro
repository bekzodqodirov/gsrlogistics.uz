  telegram: '<path d="M21.4 3.3 2.6 10.4a.5.5 0 0 0 0 .9l4.8 1.9 11-6.9-8.3 8.3v4.9a.5.5 0 0 0 .9.3l2.4-3 4.2 2.7a.5.5 0 0 0 .8-.3l3.4-15.3a.5.5 0 0 0-.4-.6Z"/>',
  whatsapp: '<path d="M3.9 20.3 5.3 16.5A8.4 8.4 0 1 1 8.5 19.1Z"/><path d="M9.5 9.5c0 3 2.2 5.2 5.2 5.2l1.1-1.7-2.1-.9-.8.9a4.6 4.6 0 0 1-1.7-1.7l.9-.8-.9-2.1Z"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17" cy="7" r=".8" fill="currentColor"/>',
  facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v5h4v-5h3l1-4h-4V8Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  'map-pin': '<path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  truck: '<path d="M3 15V5h11v3h4l3 3.2V15Z"/><circle cx="7.5" cy="17.2" r="1.9"/><circle cx="16.9" cy="17.2" r="1.9"/>',
  plane: '<path d="M12 2.3c1.2 1.2 2 3.1 2 5.5l7.3 6.4v1.4L14 12.6V17l3.2 2.6v.8L14 19.6l-2 2.1-2-2.1-3.2.8v-.8L10 17v-4.4l-7.3 3v-1.4L10 7.8c0-2.4.8-4.3 2-5.5Z"/>',
  /* Front view. The windscreen alone read as a parking meter at 20–24px; the pair of headlights
     below it is what makes it a train at a glance. Ink 24.76% — within 0.02pt of the slotted
     version it replaces, so the card grid stays balanced. */
  train: '<path d="M12 4.3a6.1 6.1 0 0 0-6.1 6.1v4.7A2.9 2.9 0 0 0 8.8 18h6.4a2.9 2.9 0 0 0 2.9-2.9v-4.7A6.1 6.1 0 0 0 12 4.3Z"/><path d="M8.6 8.8h6.8v3.2H8.6z"/><path d="M9.8 15.2h.01M14.2 15.2h.01"/><path d="M9.5 18v2.1M14.5 18v2.1M6.2 20.7h11.6"/>',
  container: '<rect x="3" y="7" width="18" height="11" rx="1.5"/><path d="M7 7v11M11 7v11M15 7v11M19 7v11"/>',
  box: '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>',
