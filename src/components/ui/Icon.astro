  calculator: '<rect x="5.4" y="3.6" width="13.2" height="16.8" rx="2.4"/><path d="M8.2 6.8h7.6v3H8.2z"/><path d="M8.4 13.6h2.8M8.4 16.9h2.8M14 13.6h1.6M14 16.9h1.6"/>',
  route: '<circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8.5 18H14a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h5.5"/>',
  camera: '<path d="M3.4 8.6A1.6 1.6 0 0 1 5 7h2.6L9 4.4h6L16.4 7H19a1.6 1.6 0 0 1 1.6 1.6v8.8A1.6 1.6 0 0 1 19 19H5a1.6 1.6 0 0 1-1.6-1.6Z"/><circle cx="12" cy="13" r="3.6"/>',
  factory: '<path d="M3.7 19.5V9.8l6 3.9V9.8l6 3.9V5h4.6v14.5Z"/>',
  car: '<path d="M2.7 15.5v-3.6l2.4-.7 2.9-4c.4-.6 1-.9 1.7-.9h4.6c.7 0 1.3.3 1.7.9l2.9 4 2.4.7v3.6Z"/><circle cx="8" cy="15.5" r="2.3"/><circle cx="16" cy="15.5" r="2.3"/>',
  scale: '<path d="M12 3.6v15.8M7.4 19.4h9.2M3.8 7.4h16.4"/><path d="m6.9 7.4-3.1 6.5a3.1 3.1 0 0 0 6.2 0Zm10.2 0-3.1 6.5a3.1 3.1 0 0 0 6.2 0Z"/>',
