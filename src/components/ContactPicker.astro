---
/**
 * The one-question picker in front of every general "write to us" button, and the result screen
 * every chat button on the site ends on.
 *
 * Why: GSR's managers split the work — one team brings cargo, another finds and buys goods — and
 * GSR's own system (gsrwms.uz) knows which manager of a team is least busy. A general button cannot
 * know the team; this asks, in at most two taps. Then, at the final click, the browser asks GSR's
 * system for a manager (lib/lead-client.ts), shows the manager and the prepared message with its
 * one-off code, and opens Telegram at that manager. When the visitor sends that message, GSR's
 * system opens the lead for that manager by itself. Owner, 2026-09-26.
 *
 * Who comes through here (all handled by the one script below):
 *   - <a data-picker>: a general button. The click opens this dialog at the topic step.
 *   - <a data-team data-topic data-summary>: a final choice — the picker's own, a service page's,
 *     the pricing page's, the calculator's (lib/leads.ts → leadAttrs). The click runs the flow.
 *   - a "gsr:lead" event: the contact form (LeadForm.astro), after it validates.
 * Without JavaScript, or with a modifier key / middle click ("open in new tab"), every link is followed
 * as rendered: the company account with a plain draft and no code.
 *
 * The result screen is not optional: a lead opens only if the coded message is the visitor's FIRST
 * message to that manager, unchanged, so the screen says so, and it keeps a real Telegram link and a
 * copy button for browsers that do not leave the page.
 */
import { pick, type Locale } from '@/i18n/config';
import { leadStrings } from '@/i18n/lead';
import { site, telegramBotUrl } from '@/lib/site';
import { assignLang, leadAttrs, teamTopic, telegramFor } from '@/lib/leads';
import Icon from '@/components/ui/Icon.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = pick(lang, leadStrings);
const path = Astro.url.pathname;
const fill = (draft: string, v: string) => draft.replace('{v}', v);
const cfg = JSON.stringify({ endpoint: site.leadAssign, company: site.telegramCompany, fallback: site.leadTeams });
---
<dialog class="lp" id="lead-picker" aria-labelledby="lp-title" data-assign={cfg} data-lang={assignLang(lang)} data-code-word={t.codeWord}>
  <div class="lp-sheet">
    <div class="lp-head">
      <h2 id="lp-title" class="lp-title" data-lp-title data-title-done={t.done.title}>{t.title}</h2>
      <button type="button" class="lp-x" data-lp-close aria-label={t.close}><Icon name="x" size={20} /></button>
    </div>

    <div class="lp-step" data-lp-step="topic">
      <p class="lp-lead">{t.lead}</p>
      <ul class="lp-list" role="list">
        <li>
          <button type="button" class="lp-opt" data-lp-go="cargo">
            <span class="lp-ico"><Icon name="truck" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.cargo.label}</span><span class="lp-sub">{t.cargo.sub}</span></span>
            <Icon name="chevron-right" size={18} class="lp-chev" />
          </button>
        </li>
        <li>
          <button type="button" class="lp-opt" data-lp-go="buying">
            <span class="lp-ico"><Icon name="cart" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.buying.label}</span><span class="lp-sub">{t.buying.sub}</span></span>
            <Icon name="chevron-right" size={18} class="lp-chev" />
          </button>
        </li>
        <li>
          {/* Existing clients asking "where is it" are answered by the bot, per carton, at any hour —
              not by a sales manager, so this one asks GSR's system nothing. */}
          <a class="lp-opt" href={telegramBotUrl} target="_blank" rel="noopener" data-lp-bot>
            <span class="lp-ico"><Icon name="route" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.track.label}</span><span class="lp-sub">{t.track.sub}</span></span>
            <Icon name="arrow-up-right" size={18} class="lp-chev" />
          </a>
        </li>
        <li>
          <a class="lp-opt" href={telegramFor('general', t.other.draft, path)} target="_blank" rel="noopener" {...leadAttrs('general', teamTopic.general, t.other.label)}>
            <span class="lp-ico"><Icon name="telegram" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.other.label}</span><span class="lp-sub">{t.other.sub}</span></span>
            <Icon name="arrow-up-right" size={18} class="lp-chev" />
          </a>
        </li>
      </ul>
    </div>

    <div class="lp-step" data-lp-step="cargo" hidden>
      <button type="button" class="lp-back" data-lp-back><Icon name="arrow-right" size={16} class="lp-back-ico" />{t.back}</button>
      <p class="lp-q" id="lp-q-cargo">{t.cargo.question}</p>
      <ul class="lp-chips" role="list" aria-labelledby="lp-q-cargo">
        {t.cargo.choices.map((c) => (
          <li><a class="lp-chip" href={telegramFor('cargo', fill(t.cargo.draft, c.msg), path)} target="_blank" rel="noopener" {...leadAttrs('cargo', teamTopic.cargo, `${t.cargo.label} · ${c.msg}`)}><Icon name="telegram" size={18} />{c.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="lp-step" data-lp-step="buying" hidden>
      <button type="button" class="lp-back" data-lp-back><Icon name="arrow-right" size={16} class="lp-back-ico" />{t.back}</button>
      <p class="lp-q" id="lp-q-buying">{t.buying.question}</p>
      <ul class="lp-chips lp-chips-wide" role="list" aria-labelledby="lp-q-buying">
        {t.buying.choices.map((c) => (
          <li><a class="lp-chip" href={telegramFor('buying', fill(t.buying.draft, c.msg), path)} target="_blank" rel="noopener" {...leadAttrs('buying', teamTopic.buying, `${t.buying.label} · ${c.msg}`)}><Icon name="telegram" size={18} />{c.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="lp-step lp-wait" data-lp-step="wait" hidden>
      <span class="lp-spin" aria-hidden="true"></span>
      <p role="status">{t.wait}</p>
    </div>

    <div class="lp-step" data-lp-step="done" hidden>
      <p class="lp-who">{t.done.manager}: <strong class="lp-user" data-lp-user></strong></p>
      <p class="lp-msg" data-lp-msg></p>
      <div class="lp-copy-row">
        <button type="button" class="lp-copy" data-lp-copy data-copied={t.done.copied} data-copy-fail={t.done.copyFail}><Icon name="copy" size={16} />{t.done.copy}</button>
        <span class="lp-copy-status" data-lp-copy-status role="status"></span>
      </div>
      <p class="lp-note"><Icon name="info" size={16} />{t.done.note}</p>
      <a class="btn btn-primary lp-open" data-lp-open href={site.telegramDirect}><Icon name="telegram" size={18} />{t.done.open}</a>
    </div>

    <p class="lp-foot" data-lp-foot>{t.footnote}</p>
  </div>
</dialog>

<script>
  import { assign, warm, type AssignConfig, type LeadTeam } from '@/lib/lead-client';

  interface LeadEventDetail { team: LeadTeam; topic?: string; summary: string; trigger?: HTMLElement; handled?: boolean }
  const dlg = document.getElementById('lead-picker') as HTMLDialogElement | null;

  if (dlg && typeof dlg.showModal === 'function') {
    const cfg = JSON.parse(dlg.dataset.assign || '{}') as AssignConfig;
    const lang = dlg.dataset.lang || '';
    const codeWord = dlg.dataset.codeWord || 'Kod';
    const q = <T extends HTMLElement>(sel: string) => dlg.querySelector<T>(sel)!;
    const title = q<HTMLElement>('[data-lp-title]');
    const titleTopic = title.textContent || '';
    const foot = q<HTMLElement>('[data-lp-foot]');
    const user = q<HTMLElement>('[data-lp-user]');
    const msg = q<HTMLElement>('[data-lp-msg]');
    const open = q<HTMLAnchorElement>('[data-lp-open]');
    const copyBtn = q<HTMLButtonElement>('[data-lp-copy]');
    const copyStatus = q<HTMLElement>('[data-lp-copy-status]');
    const steps = Array.from(dlg.querySelectorAll<HTMLElement>('[data-lp-step]'));

    const show = (name: string) => {
      for (const s of steps) s.hidden = s.dataset.lpStep !== name;
      title.textContent = name === 'done' ? title.dataset.titleDone || titleTopic : titleTopic;
      foot.hidden = name === 'done';
      const current = steps.find((s) => s.dataset.lpStep === name);
      current?.querySelector<HTMLElement>('.lp-opt, .lp-chip, .lp-open')?.focus();
    };
    let opener: HTMLElement | null = null;

    /* One flow at a time. The button that started it stays disabled until the visitor comes back
       (pageshow from the back/forward cache) or closes the dialog. */
    let busy = false;
    let trigger: HTMLElement | null = null;
    /* Bumped when the dialog closes: a flow the visitor closed while it waited must not navigate. */
    let flow = 0;
    const setDisabled = (el: HTMLElement | null, off: boolean) => {
      if (!el) return;
      if (el instanceof HTMLButtonElement) el.disabled = off;
      if (off) el.setAttribute('aria-disabled', 'true'); else el.removeAttribute('aria-disabled');
    };
    const reset = () => { busy = false; setDisabled(trigger, false); trigger = null; };

    const run = async (d: LeadEventDetail) => {
      if (busy) return;
      busy = true;
      const id = ++flow;
      trigger = d.trigger ?? null;
      setDisabled(trigger, true);
      if (!dlg.open) { opener = trigger; dlg.showModal(); }
      show('wait');
      let r;
      try {
        r = await assign(cfg, { team: d.team, topic: d.topic, lang, summary: d.summary, codeWord });
      } catch {
        if (id !== flow) return;
        // Nothing in assign() is expected to throw (the network part cannot); if the browser lacks
        // something it needs, the visitor still reaches a person: the link as rendered, no code.
        const plain = trigger instanceof HTMLAnchorElement ? trigger.href : `https://t.me/${cfg.company}`;
        dlg.close();
        window.location.assign(plain);
        return;
      }
      if (id !== flow) return;
      dlg.dataset.via = r.assigned ? 'gsr' : 'fallback';
      user.textContent = `@${r.username}`;
      msg.textContent = r.text;
      open.href = r.url;
      copyStatus.textContent = '';
      show('done');
      // Same tab, after the await: a window.open here is blocked by Safari, iOS, Firefox and the
      // Instagram/Facebook/TikTok browsers. If the app takes the link instead, the screen stays.
      window.location.assign(r.url);
    };

    /* Warm the connection to GSR's system when a visitor heads for any chat button. */
    const aimed = (e: Event) => {
      if (!(e.target as Element | null)?.closest?.('a[data-picker], a[data-summary], form[data-lead]')) return;
      warm(cfg.endpoint);
      document.removeEventListener('pointerover', aimed);
      document.removeEventListener('focusin', aimed);
    };
    document.addEventListener('pointerover', aimed, { passive: true });
    document.addEventListener('focusin', aimed);

    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-picker], a[data-team][data-summary]');
      if (!a) return;
      // "Open in new tab" and friends keep their plain meaning: the link as rendered.
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      if (a.hasAttribute('data-picker')) {
        if (busy) return;
        opener = a;
        warm(cfg.endpoint);
        dlg.showModal();
        show('topic');
        return;
      }
      const team = a.dataset.team as LeadTeam;
      void run({ team, topic: a.dataset.topic, summary: a.dataset.summary || '', trigger: a });
    });

    /* The contact form hands over here once it has validated; `handled` tells it someone answered. */
    document.addEventListener('gsr:lead', (e) => {
      const d = (e as CustomEvent<LeadEventDetail>).detail;
      if (!d) return;
      d.handled = true;
      void run(d);
    });

    dlg.addEventListener('click', (e) => {
      const el = e.target as Element;
      const go = el.closest<HTMLElement>('[data-lp-go]');
      if (go) { show(go.dataset.lpGo || 'topic'); return; }
      if (el.closest('[data-lp-back]')) { show('topic'); return; }
      if (el.closest('[data-lp-close]')) { dlg.close(); return; }
      // The bot link opens in a new tab; put the page back the way it was.
      if (el.closest('[data-lp-bot]')) { setTimeout(() => dlg.close(), 0); return; }
      // The sheet has no padding of its own, so a click whose target is the dialog itself is the backdrop.
      if (el === dlg) dlg.close();
    });

    copyBtn.addEventListener('click', async () => {
      const text = msg.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
        copyStatus.textContent = copyBtn.dataset.copied || '';
      } catch {
        // No clipboard API (older in-app browsers, http): select the message so a long-press copies it.
        const range = document.createRange();
        range.selectNodeContents(msg);
        const sel = getSelection();
        sel?.removeAllRanges(); sel?.addRange(range);
        copyStatus.textContent = copyBtn.dataset.copyFail || '';
      }
    });

    dlg.addEventListener('close', () => { flow++; reset(); show('topic'); opener?.focus(); opener = null; });
    addEventListener('pageshow', (e) => { if (e.persisted) reset(); });
  }
</script>

<style>
  /* margin: auto is the browser's own centring for a modal dialog; the global reset zeroes every
     margin, which pinned the dialog to the top-left corner. Restated here on purpose. */
  .lp { margin: auto; padding: 0; border: 0; background: transparent; color: var(--fg); width: min(460px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 48px); overflow: visible; }
  .lp::backdrop { background: rgb(11 11 13 / 0.56); }
  .lp[open] { animation: lp-in 180ms var(--ease-out-expo, ease-out); }
  @keyframes lp-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .lp[open] { animation: none; } }
  :global(html:has(dialog.lp[open])) { overflow: hidden; }

  .lp-sheet { background: var(--bg); border: 1px solid var(--card-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-float); padding: 20px; display: grid; gap: 14px; max-height: calc(100dvh - 48px); overflow-y: auto; overscroll-behavior: contain; }
  .lp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .lp-title { font-size: 1.25rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em; margin: 0; text-wrap: balance; }
  .lp-x { flex: none; display: grid; place-items: center; width: 36px; height: 36px; margin: -6px -6px 0 0; border: 0; border-radius: 50%; background: transparent; color: var(--muted); cursor: pointer; }
  .lp-x:hover { background: var(--bg-2); color: var(--fg); }
  .lp-lead { margin: 0; color: var(--muted); font-size: var(--text-small); text-wrap: pretty; }

  .lp-step { display: grid; gap: 12px; }
  .lp-step[hidden] { display: none; }
  .lp-list, .lp-chips { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .lp-opt { width: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 14px 14px; border: 1px solid var(--card-border); border-radius: var(--radius); background: var(--card); color: var(--fg); text-align: left; text-decoration: none; font: inherit; cursor: pointer; transition: border-color var(--dur-fast, 120ms), background-color var(--dur-fast, 120ms); }
  .lp-opt:hover { border-color: var(--accent); }
  .lp-ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--accent-soft); color: var(--accent-text); }
  .lp-txt { display: grid; gap: 2px; min-width: 0; }
  .lp-label { font-weight: 600; line-height: 1.3; }
  .lp-sub { font-size: var(--text-small); color: var(--muted); line-height: 1.35; }
  .lp-opt :global(.lp-chev) { color: var(--meta); }

  .lp-back { justify-self: start; display: inline-flex; align-items: center; gap: 6px; padding: 4px 2px; border: 0; background: none; color: var(--muted); font: inherit; font-size: var(--text-small); cursor: pointer; }
  .lp-back:hover { color: var(--fg); }
  .lp-back :global(.lp-back-ico) { transform: scaleX(-1); }
  .lp-q { margin: 0; font-weight: 600; font-size: 1.0625rem; }
  .lp-chips { grid-template-columns: 1fr 1fr; }
  .lp-chips-wide { grid-template-columns: 1fr; }
  .lp-chip { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 12px 14px; border: 1px solid var(--card-border); border-radius: var(--radius); background: var(--card); color: var(--fg); text-decoration: none; font-weight: 500; line-height: 1.3; transition: border-color var(--dur-fast, 120ms); }
  .lp-chip :global(svg) { flex: none; color: var(--accent-text); }
  .lp-chip:hover { border-color: var(--accent); }
  .lp-foot { margin: 2px 0 0; font-size: var(--text-caption, 0.8125rem); color: var(--meta); text-wrap: pretty; }
  .lp-foot[hidden] { display: none; }
  .lp [aria-disabled='true'] { pointer-events: none; opacity: 0.6; }

  .lp-wait { grid-auto-flow: column; justify-content: start; align-items: center; gap: 12px; min-height: 120px; color: var(--muted); }
  .lp-wait p { margin: 0; }
  .lp-spin { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--card-border); border-top-color: var(--accent); animation: lp-spin 0.8s linear infinite; }
  @keyframes lp-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .lp-spin { animation-duration: 2.4s; } }

  .lp-who { margin: 0; color: var(--muted); }
  .lp-user { color: var(--fg); font-weight: 600; overflow-wrap: anywhere; }
  /* The message exactly as it will be sent: its line break matters (the code stands alone on line one). */
  .lp-msg { margin: 0; padding: 12px 14px; border: 1px solid var(--card-border); border-radius: var(--radius); background: var(--bg-2); white-space: pre-wrap; overflow-wrap: anywhere; font-size: var(--text-small); line-height: 1.5; user-select: all; -webkit-user-select: all; }
  .lp-copy-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .lp-copy { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 8px 14px; border: 1px solid var(--card-border); border-radius: 999px; background: var(--card); color: var(--fg); font: inherit; font-size: var(--text-small); font-weight: 500; cursor: pointer; }
  .lp-copy:hover { border-color: var(--accent); }
  .lp-copy-status { font-size: var(--text-small); color: var(--muted); }
  .lp-note { display: flex; gap: 8px; align-items: flex-start; margin: 0; font-size: var(--text-small); color: var(--fg); text-wrap: pretty; }
  .lp-note :global(svg) { flex: none; margin-top: 2px; color: var(--accent-text); }
  .lp-open { width: 100%; justify-content: center; }

  /* A phone gets a bottom sheet: thumbs live at the bottom of the screen, and so does the Telegram button that opened this. */
  @media (max-width: 599px) {
    .lp { width: 100%; margin: auto 0 0; max-height: 92dvh; }
    .lp-sheet { border-radius: var(--radius-lg) var(--radius-lg) 0 0; border-bottom: 0; padding: 18px 16px calc(16px + env(safe-area-inset-bottom)); max-height: 92dvh; }
    .lp[open] { animation-name: lp-up; }
    @keyframes lp-up { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  }
</style>
