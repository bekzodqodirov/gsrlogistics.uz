---
/**
 * The one-question picker in front of every general "write to us" button.
 *
 * Why: GSR's managers split the work — one team brings cargo, another finds and buys goods — and
 * their personal Telegram accounts are wired into GSR's own CRM, so the account a message lands in
 * is the assignment. A general button cannot know which team the visitor needs; this asks, in at
 * most two taps, and opens Telegram at the right manager with a draft that already says what it is
 * about. Owner, 2026-09-26. Routing rules and team usernames: lib/leads.ts, site.leadTeams.
 *
 * How a button opts in: an <a data-picker> whose href is the general team's chat. The click is
 * intercepted and this dialog opens instead. Without JavaScript, or with a modifier key / middle
 * click ("open in new tab"), the href is followed as it is — the general team still gets it.
 * Service pages do NOT use the picker: they already know their service and link straight to its
 * team (data-team), so a visitor on the "buying" page is never asked what they want.
 *
 * Every final choice is a real <a href> rendered here, per page, with the page path in the draft —
 * the script never builds a message, it only swaps in the visitor's own manager when a team has
 * more than one (sticky, per browser, so a returning client reaches the same person).
 */
import { pick, type Locale } from '@/i18n/config';
import { leadStrings } from '@/i18n/lead';
import { site, telegramBotUrl } from '@/lib/site';
import { telegramFor } from '@/lib/leads';
import Icon from '@/components/ui/Icon.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = pick(lang, leadStrings);
const path = Astro.url.pathname;
const fill = (draft: string, v: string) => draft.replace('{v}', v);
---
<dialog class="lp" id="lead-picker" aria-labelledby="lp-title" data-teams={JSON.stringify(site.leadTeams)}>
  <div class="lp-sheet">
    <div class="lp-head">
      <h2 id="lp-title" class="lp-title">{t.title}</h2>
      <button type="button" class="lp-x" data-lp-close aria-label={t.close}><Icon name="x" size={20} /></button>
    </div>

    <div class="lp-step" data-lp-step="topic">
      <p class="lp-lead">{t.lead}</p>
      <ul class="lp-list" role="list">
        <li>
          <button type="button" class="lp-opt" data-lp-go="cargo">
            <span class="lp-ico"><Icon name="truck" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.cargo.label}</span><span class="lp-sub">{t.cargo.sub}</span></span>
            <Icon name="chevron-right" size={18} class="lp-chev" />
          </button>
        </li>
        <li>
          <button type="button" class="lp-opt" data-lp-go="buying">
            <span class="lp-ico"><Icon name="cart" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.buying.label}</span><span class="lp-sub">{t.buying.sub}</span></span>
            <Icon name="chevron-right" size={18} class="lp-chev" />
          </button>
        </li>
        <li>
          {/* Existing clients asking "where is it" are answered by the bot, per carton, at any hour —
              not by a sales manager. */}
          <a class="lp-opt" href={telegramBotUrl} target="_blank" rel="noopener" data-lp-final>
            <span class="lp-ico"><Icon name="route" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.track.label}</span><span class="lp-sub">{t.track.sub}</span></span>
            <Icon name="arrow-up-right" size={18} class="lp-chev" />
          </a>
        </li>
        <li>
          <a class="lp-opt" href={telegramFor('general', t.other.draft, path)} data-team="general" target="_blank" rel="noopener" data-lp-final>
            <span class="lp-ico"><Icon name="telegram" size={22} /></span>
            <span class="lp-txt"><span class="lp-label">{t.other.label}</span><span class="lp-sub">{t.other.sub}</span></span>
            <Icon name="arrow-up-right" size={18} class="lp-chev" />
          </a>
        </li>
      </ul>
    </div>

    <div class="lp-step" data-lp-step="cargo" hidden>
      <button type="button" class="lp-back" data-lp-back><Icon name="arrow-right" size={16} class="lp-back-ico" />{t.back}</button>
      <p class="lp-q" id="lp-q-cargo">{t.cargo.question}</p>
      <ul class="lp-chips" role="list" aria-labelledby="lp-q-cargo">
        {t.cargo.choices.map((c) => (
          <li><a class="lp-chip" href={telegramFor('cargo', fill(t.cargo.draft, c.msg), path)} data-team="cargo" target="_blank" rel="noopener" data-lp-final><Icon name="telegram" size={18} />{c.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="lp-step" data-lp-step="buying" hidden>
      <button type="button" class="lp-back" data-lp-back><Icon name="arrow-right" size={16} class="lp-back-ico" />{t.back}</button>
      <p class="lp-q" id="lp-q-buying">{t.buying.question}</p>
      <ul class="lp-chips lp-chips-wide" role="list" aria-labelledby="lp-q-buying">
        {t.buying.choices.map((c) => (
          <li><a class="lp-chip" href={telegramFor('buying', fill(t.buying.draft, c.msg), path)} data-team="buying" target="_blank" rel="noopener" data-lp-final><Icon name="telegram" size={18} />{c.label}</a></li>
        ))}
      </ul>
    </div>

    <p class="lp-foot">{t.footnote}</p>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('lead-picker') as HTMLDialogElement | null;

  /* The visitor's own manager for a team: the only one, or one picked at random on the first visit
     and remembered, so a returning client is never handed to someone new. Storage can be refused
     (private mode); then the pick is simply not remembered. */
  const teams: Record<string, string[]> = (() => { try { return JSON.parse(dlg?.dataset.teams || '{}'); } catch { return {}; } })();
  const managerFor = (team: string): string | undefined => {
    const list = teams[team] || [];
    if (list.length <= 1) return list[0];
    const key = `gsr-manager-${team}`;
    try { const saved = localStorage.getItem(key); if (saved && list.includes(saved)) return saved; } catch { /* storage refused */ }
    const chosen = list[Math.floor(Math.random() * list.length)];
    try { localStorage.setItem(key, chosen); } catch { /* storage refused */ }
    return chosen;
  };
  (window as unknown as { gsrManagerFor?: typeof managerFor }).gsrManagerFor = managerFor;
  // Only teams with several managers need touching; with one, the server-rendered href is already right.
  document.querySelectorAll<HTMLAnchorElement>('a[data-team]').forEach((a) => {
    const team = a.dataset.team || '';
    if ((teams[team] || []).length <= 1) return;
    const who = managerFor(team);
    if (!who) return;
    try { const u = new URL(a.href); u.pathname = `/${who}`; a.href = u.toString(); } catch { /* leave the link as rendered */ }
  });

  if (dlg && typeof dlg.showModal === 'function') {
    const steps = Array.from(dlg.querySelectorAll<HTMLElement>('[data-lp-step]'));
    const show = (name: string) => {
      for (const s of steps) s.hidden = s.dataset.lpStep !== name;
      const current = steps.find((s) => s.dataset.lpStep === name);
      current?.querySelector<HTMLElement>('.lp-opt, .lp-chip')?.focus();
    };
    let opener: HTMLElement | null = null;

    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-picker]');
      if (!a) return;
      // "Open in new tab" and friends keep their plain meaning: the general team's chat.
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      opener = a;
      dlg.showModal();
      show('topic');
    });

    dlg.addEventListener('click', (e) => {
      const el = e.target as Element;
      const go = el.closest<HTMLElement>('[data-lp-go]');
      if (go) { show(go.dataset.lpGo || 'topic'); return; }
      if (el.closest('[data-lp-back]')) { show('topic'); return; }
      if (el.closest('[data-lp-close]')) { dlg.close(); return; }
      // Let the link open Telegram first, then put the page back the way it was.
      if (el.closest('[data-lp-final]')) { setTimeout(() => dlg.close(), 0); return; }
      // The sheet has no padding of its own, so a click whose target is the dialog itself is the backdrop.
      if (el === dlg) dlg.close();
    });

    dlg.addEventListener('close', () => { show('topic'); opener?.focus(); opener = null; });
  }
</script>

<style>
  /* margin: auto is the browser's own centring for a modal dialog; the global reset zeroes every
     margin, which pinned the dialog to the top-left corner. Restated here on purpose. */
  .lp { margin: auto; padding: 0; border: 0; background: transparent; color: var(--fg); width: min(460px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 48px); overflow: visible; }
  .lp::backdrop { background: rgb(11 11 13 / 0.56); }
  .lp[open] { animation: lp-in 180ms var(--ease-out-expo, ease-out); }
  @keyframes lp-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .lp[open] { animation: none; } }
  :global(html:has(dialog.lp[open])) { overflow: hidden; }

  .lp-sheet { background: var(--bg); border: 1px solid var(--card-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-float); padding: 20px; display: grid; gap: 14px; max-height: calc(100dvh - 48px); overflow-y: auto; overscroll-behavior: contain; }
  .lp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .lp-title { font-size: 1.25rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em; margin: 0; text-wrap: balance; }
  .lp-x { flex: none; display: grid; place-items: center; width: 36px; height: 36px; margin: -6px -6px 0 0; border: 0; border-radius: 50%; background: transparent; color: var(--muted); cursor: pointer; }
  .lp-x:hover { background: var(--bg-2); color: var(--fg); }
  .lp-lead { margin: 0; color: var(--muted); font-size: var(--text-small); text-wrap: pretty; }

  .lp-step { display: grid; gap: 12px; }
  .lp-step[hidden] { display: none; }
  .lp-list, .lp-chips { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .lp-opt { width: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 14px 14px; border: 1px solid var(--card-border); border-radius: var(--radius); background: var(--card); color: var(--fg); text-align: left; text-decoration: none; font: inherit; cursor: pointer; transition: border-color var(--dur-fast, 120ms), background-color var(--dur-fast, 120ms); }
  .lp-opt:hover { border-color: var(--accent); }
  .lp-ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--accent-soft); color: var(--accent-text); }
  .lp-txt { display: grid; gap: 2px; min-width: 0; }
  .lp-label { font-weight: 600; line-height: 1.3; }
  .lp-sub { font-size: var(--text-small); color: var(--muted); line-height: 1.35; }
  .lp-opt :global(.lp-chev) { color: var(--meta); }

  .lp-back { justify-self: start; display: inline-flex; align-items: center; gap: 6px; padding: 4px 2px; border: 0; background: none; color: var(--muted); font: inherit; font-size: var(--text-small); cursor: pointer; }
  .lp-back:hover { color: var(--fg); }
  .lp-back :global(.lp-back-ico) { transform: scaleX(-1); }
  .lp-q { margin: 0; font-weight: 600; font-size: 1.0625rem; }
  .lp-chips { grid-template-columns: 1fr 1fr; }
  .lp-chips-wide { grid-template-columns: 1fr; }
  .lp-chip { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 12px 14px; border: 1px solid var(--card-border); border-radius: var(--radius); background: var(--card); color: var(--fg); text-decoration: none; font-weight: 500; line-height: 1.3; transition: border-color var(--dur-fast, 120ms); }
  .lp-chip :global(svg) { flex: none; color: var(--accent-text); }
  .lp-chip:hover { border-color: var(--accent); }
  .lp-foot { margin: 2px 0 0; font-size: var(--text-caption, 0.8125rem); color: var(--meta); text-wrap: pretty; }

  /* A phone gets a bottom sheet: thumbs live at the bottom of the screen, and so does the Telegram button that opened this. */
  @media (max-width: 599px) {
    .lp { width: 100%; margin: auto 0 0; max-height: 92dvh; }
    .lp-sheet { border-radius: var(--radius-lg) var(--radius-lg) 0 0; border-bottom: 0; padding: 18px 16px calc(16px + env(safe-area-inset-bottom)); max-height: 92dvh; }
    .lp[open] { animation-name: lp-up; }
    @keyframes lp-up { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  }
</style>
