---
import type { Lang } from '@/i18n/config';
import { pagePath } from '@/i18n/routes';
import { common } from '@/i18n/common';
import { phoneUrl, telegramChat } from '@/lib/site';
import Icon from './ui/Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang];
---
<div class="mobile-bar" role="region" aria-label="Quick actions">
  <a href={telegramChat(t.telegramDraft.general)} target="_blank" rel="noopener" class="mb-item mb-primary"><Icon name="telegram" size={20} /><span>Telegram</span></a>
  <a href={phoneUrl} class="mb-item"><Icon name="phone" size={20} /><span>{t.cta.call}</span></a>
  <a href={pagePath(lang, 'calculator')} class="mb-item"><Icon name="calculator" size={20} /><span>{t.nav.find((n) => n.key === 'calculator')?.label}</span></a>
</div>
<style>
  .mobile-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 6px; padding: 8px 10px calc(8px + env(safe-area-inset-bottom)); background: color-mix(in oklab, var(--bg), transparent 6%); border-top: 1px solid var(--border-soft); box-shadow: 0 -8px 24px rgb(0 0 0 / 0.06); }
  .mb-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 48px; border-radius: var(--radius); font-size: 0.6875rem; font-weight: 600; color: var(--fg-2); background: var(--bg-2); }
  .mb-primary { background: var(--accent); color: var(--accent-fg); }
  @media (min-width: 900px) { .mobile-bar { display: none; } }
</style>
