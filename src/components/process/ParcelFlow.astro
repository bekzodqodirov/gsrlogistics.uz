---
/**
 * Home "Jarayon" — one carton, six stages.
 *
 * The carton is drawn ONCE and pinned to the centre of the frame; the six receptacles slide past
 * behind it (scale → loaded trailer → truck → two border gates → Tashkent shed → your shopfront).
 * That is literally the parcel's point of view: the box does not travel, the world does.
 *
 * The six stops are `STAGE_KEYS` and the words under them are `tracking[lang].stages[k].short`
 * verbatim — the same words the manager sends on Telegram and the tracking page prints, so the
 * diagram answers "where are my boxes" instead of decorating the section.
 *
 * Mechanic: six radios nested in their labels + `:has()` set `--i` (which frame the strip shows)
 * and `--floor` (where the carton's drawn bottom edge lands). No JavaScript is required for any of
 * it. Without `:has()` it degrades to one drawing above a numbered six-step explainer.
 *
 * The six stops are drawn as outlined tiles, NOT as another hex rail: the section's own five-step
 * `<ol>` sits directly above with a hex rail that is not interactive, and a second rail underneath
 * it read as one more progress indicator — the owner scrolled straight past it. A tile with a
 * border, a hover fill, a pressed state and an underline is a control at rest, with JS off.
 *
 * The one enhancement (see the module script) is auto-advance: while the strip is on screen it
 * walks itself ONCE, 01→06, and the underline on the current tile sweeps for exactly the step so
 * the motion reads as playback rather than a glitch. The first step is short (`--gs-lead`) and
 * the rest are the reading pace (`--gs-dwell`): at one uniform dwell the block's opening seconds
 * were measurably still — 0.003% of its pixels changed per 100ms — so a visitor who did not wait
 * out a whole dwell saw a photograph. It drives the same radios, so there is no second state,
 * and it stops for good at the visitor's first click, key or focus anywhere in the block.
 *
 * Props: { lang, id? } — `id` seeds the radio `name` so two instances never collide.
 */
import type { Lang } from '@/i18n/config';
import { pick } from '@/i18n/config';
import { tracking, STAGE_KEYS } from '@/i18n/tracking';
import { parcel } from '@/i18n/parcel';
import { pagePath } from '@/i18n/routes';
import { fmtNumber, fmtUsd } from '@/lib/format';
import tariffs from '@/data/tariffs.json';

interface Props { lang: Lang; id?: string }
const { lang, id = 'gs' } = Astro.props;
const tr = pick(lang, tracking);
const t = pick(lang, parcel);

/* Every number in the chips comes from the tariff sheet — edit tariffs.json and this moves with it. */
const range = (d: number[]) => `${fmtNumber(d[0], lang)}–${fmtNumber(d[1], lang)}`;
const vars: Record<string, string> = {
  rate: fmtUsd(tariffs.truck.lclPerM3ByDensity[0].rate, lang),
  truckDays: range(tariffs.truck.days),
  airDays: range(tariffs.air.days),
  railDays: range(tariffs.rail.days),
};
const fill = (s: string): string => s.replace(/\{(\w+)\}/g, (m, k: string) => vars[k] ?? m);

/* Rail silhouettes, 24-unit grid. The stage names only appear from 1120px, so without these the
   rail would be six identical dots and the phone reader would get no story at rest. */
const GLYPHS: string[] = [
  '<path d="M12 2.5v8M8.5 7l3.5 3.5L15.5 7"/><path d="M3.5 13.5v7h17v-7M3.5 13.5h17"/>',
  '<rect x="2.5" y="12.5" width="8" height="8" rx="1"/><rect x="13.5" y="12.5" width="8" height="8" rx="1"/><rect x="8" y="3.5" width="8" height="8" rx="1"/>',
  '<rect x="2" y="6.5" width="12" height="9.5" rx="1"/><path d="M14 9.5h4l3.5 3.5V16H14z"/><circle cx="7" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/>',
  '<path d="M4.5 21V6.5M2 21h5"/><path d="M4.5 9.5H21"/><path d="M10 9.5v3.5M15.5 9.5v3.5"/>',
  '<path d="M2.5 10 12 5l9.5 5M4.5 10v10.5h15V10"/><path d="M9 20.5v-6.5h6v6.5M9 17h6"/>',
  '<rect x="2.5" y="7.5" width="12" height="12" rx="1"/><path d="M11 13.5l3 3 7-8"/>',
];

/* The six receptacles, drawn on one 360×200 grid and shown through a y 8→192 window, with one
   horizon at y=176 in every scene — the carton is the only thing that is allowed to move.
   `--floor` in the stylesheet is where the carton's drawn bottom edge lands in each of them.
   `stroke="var(--gs-dim)"` rather than a class: these strings are injected raw, so Astro's scoped
   class names never reach them. */
const SCENES: Array<{ g: string; labels?: Array<{ x: string; y: string; s: string }> }> = [
  {
    /* 1 · received — camera on a stand at the left, platform scale, readout head at the right.
       kg and m³ are the two things actually measured, which is why the price can be per m³ by
       density; the camera with three rays at the box is the photo report, drawn instead of said. */
    g:
      '<path d="M0 176h360" stroke="var(--gs-dim2)"/>' +
      '<rect x="106" y="150" width="148" height="6" rx="3"/><path d="M180 156v12"/><rect x="140" y="168" width="80" height="8" rx="4"/>' +
      '<path d="M288 176V102"/><rect x="256" y="62" width="64" height="40" rx="4"/>' +
      '<rect x="36" y="62" width="60" height="42" rx="6"/><circle cx="66" cy="83" r="12"/><circle cx="66" cy="83" r="4.5"/>' +
      '<path d="M50 62v-8h16v8"/><path d="M66 104v72M54 176h24"/>' +
      '<g stroke="var(--gs-dim)"><path d="M102 72l16 6M102 83h17M102 94l16-6"/></g>',
    labels: [{ x: '80%', y: '34.5%', s: 'kg' }, { x: '80%', y: '44.5%', s: 'm³' }],
  },
  {
    /* 2 · consolidation — loaded trailer. Two ribs fence an 82-unit slot, exactly the carton's width
       plus breathing room; the four unlabelled greys are other clients' cargo. The one red-labelled
       box inside the fence IS the sentence "you do not need a whole truck, you pay for your space". */
    g:
      '<rect x="30" y="44" width="300" height="106" rx="3"/>' +
      '<path d="M139 44v106M221 44v106" stroke="var(--gs-dim2)"/>' +
      '<path d="M40 150h280v8H40z"/>' +
      '<circle cx="96" cy="166" r="10"/><circle cx="96" cy="166" r="3.5"/>' +
      '<circle cx="264" cy="166" r="10"/><circle cx="264" cy="166" r="3.5"/>' +
      '<g stroke="var(--gs-dim)"><rect x="42" y="94" width="44" height="56" rx="2"/><rect x="92" y="78" width="42" height="72" rx="2"/><rect x="226" y="84" width="42" height="66" rx="2"/><rect x="274" y="100" width="44" height="50" rx="2"/></g>' +
      '<path d="M0 176h360" stroke="var(--gs-dim2)"/>',
  },
  {
    /* 3 · transit — one truck, side view. It reads left→right with the strip: this is a process, not
       a map (no country shapes, no curve), so it never contradicts RouteBand's east→west line.
       Air and rail live in the fact chips — the five-second read stays one truck. */
    g:
      '<rect x="30" y="48" width="196" height="96" rx="4"/>' +
      '<path d="M226 144V88h42l34 34v22z"/><path d="M236 94h24l12 13h-36z"/>' +
      '<path d="M40 144h262v8H40z"/>' +
      '<circle cx="76" cy="164" r="12"/><circle cx="76" cy="164" r="4"/>' +
      '<circle cx="180" cy="164" r="12"/><circle cx="180" cy="164" r="4"/>' +
      '<circle cx="278" cy="164" r="12"/><circle cx="278" cy="164" r="4"/>' +
      '<path d="M0 176h360"/><path class="gs-road" stroke="var(--gs-dim2)" d="M-8 184h376"/>',
  },
  {
    /* 4 · customs — TWO gates, 24 units apart: China→Kazakhstan already passed (grey), then
       Kazakhstan→Uzbekistan still ahead. Two borders, not one, is the surprising true thing on this
       page and the fact that explains where the days go. */
    g:
      '<path d="M0 176h360" stroke="var(--gs-dim2)"/>' +
      '<g stroke="var(--gs-dim)"><path d="M84 176V85M72 176h24"/><rect x="84" y="74" width="84" height="11" rx="5.5"/><path d="M105 74v11M126 74v11M147 74v11"/></g>' +
      '<path d="M276 176V85M264 176h24"/>' +
      '<rect x="192" y="74" width="84" height="11" rx="5.5"/>' +
      '<path d="M213 74v11M234 74v11M255 74v11"/>',
    labels: [{ x: '35%', y: '27%', s: 'CN → KZ' }, { x: '65%', y: '27%', s: 'KZ → UZ' }],
  },
  {
    /* 5 · tashkent — shed: shallow pitch, wide eaves, so it reads warehouse and not house. The
       doorway is 133→227 against a 76-unit carton: 9 units of jamb show each side, which is the
       narrowest gap that still survives the 1.5px non-scaling stroke at a 358px frame. */
    g:
      '<path d="M40 96L180 56l140 40"/><path d="M28 96h304"/><path d="M52 96v80M308 96v80"/>' +
      '<path d="M133 176V90h94v86"/><path d="M125 86h110"/>' +
      '<g stroke="var(--gs-dim)"><rect x="72" y="130" width="44" height="46" rx="2"/><rect x="244" y="138" width="44" height="38" rx="2"/></g>' +
      '<path d="M0 176h360" stroke="var(--gs-dim2)"/>',
  },
  {
    /* 6 · delivered — the customer's own shopfront: flat roofline, sign band, two windows, a door
       the carton's width. Deliberately NOT the stage-5 shed (pitched roof, eaves, side crates), and
       deliberately not a human figure: `.gs-box` is painted above the scene, so no drawn hand can
       ever be in front of the carton, and every silhouette that survives that reads as a pawn. */
    g:
      '<path d="M0 176h360" stroke="var(--gs-dim2)"/>' +
      '<path d="M44 176V60M316 176V60"/><path d="M32 60h296"/>' +
      '<rect x="88" y="66" width="184" height="20" rx="3" stroke="var(--gs-dim)"/>' +
      '<path d="M118 176V96h124v80"/><path d="M110 92h140"/>' +
      '<g stroke="var(--gs-dim)"><rect x="58" y="100" width="46" height="56" rx="2"/><rect x="256" y="100" width="46" height="56" rx="2"/></g>' +
      '<g stroke="var(--accent)"><path d="M302 20l14 7.7v15.4L302 50.8l-14-7.7V27.7z"/><path d="M295.5 35l5 5 8.5-9.5"/></g>',
  },
];
---

<div class="gs-flow reveal" style="--reveal-delay:360ms" data-gs-flow>
  <div class="gs-head">
    <h3>{t.title}</h3>
    <p>{t.hint}</p>
  </div>

  {/* The tile order is number → glyph → name → underline, and the underline is last so the
      `:checked ~` combinator reaches every one of them from the input. */}
  <div class="gs-rail" role="radiogroup" aria-label={t.pickerLabel}>
    {STAGE_KEYS.map((k, i) => (
      <label class="gs-stop">
        <input
          class="gs-pin"
          type="radio"
          name={`${id}-stop`}
          checked={i === 0}
          aria-label={tr.stages[k].short}
          aria-controls={`${id}-say-${i}`}
        />
        <span class="gs-n tnum">0{i + 1}</span>
        <svg class="gs-g" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLYPHS[i]} />
        <span class="gs-nm">{tr.stages[k].short}</span>
        <span class="gs-bar" aria-hidden="true"></span>
      </label>
    ))}
  </div>

  <div class="gs-frame">
    <div class="gs-film">
      {SCENES.map((s) => (
        <div class="gs-scene">
          <svg viewBox="0 8 360 184" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.g} />
          {s.labels?.map((l) => <b aria-hidden="true" style={`left:${l.x};top:${l.y}`}>{l.s}</b>)}
        </div>
      ))}
    </div>
    {/* The one carton. Its viewBox is exactly the ink, so `--floor` is the drawn bottom edge. Flat
        front view, never isometric — an isometric cube hides the label and the label is the point.
        The `--bg` body is what makes it OCCLUDE the trailer wall and the doorway, and occlusion is
        the only thing that says "in" rather than "on top of". GS stays SVG text so it scales. */}
    <svg class="gs-box" viewBox="0 0 76 72" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="1" y="1" width="74" height="70" rx="3" fill="var(--bg)" vector-effect="non-scaling-stroke" />
      <path d="M1 21h74M38 1v20" vector-effect="non-scaling-stroke" />
      <rect x="11" y="33" width="40" height="22" rx="2" fill="var(--accent)" stroke="none" />
      <text x="31" y="48.5" font-size="15" font-weight="700" fill="var(--accent-fg)" stroke="none" text-anchor="middle" letter-spacing="0.5">GS</text>
      <path d="M57 38h8M57 46h8M57 54h5" stroke="var(--gs-dim)" vector-effect="non-scaling-stroke" />
    </svg>
  </div>

  <div class="gs-says">
    <ol class="gs-sfilm">
      {STAGE_KEYS.map((k, i) => (
        <li class="gs-say" id={`${id}-say-${i}`}>
          <h4>{tr.stages[k].short}</h4>
          <p>{t.steps[i].text}</p>
          <ul class="gs-facts">{t.steps[i].facts.map((f) => <li>{fill(f)}</li>)}</ul>
        </li>
      ))}
    </ol>
  </div>

  <div class="gs-foot">
    <p class="gs-note">{t.note}</p>
    <a class="link" href={pagePath(lang, 'tracking')}>{t.trackLink}</a>
  </div>
</div>

<script>
  // Auto-advance — a progressive enhancement over a picker that already works without it.
  //
  // It writes `.checked` on the same six radios the stylesheet reads, so there is exactly one
  // source of truth and nothing to keep in sync. It never calls .focus() and never dispatches an
  // event: `:checked` is a property, the selectors see it on the next style recalc, and no
  // listener (and no live region — there is none here on purpose) can be woken by it. That is
  // what keeps a screen-reader user's place: nothing is announced, and the first focus into the
  // group stops the timer for good, so the selection can never move under someone reading it.
  //
  // Off entirely under reduced motion, on a hidden tab, off screen, on a low-end/save-data
  // client, and from the visitor's first deliberate interaction with the block onwards.
  //
  // "Deliberate" is `click` / `keydown` / `focusin`, never `pointerdown` or `touchstart`: on a
  // phone the finger that starts a scroll lands somewhere, and a finger landing on the strip used
  // to kill the whole thing before it had shown one frame (measured — see the notes on the fix).
  // A swipe that scrolls produces no click, so scrolling now leaves playback alone.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
  const lowEnd =
    !!nav.connection?.saveData ||
    (!!nav.deviceMemory && nav.deviceMemory <= 2) ||
    (!!nav.hardwareConcurrency && nav.hardwareConcurrency <= 2);
  // Without :has() the strip is display:none and the six stages are all on the page at once:
  // advancing invisible radios would be pure battery burn.
  const usable = !reduce && !lowEnd && 'IntersectionObserver' in window && CSS.supports('selector(:has(*))');

  if (usable) {
    for (const root of document.querySelectorAll<HTMLElement>('[data-gs-flow]')) {
      const pins = Array.from(root.querySelectorAll<HTMLInputElement>('.gs-pin'));
      const strip = root.querySelector<HTMLElement>('.gs-rail');
      if (pins.length < 2 || !strip) continue;

      // Both step lengths live in the stylesheet, because the underline sweep is a CSS animation
      // of the same length; reading them here is what keeps the two identical.
      // --gs-lead is the FIRST step only. At --gs-dwell the block's first 3.2s were measurably
      // dead: 3-8 changed pixels per 100ms, 0.003% of the block, which is the sweep and nothing
      // else. A visitor who lingers less than a full dwell saw a still picture — exactly the
      // "they will just scroll past" the lead-in is here to stop.
      const ms = (n: string) => {
        const raw = getComputedStyle(root).getPropertyValue(n).trim();
        return raw.endsWith('ms') ? parseFloat(raw) : parseFloat(raw) * 1000;
      };
      const dwell = ms('--gs-dwell');
      const lead = ms('--gs-lead');
      if (!(dwell > 400) || !(lead > 200)) continue;

      let timer = 0;
      let onScreen = false;
      let live = true;
      let step = lead;

      // One pass, stopping on the last stage. It does NOT loop: rewinding six frames of film in
      // 520ms is the one movement here that looks like a fault rather than a story, and ending on
      // "delivered" with all six underlines full is the right thing to leave on the screen.
      const tick = () => {
        const next = pins.findIndex((p) => p.checked) + 1;
        if (next >= pins.length) { retire(); return; }
        pins[next].checked = true; // `:checked` is what the stylesheet reads — no event, no focus
        // From the second step on it is the reading pace, not the wake-up. `.is-run` swaps
        // --gs-step in the stylesheet so the sweep lengthens with the timer, in one place.
        step = dwell;
        root.classList.add('is-run');
        timer = window.setTimeout(tick, step);
      };
      const play = () => {
        if (!live || !onScreen || document.hidden || timer) return;
        root.classList.add('is-auto'); // starts the sweep on whichever tile is current
        timer = window.setTimeout(tick, step);
      };
      const pause = () => {
        if (timer) { clearTimeout(timer); timer = 0; }
        root.classList.remove('is-auto');
      };

      const seen = ['click', 'keydown', 'focusin'] as const;
      const io = new IntersectionObserver(
        (entries) => { onScreen = entries[entries.length - 1].isIntersecting; onScreen ? play() : pause(); },
        // Any part of the strip inside the middle 76% of the viewport counts as on screen, which
        // holds whether the block is taller or shorter than the window.
        { rootMargin: '-12% 0px -12% 0px' },
      );
      const onVis = () => { document.hidden ? pause() : play(); };
      // Called by the visitor's first deliberate interaction anywhere in the block and by the end
      // of the one pass. Dropping `.is-arm` hands the underline back to the stylesheet, which
      // fills it for the current stage.
      function retire() {
        if (!live) return;
        live = false;
        pause();
        root.classList.remove('is-arm', 'is-run');
        io.disconnect();
        document.removeEventListener('visibilitychange', onVis);
        for (const type of seen) root.removeEventListener(type, retire);
      }

      root.classList.add('is-arm');
      // On the root, not the strip: pressing the tracking link or tabbing into the block is the
      // visitor taking over too, and WCAG 2.2.2 wants the stop within easy reach of the motion.
      for (const type of seen) root.addEventListener(type, retire, { passive: true });
      document.addEventListener('visibilitychange', onVis);
      io.observe(root);
    }
  }
</script>

<style>
  /* Two grey levels. --border is 1.5:1 on --bg-3 and vanishes at these line weights, so the drawings
     use the palette's own greys: --gs-dim for secondary objects, --gs-dim2 for ground lines. */
  .gs-flow {
    --i: 0;
    --floor: 150;
    --gs-dim: var(--gray-500);
    --gs-dim2: var(--gray-400);
    /* One source of truth for both step lengths: the underline sweep is
       `animation: … var(--gs-step)` and the module script reads these same properties off the
       root for its timer, so the bar can never finish early or late. Change them here.
       --gs-lead is the FIRST step only, so the block shows it is playing before a visitor has
       decided to scroll on; --gs-dwell is the reading pace for every step after that.
       FLOOR on --gs-lead: the block is a `.reveal`, and on an instant jump straight to it the
       reveal and the playback start in the same frame, so the lead must outlast
       --reveal-delay (360ms) + --dur-reveal (600ms) = 960ms or the first slide happens while the
       block is still fading in. Measured on a jump: reveal done at 960ms, first slide at 1230ms. */
    --gs-lead: 1.2s;
    --gs-dwell: 3.2s;
    --gs-step: var(--gs-lead);
    position: relative;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .gs-head { display: grid; gap: 6px; margin-bottom: 20px; max-width: 46ch; }
  .gs-head h3 { font-size: var(--text-h3); font-weight: 600; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); text-wrap: balance; }
  .gs-head p { font-size: var(--text-small); color: var(--muted); text-wrap: pretty; }

  /* ---------- the six controls ---------- */
  /* Six outlined tiles, not a rail: see the header note. The gap is what the eye reads as "six
     separate things", so it never collapses below 6px even at 320px. */
  .gs-rail { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(6px, 0.7vw, 10px); margin: 0 0 18px; }

  .gs-stop {
    position: relative;
    display: grid; grid-template-rows: 12px 24px auto; justify-items: center; row-gap: 6px;
    padding: 8px 4px 15px;
    border: 1px solid var(--border-soft); border-radius: var(--radius); background: var(--bg);
    cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: border-color 200ms var(--ease), background-color 200ms var(--ease), transform 120ms var(--ease);
  }
  .gs-pin { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .gs-n { display: grid; place-items: center; font-size: var(--text-caption); font-weight: 500; color: var(--meta); line-height: 1; transition: color 200ms var(--ease); }
  .gs-g { width: 24px; height: 24px; color: var(--meta); transition: color 200ms var(--ease); }
  .gs-nm { display: none; }

  /* The underline: track always drawn, fill scaled from the left. Full on every stop already
     passed and on the current one, empty ahead — the same "3 of 6" the rail used to say, on a
     part of the tile that also reads as a tab indicator. */
  .gs-bar { position: absolute; left: 9px; right: 9px; bottom: 6px; height: 3px; border-radius: var(--radius-pill); background: var(--border); overflow: hidden; }
  .gs-bar::after { content: ''; display: block; height: 100%; border-radius: inherit; background: var(--accent); transform: scaleX(0); transform-origin: left center; transition: transform 420ms var(--ease-out-expo); }
  .gs-stop:has(~ .gs-stop :checked) .gs-bar::after { transform: scaleX(1); }

  /* Sibling combinators where the input can reach; :has() only for the label itself. */
  .gs-pin:checked ~ .gs-g, .gs-pin:checked ~ .gs-n, .gs-pin:checked ~ .gs-nm { color: var(--fg); }
  .gs-pin:checked ~ .gs-n, .gs-pin:checked ~ .gs-nm { font-weight: 600; }
  .gs-pin:checked ~ .gs-bar::after { transform: scaleX(1); }
  /* Selected = the one near-black outline in the row. Red is spent on the underline, not here. */
  .gs-stop:has(:checked) { border-color: var(--fg); }
  .gs-stop:has(:focus-visible) { box-shadow: var(--focus-ring); }
  .gs-stop:active { background-color: var(--bg-2); transform: scale(0.97); }
  @media (hover: hover) {
    .gs-stop:hover { border-color: var(--border); }
    .gs-stop:hover:not(:has(:checked)) { background-color: var(--bg-2); }
    .gs-stop:hover .gs-g, .gs-stop:hover .gs-n { color: var(--fg); }
  }

  /* Playback, in three classes, all written by the script and none present with JS off.
     `.is-arm` goes on at parse time and empties the current underline BEFORE the strip is ever
     scrolled to — without it the bar would be full on arrival and then snap back to zero the
     instant playback began, which is exactly the flicker that reads as a bug.
     `.is-auto` is on only while the strip is on screen, so the sweep starts, pauses and restarts
     with the timer. `.is-run` is added at the first advance and lengthens the step from the
     wake-up --gs-lead to the reading --gs-dwell; sweep and timer stay identical because both
     read --gs-step. */
