---
/**
 * Home "06 — Kuzatuv" (DESIGN_BRIEF §3.7): dark short band with an inline code input that
 * submits (GET ?code=) to the tracking page, and the honest "Namuna" status strip.
 * Props: { lang }.
 */
import type { Lang } from '@/i18n/config';
import { pick } from '@/i18n/config';
import { common } from '@/i18n/common';
import { tracking, STAGE_KEYS } from '@/i18n/tracking';
import { pagePath } from '@/i18n/routes';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pick(lang, tracking);
const c = common[lang];
const trackingHref = pagePath(lang, 'tracking');
const SAMPLE_INDEX = 2;
---
<section id="kuzatuv" class="section dark noise teaser below-fold" aria-labelledby="track-teaser-h">
  <svg class="bg-route" viewBox="0 0 1600 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <path d="M1560 60 C 1300 90, 1150 120, 1000 150 S 700 200, 520 220 S 330 250, 240 262" fill="none" stroke="currentColor" stroke-width="1.5" />
    <g fill="currentColor">
      <circle cx="1560" cy="60" r="4" /><circle cx="1205" cy="112" r="3" /><circle cx="1000" cy="150" r="3" /><circle cx="680" cy="196" r="3" /><circle cx="520" cy="220" r="3" /><circle cx="417" cy="236" r="3" /><circle cx="240" cy="262" r="4" />
    </g>
  </svg>
  <div class="container grid">
    <div class="copy">
      <Eyebrow>{t.teaser.eyebrow}</Eyebrow>
      <h2 id="track-teaser-h" class="measure-head">{t.teaser.h2}</h2>
      <p class="intro text">{t.teaser.text}</p>
    </div>
    <div class="panel">
      <form class="row" method="get" action={trackingHref}>
        <label class="sr-only" for="teaser-code">{c.strings.enterCode}</label>
        <input class="input code tnum" id="teaser-code" name="code" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={t.form.placeholder} maxlength="32" required pattern="[A-Za-z0-9][A-Za-z0-9\-]{2,31}" />
        <button type="submit" class="btn btn-primary"><Icon name="search" size={18} />{c.strings.track}</button>
      </form>
      <div class="strip-wrap">
        <span class="tag">{c.strings.sample}</span>
        <div class="strip-scroll">
          <ol class="strip" role="list" aria-label={t.glossary.title}>
            {STAGE_KEYS.map((k, i) => (
              <li class:list={['node', i < SAMPLE_INDEX && 'is-past', i === SAMPLE_INDEX && 'is-current']} aria-current={i === SAMPLE_INDEX ? 'step' : undefined}>
                <span class="dot" aria-hidden="true"></span>
                <a class="node-label" href={`${trackingHref}#holat-${k}`}>{t.stages[k].short}</a>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <a class="link glossary-link" href={`${trackingHref}#holatlar`}>{t.teaser.link}</a>
    </div>
  </div>
</section>

<style>
  .teaser { min-height: 320px; padding-block: clamp(96px, 8vw, 112px); overflow: hidden; }
  .bg-route { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--fg); opacity: 0.08; pointer-events: none; }
  .grid { position: relative; display: grid; gap: 32px; }
  .text { margin-top: 16px; color: var(--muted); max-width: 48ch; }
  .copy h2 { margin-top: 16px; }
  .panel { display: grid; gap: 20px; }
  .row { display: grid; gap: 10px; }
  .code { min-height: 52px; font-size: 1.125rem; letter-spacing: 0.02em; }
  .strip-wrap { display: grid; gap: 12px; }
  .tag { display: inline-flex; width: max-content; align-items: center; padding: 2px 10px; border-radius: var(--radius-pill); border: 1px solid var(--border); font-size: var(--text-caption); font-weight: 600; color: var(--muted); letter-spacing: 0.02em; }
  .strip-scroll { overflow-x: auto; scrollbar-width: none; margin-inline: -4px; padding-inline: 4px; }
  .strip { display: grid; grid-template-columns: repeat(6, minmax(108px, 1fr)); position: relative; min-width: 648px; padding: 0; margin: 0; }
  .strip::before { content: ''; position: absolute; left: 8px; right: 8px; top: 7px; height: 1.5px; background: var(--border); }
  .node { position: relative; display: grid; gap: 10px; justify-items: start; padding-right: 8px; }
  .dot { position: relative; z-index: 1; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--border); background: var(--bg); box-sizing: border-box; }
  .node.is-past .dot { background: var(--muted); border-color: var(--muted); }
  .node.is-current .dot { background: var(--accent-text); border-color: var(--accent-text); }
  .node-label { font-size: var(--text-small); color: var(--muted); line-height: 1.3; max-width: 12ch; padding-right: 6px; }
  .node.is-current .node-label { color: var(--fg); font-weight: 600; }
  .node-label:hover { text-decoration: underline; text-underline-offset: 3px; }
  .glossary-link { font-size: var(--text-small); }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr auto; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: 5fr 7fr; gap: 64px; align-items: start; } }
</style>
