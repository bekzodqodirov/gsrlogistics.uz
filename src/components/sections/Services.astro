---
/**
 * Home "02 — Xizmatlar". One business, then everything else.
 *
 * The nine services used to sit here as nine near-equal bento cards, which reads as "we do
 * everything". They are now in three tiers, loudest first:
 *   1. the flagship (consolidated truck cargo) — one full-width card, the only display-scale
 *      heading in the section, with the micro route-line, the day range at stat scale and the
 *      per-m³ rate under it (each figure printed once: see `truckPrice`);
 *   2. the two other ways down the same route (air, rail) — half-width cards at h4 scale,
 *      under their own sub-head, closed by the quiet "which mode?" comparison strip;
 *   3. the long tail (sourcing, buying, equipment, customs, warehouse, cars) — a two-column
 *      list on hairlines, no card, no glyph tile.
 * Nothing is removed: every service still links to its own page.
 *
 * PHOTO SLOT — `flagshipPhoto` below. Props: { lang }.
 */
import { pick, type Locale } from '@/i18n/config';
import { servicesStrings, serviceNumberLine, tpl } from '@/i18n/services';
import { itemPath } from '@/i18n/routes';
import { services, type ServiceMeta } from '@/data/services';
import { fmtDate, fmtNumber } from '@/lib/format';
import tariffs from '@/data/tariffs.json';
import Icon from '@/components/ui/Icon.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = pick(lang, servicesStrings);
const range = (a: number, b: number) => `${fmtNumber(a, lang)}–${fmtNumber(b, lang)}`;
const href = (s: ServiceMeta) => itemPath(lang, 'services', s.slug);

const flagship = services.find((s) => s.flagship) ?? services[0];
const modeKeys = ['air', 'rail'] as const;
const modes = modeKeys.map((k) => services.find((s) => s.key === k)).filter((s): s is ServiceMeta => !!s);
/* Everything that is not moving the cargo itself, in registry order. */
const tail = services.filter((s) => s !== flagship && !modes.includes(s));

const compare = [
  { key: 'truck', icon: 'truck', name: pick(lang, services.find((s) => s.key === 'truck')!.name), days: range(tariffs.truck.days[0], tariffs.truck.days[1]), fit: t.home.compare.truck },
  { key: 'air', icon: 'plane', name: pick(lang, services.find((s) => s.key === 'air')!.name), days: range(tariffs.air.days[0], tariffs.air.days[1]), fit: t.home.compare.air },
  { key: 'rail', icon: 'train', name: pick(lang, services.find((s) => s.key === 'rail')!.name), days: range(tariffs.rail.days[0], tariffs.rail.days[1]), fit: t.home.compare.rail },
] as const;
const truckDays = range(tariffs.truck.days[0], tariffs.truck.days[1]);
/**
 * The flagship's price line. It deliberately does NOT repeat the day range: the range is the card's
 * one big numeral a few centimetres to its left, and printing "15–25 kun" twice inside one card
 * (which is what `serviceNumberLine('truck')` did here) reads as a template that has not been read.
 * Both figures come straight from the truck sheet — headline rate and minimum billable volume.
 */
const truckPrice = `${tpl(t.line.fromM3, { n: fmtNumber(tariffs.truck.lclPerM3ByDensity[0].rate, lang) })} · ${tpl(t.home.flagshipMinVolume, { n: fmtNumber(tariffs.truck.minM3, lang) })}`;

/**
 * Real photo slot for the flagship card. Empty until the owner's own shot arrives — an image
 * service or a stock photo would be a lie about a warehouse we are naming by address.
 *
 * WHICH SHOT: cartons with the GS mark stacked at the China receiving point, being loaded into
 * the trailer. Landscape, 4:3, the boxes filling the frame; a truck-only shot with no cargo
 * does not say "consolidated". Shot list name: "loading at the receiving point".
 *
 * TO FILL IT: drop the file in src/assets/photos/ and
 *   import flagshipShot from '@/assets/photos/<file>.jpg';
 *   const flagshipPhoto = flagshipShot;
 * Astro's ImageMetadata already carries src/width/height, so nothing else changes. With no
 * photo the card keeps the day-range stat in the same slot, so the section is finished either
 * way — the photo replaces the stat, it does not leave a hole waiting for it.
 */
const flagshipPhoto = null as { src: string; width: number; height: number } | null;
---
<section id="xizmatlar" class="section services below-fold" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <Eyebrow>{t.home.eyebrow}</Eyebrow>
      <h2 id="services-title" class="measure-head">{t.home.h2}</h2>
      <p class="intro">{t.home.intro}</p>
    </div>

    <!-- 1 — the business -->
    <a href={href(flagship)} class:list={['card', 'card-hover', 'flagship', 'reveal', flagshipPhoto && 'has-photo']}>
      <div class="flag-copy">
        <div class="top">
          <Icon name={flagship.icon} size={24} class="glyph" />
          <span class="badge">{t.home.flagshipBadge}</span>
        </div>
        <h3 class="flag-title">{pick(lang, flagship.name)}</h3>
        <p class="flag-sentence">{pick(lang, flagship.short)}</p>
        {/* With a photo in the aside the figures have nowhere else to go, so the standard number
            line comes back here. Without one the aside carries them, unrepeated. */}
        {flagshipPhoto && <p class="numline tnum">{serviceNumberLine(lang, flagship.key)}</p>}
      </div>

      {flagshipPhoto ? (
        <figure class="flag-shot">
          <img src={flagshipPhoto.src} width={flagshipPhoto.width} height={flagshipPhoto.height} alt={t.home.flagshipPhotoAlt} loading="lazy" decoding="async" />
        </figure>
      ) : (
        <div class="flag-stat">
          <!-- Absolutely positioned so it stretches to the stat's width without driving the grid
               track; preserveAspectRatio none + non-scaling-stroke keep the stroke 1.5px at any width. -->
          <svg class="microline" viewBox="0 0 120 12" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
            <path d="M1 11 C 34 11, 66 1, 119 1" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            <path d="M119 1 L119 1" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          </svg>
          <p class="stat-line"><span class="stat">{truckDays}</span><span class="num-unit">{t.line.days}</span></p>
          <p class="stat-cap caption">{t.home.flagshipStatLabel}</p>
          <p class="flag-price tnum">{truckPrice}</p>
        </div>
      )}

      <!-- Own row, not the last line of .flag-copy: once the card stacks on a phone a link inside
           the copy lands above the figures, which is the opposite of every other card here. -->
      <span class="link flag-link">{t.home.details}</span>
    </a>

    <!-- 2 — the other two ways down the same route -->
    <div class="group">
      <div class="group-head">
        <h3 class="group-title">{t.home.modes.title}</h3>
        <p class="group-text">{t.home.modes.text}</p>
      </div>
      <ul class="modes" role="list">
        {modes.map((s, i) => (
          <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
            <a href={href(s)} class="card card-hover mode">
              <div class="top"><Icon name={s.icon} size={20} class="glyph" /></div>
              <h4 class="mode-title">{pick(lang, s.name)}</h4>
              <p class="sentence">{pick(lang, s.short)}</p>
              <p class="numline tnum">{serviceNumberLine(lang, s.key)}</p>
              <span class="link">{t.home.details}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="card compare reveal" style="--reveal-delay:120ms">
        <p class="compare-title">{t.home.compare.title}</p>
        <ul class="compare-grid" role="list">
          {compare.map((c) => (
            <li class="compare-col">
              <Icon name={c.icon} size={20} class="glyph" />
              <p class="compare-days tnum"><span>{c.days}</span><span class="num-unit">{t.line.days}</span></p>
              <p class="compare-name">{c.name}</p>
              <p class="compare-fit">{c.fit}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 3 — the long tail, as a list rather than six more cards -->
    <div class="group">
      <div class="group-head">
        <h3 class="group-title">{t.home.tail.title}</h3>
        <p class="group-text">{t.home.tail.text}</p>
      </div>
      <ul class="tail" role="list" aria-label={t.home.tail.listLabel}>
        {tail.map((s) => (
          <li>
            <a href={href(s)} class="tail-row">
              <Icon name={s.icon} size={20} class="tail-glyph" />
              <span class="tail-body">
                <span class="tail-name">{pick(lang, s.name)}</span>
                <span class="tail-text">{pick(lang, s.short)}</span>
              </span>
              <span class="chev" aria-hidden="true">›</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="caption grid-meta">{tpl(t.home.meta, { date: fmtDate(tariffs.updated, lang) })}</p>
  </div>
</section>

<style>
  .services { background: var(--bg); }

  /* ---------- 1 — flagship ---------- */
  /* Three areas: copy (1/1), the aside spanning both rows in column 2, and the link on its own
     row under the copy so the stacking order on a phone is copy → figures → link, like the mode
     cards below. */
  .flagship {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    column-gap: 40px; row-gap: 14px;
    align-items: end; padding: clamp(24px, 3vw, 40px); color: var(--fg);
  }
  .flag-copy { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .flag-stat, .flag-shot { grid-area: 1 / 2 / 3 / 3; align-self: end; }
  .flag-link { grid-area: 2 / 1; margin-top: 0; }
  .top { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  /* The glyph is a deliberate object, not a hairline: a 44px tile (24px art + 10px padding) on a
     soft ground. Bare, a 24px stroke icon is 0.54% of a 384×280 card and ~0.11% of it in ink.
     content-box so the padding adds to the 24px art instead of eating it. */
  .top :global(.glyph) {
    box-sizing: content-box; flex: none;
    width: 24px; height: 24px; padding: 10px;
    color: var(--accent); background: var(--accent-soft);
    border: 1px solid var(--accent-soft); border-radius: 12px;
  }
  /* The section's one display-scale heading — this is what makes the tier visible at a glance. */
  .flag-title { font-size: clamp(1.75rem, 1.4vw + 1.25rem, 2.75rem); line-height: 1.08; font-weight: 700; letter-spacing: -0.015em; text-wrap: balance; max-width: 18ch; }
  .flag-sentence { font-size: var(--text-intro); line-height: 1.4; color: var(--fg-2); max-width: 46ch; text-wrap: pretty; }
  .numline { font-weight: 600; color: var(--fg); margin-top: auto; padding-top: 4px; }
  .flagship .numline { padding-top: 8px; }
  .link { margin-top: 4px; }

  /* The aside is stretched, not shrink-wrapped, so the rule above the price spans the whole track
     and the road-line, the numeral and the price all end on the same right edge. */
  .flag-stat { position: relative; display: grid; gap: 2px; padding: 22px 0 6px; text-align: right; }
  /* width, not right:0 — an SVG is a replaced element, so with height set the intrinsic ratio wins
     over the inset and it would render at its viewBox width instead of stretching. */
  .microline { position: absolute; top: 0; left: 0; width: 100%; height: 12px; overflow: visible; }
  .stat-line { display: flex; align-items: baseline; justify-content: flex-end; white-space: nowrap; }
  .stat-line .stat { font-size: clamp(2.5rem, 3vw + 1.25rem, 4rem); color: var(--fg); }
  .stat-cap { color: var(--muted); }
  /* The second figure, at body scale: a price is checked, not glanced at, so it does not compete
     with the numeral — but it is the other half of "what does this cost me", so it is not a note. */
  .flag-price { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border-soft); font-size: var(--text-small); font-weight: 600; color: var(--fg); }

  /* Photo slot: 4:3, same corner radius as the card's inner edge, cropped to fill so a portrait
     phone shot cannot stretch the row. Only rendered once a real photo is set. */
  .flag-shot { margin: 0; border-radius: var(--radius); overflow: hidden; background: var(--bg-2); }
  .flag-shot img { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  /* A photo carries its own weight; the day-stat needs the long run of the micro route-line to
     fill the same track, so the two asides are not the same width. */
  .has-photo { align-items: stretch; grid-template-columns: minmax(0, 1fr) minmax(0, 380px); }
  .has-photo .flag-copy { justify-content: center; }
  .has-photo .flag-shot { align-self: stretch; }

  /* ---------- 2 & 3 — groups ---------- */
  .group { margin-top: clamp(40px, 5vw, 72px); }
  .group-head { display: grid; gap: 6px; margin-bottom: 20px; max-width: 56ch; }
  .group-title { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.004em; color: var(--fg); }
  .group-text { font-size: var(--text-small); color: var(--muted); text-wrap: pretty; }

  .modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; }
  .modes > li { display: grid; min-width: 0; }
  .mode { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 24px; color: var(--fg); }
  /* 36px tile, not 44px: the second tier has to be lighter than the flagship in ink as well as in type. */
  .mode .top :global(.glyph) {
    box-sizing: content-box; flex: none;
    width: 20px; height: 20px; padding: 8px; margin-bottom: 6px;
    color: var(--fg); background: var(--bg-2);
    border: 1px solid var(--border-soft); border-radius: 10px;
  }
  :global(.dark) .mode .top :global(.glyph) { background: rgb(255 255 255 / 0.06); border-color: var(--card-border); }
  .mode-title { font-size: 1.25rem; line-height: 1.2; font-weight: 600; letter-spacing: -0.006em; text-wrap: balance; }
  .sentence { color: var(--fg-2); font-size: var(--text-small); text-wrap: pretty; }

  /* the card is stretched by its row, so centre the block instead of pooling the slack at the bottom */
  .compare { background: var(--bg-3); display: grid; gap: 20px; margin-top: 24px; padding: 24px; }
  .compare-title { font-size: var(--text-body); font-weight: 600; color: var(--fg); }
  .compare-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; list-style: none; margin: 0; padding: 0; }
  .compare-col { display: grid; gap: 6px; padding-right: 20px; align-content: start; }
  .compare-col + .compare-col { border-left: 1px solid var(--border-soft); padding-left: 20px; }
  /* --muted on --bg-3 is 4.91:1 behind a 1.46px stroke — the quietest mark in the section. --fg-2 is 9.69:1. */
  .compare-col :global(.glyph) { color: var(--fg-2); flex: none; margin-bottom: 4px; }
  /* .num-unit's global gap is 0.12em of the *unit* (~1.8px) — a word-space beside the flagship's 64px
     numeral, nothing beside a 22px one, so "15–25days" ran together. The global .stat rule adds the
     numeral-scaled half; .compare-days is not .stat, so add it here. */
  .compare-days > span:first-child { margin-right: 0.1em; }
  .compare-days { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; color: var(--fg); line-height: 1; display: flex; align-items: baseline; white-space: nowrap; }
  .compare-name { font-size: var(--text-small); font-weight: 600; color: var(--fg-2); }
  .compare-fit { font-size: var(--text-small); color: var(--muted); text-wrap: pretty; }

  /* ---------- 3 — the long tail ---------- */
  /* No box, no tile: six bordered cards were what made the section read "we do everything".
     A hairline per row carries the same six links at a fraction of the ink. */
  .tail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; margin: 0; padding: 0; }
  .tail > li { border-top: 1px solid var(--border-soft); min-width: 0; }
  .tail-row { display: grid; grid-template-columns: 20px minmax(0, 1fr) 10px; align-items: start; gap: 14px; padding: 18px 0; }
  .tail-glyph { color: var(--muted); flex: none; margin-top: 2px; }
  .tail-body { display: grid; gap: 3px; min-width: 0; }
  .tail-name { font-size: var(--text-body); font-weight: 600; color: var(--fg); }
  .tail-text { font-size: var(--text-small); color: var(--muted); text-wrap: pretty; }
  .chev { color: var(--meta); align-self: center; line-height: 1; }
  .tail-row:hover .tail-name { text-decoration: underline; text-underline-offset: 4px; }
  .tail-row:hover .tail-glyph { color: var(--fg); }
  .tail-row:hover .chev { color: var(--fg); }
  /* close the list: in two columns the bottom row is the last two items, in one column just the last */
  .tail > li:nth-last-child(-n+2) { border-bottom: 1px solid var(--border-soft); }

  .grid-meta { margin-top: clamp(28px, 3vw, 40px); max-width: 70ch; }

  @media (max-width: 1099px) {
    .flagship { column-gap: 32px; grid-template-columns: minmax(0, 1fr) minmax(0, 380px); }
    .has-photo { grid-template-columns: minmax(0, 1fr) minmax(0, 320px); }
    .tail { column-gap: 32px; }
  }
  @media (max-width: 899px) {
    /* One column, three stacked rows: copy, figures, link. */
    .flagship, .has-photo { grid-template-columns: 1fr; align-items: start; row-gap: 0; }
    .flag-copy { grid-area: 1 / 1; }
    .flag-stat { grid-area: 2 / 1; }
    .flag-link { grid-area: 3 / 1; margin-top: 20px; }
    .flag-title { max-width: none; }
    .flag-stat { text-align: left; padding-top: 32px; border-top: 1px solid var(--border-soft); }
    .stat-line { justify-content: flex-start; }
    .microline { top: 14px; }
    /* photo above the copy on a phone: it is the first thing worth seeing, and a 4:3 crop is
       cheap at this width */
    .has-photo .flag-shot { grid-area: 1 / 1; }
    .has-photo .flag-copy { grid-area: 2 / 1; justify-content: flex-start; margin-top: 24px; }
    .has-photo .flag-link { grid-area: 3 / 1; }
    .modes { grid-template-columns: 1fr; gap: 16px; }
    .tail { grid-template-columns: 1fr; }
    .tail > li { border-bottom: 0; }
    .tail > li:last-child { border-bottom: 1px solid var(--border-soft); }
  }
  @media (max-width: 767px) {
    .flagship { padding: 20px; }
    .mode { padding: 20px; }
    .compare { padding: 20px; }
    .stat-line .stat { font-size: 2.25rem; }
    .compare-grid { grid-template-columns: 1fr; }
    .compare-col { padding: 0; }
    .compare-col + .compare-col { border-left: 0; padding-left: 0; padding-top: 16px; margin-top: 16px; border-top: 1px solid var(--border-soft); }
  }
</style>
