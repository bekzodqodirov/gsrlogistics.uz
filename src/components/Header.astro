---
import { langMeta, locales, type Lang } from '@/i18n/config';
import { pagePath } from '@/i18n/routes';
import { common } from '@/i18n/common';
import { site, phoneUrl, telegramChat } from '@/lib/site';
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
interface Props { lang: Lang; alternates: Array<{ lang: Lang; href: string }>; currentPath: string }
const { lang, alternates, currentPath } = Astro.props;
const t = common[lang];
const isActive = (href: string) => href !== '/' && href !== '/ru/' && href !== '/en/' && currentPath.startsWith(href);
---
<header class="site-header" id="site-header" data-scrolled="false">
  <div class="container header-inner">
    <a href={pagePath(lang, 'home')} class="brand" aria-label={`${site.name} — ${t.breadcrumbHome}`}>
      <Logo size={30} />
    </a>
    <nav class="nav-desktop" aria-label="Main">
      <ul role="list">
        {t.nav.map((n) => { const href = pagePath(lang, n.key); return <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}>{n.label}</a></li>; })}
      </ul>
    </nav>
    <div class="header-actions">
      <div class="lang" role="group" aria-label={t.header.langLabel}>
        {locales.map((l) => { const alt = alternates.find((a) => a.lang === l); const href = alt ? new URL(alt.href).pathname : pagePath(l, 'home'); return <a href={href} hreflang={langMeta[l].htmlLang} lang={langMeta[l].htmlLang} aria-current={l === lang ? 'true' : undefined} title={langMeta[l].label}>{langMeta[l].short}</a>; })}
      </div>
      <a href={phoneUrl} class="phone" aria-label={`${t.header.phoneLabel}: ${site.phoneDisplay}`}><Icon name="phone" size={18} /><span class="tnum">{site.phoneDisplay}</span></a>
      <a href={telegramChat(t.telegramDraft.general)} class="btn btn-primary btn-sm header-cta" target="_blank" rel="noopener"><Icon name="telegram" size={16} />{t.cta.telegram}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.header.menu} data-menu-toggle>
        <Icon name="menu" size={22} class="icon-open" /><Icon name="x" size={22} class="icon-close" />
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Main" class="container">
      <ul role="list" class="mobile-nav">
        {t.nav.map((n) => { const href = pagePath(lang, n.key); return <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}>{n.label}<Icon name="chevron-right" size={18} /></a></li>; })}
      </ul>
      <div class="mobile-menu-foot">
        <a href={telegramChat(t.telegramDraft.general)} class="btn btn-primary btn-block" target="_blank" rel="noopener"><Icon name="telegram" size={18} />{t.cta.telegram}</a>
        <a href={phoneUrl} class="btn btn-outline btn-block"><Icon name="phone" size={18} /><span class="tnum">{site.phoneDisplay}</span></a>
        <div class="lang lang-mobile" role="group" aria-label={t.header.langLabel}>
          {locales.map((l) => { const alt = alternates.find((a) => a.lang === l); const href = alt ? new URL(alt.href).pathname : pagePath(l, 'home'); return <a href={href} hreflang={langMeta[l].htmlLang} lang={langMeta[l].htmlLang} aria-current={l === lang ? 'true' : undefined}>{langMeta[l].label}</a>; })}
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: transparent; border-bottom: 1px solid transparent; color: var(--fg); transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .site-header[data-scrolled='true'] { background: rgb(255 255 255 / 0.9); border-bottom-color: var(--border-soft); }
  @media (min-width: 900px) { .site-header[data-scrolled='true'] { -webkit-backdrop-filter: saturate(180%) blur(12px); backdrop-filter: saturate(180%) blur(12px); background: rgb(255 255 255 / 0.72); } }
  .site-header[data-over-dark='true'] { background: rgb(11 11 13 / 0.92) !important; border-bottom-color: rgb(255 255 255 / 0.08); color: var(--gray-100); -webkit-backdrop-filter: none !important; backdrop-filter: none !important; --fg: var(--gray-100); --fg-2: var(--gray-300); --muted: #a1a1a6; --card: var(--gray-900); --bg: var(--black); }
  .nav-desktop a[aria-current='page']::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 2px; background: var(--red-600); border-radius: 2px; }
  .site-header[data-over-dark='true'] .nav-desktop a[aria-current='page']::after { background: var(--red-300); }
  .header-inner { display: flex; align-items: center; gap: 16px; min-height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; color: var(--fg); margin-right: 8px; }
  .nav-desktop { display: none; flex: 1; }
  .nav-desktop ul { display: flex; gap: 2px; align-items: center; }
  .nav-desktop a { position: relative; display: inline-flex; align-items: center; white-space: nowrap; min-height: 40px; padding: 0 12px; border-radius: var(--radius-pill); font-size: 0.9375rem; font-weight: 500; color: var(--fg-2); transition: background var(--dur) var(--ease), color var(--dur) var(--ease); }
  .nav-desktop a:hover { background: color-mix(in oklab, var(--fg), transparent 93%); color: var(--fg); }
  .nav-desktop a[aria-current='page'] { color: var(--fg); }
  .header-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .lang { display: flex; gap: 2px; align-items: center; }
  .lang a { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 6px; border-radius: var(--radius-pill); font-size: 0.875rem; font-weight: 500; color: var(--muted); transition: color var(--dur) var(--ease); }
  .lang a + a::before { content: '·'; margin-right: 6px; color: var(--border); }
  .lang a[aria-current='true'] { color: var(--fg); font-weight: 600; }
  .lang a:hover { color: var(--fg); }
  .phone { display: none; align-items: center; white-space: nowrap; gap: 8px; font-weight: 600; font-size: 0.9375rem; padding: 0 10px; min-height: 40px; border-radius: var(--radius-pill); color: var(--fg); }
  .phone:hover { background: color-mix(in oklab, var(--fg), transparent 93%); }
  .header-cta { display: none; white-space: nowrap; }
  .menu-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: var(--radius-pill); color: var(--fg); }
  .menu-btn:hover { background: color-mix(in oklab, var(--fg), transparent 93%); }
  .menu-btn :global(.icon-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.icon-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.icon-close) { display: block; }
  .mobile-menu { position: fixed; inset: var(--header-h) 0 0 0; z-index: 99; background: var(--bg); overflow-y: auto; padding-block: 8px 24px; }
  .mobile-nav li { border-bottom: 1px solid var(--border-soft); }
  .mobile-nav a { display: flex; align-items: center; justify-content: space-between; min-height: 56px; font-size: 1.125rem; font-weight: 600; color: var(--fg); }
  .mobile-nav a[aria-current='page'] { color: var(--accent-text); }
  .mobile-menu-foot { display: grid; gap: 12px; padding-top: 20px; }
  .lang-mobile { justify-content: space-between; }
  .lang-mobile a { flex: 1; font-size: 0.875rem; letter-spacing: 0; }
  @media (min-width: 900px) { .nav-desktop { display: block; } .menu-btn { display: none; } .mobile-menu { display: none !important; } }
  @media (min-width: 1200px) { .header-cta { display: inline-flex; } }
  @media (min-width: 1360px) { .phone { display: inline-flex; } }
  :global(body.menu-open) { overflow: hidden; }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open; document.body.classList.toggle('menu-open', open); };
    btn.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.setAttribute('data-scrolled', String(window.scrollY > 8));
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
