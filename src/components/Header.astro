---
import { pick, type Locale } from '@/i18n/config';
import { pagePath, itemPath } from '@/i18n/routes';
import { common } from '@/i18n/common';
import { site, phoneUrl, telegramChat } from '@/lib/site';
import { fmtRange } from '@/lib/format';
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import LangSwitcher from './LangSwitcher.astro';
import { services } from '@/data/services';
import tariffs from '@/data/tariffs.json';
interface Props { lang: Locale; alternates: Array<{ lang: Locale; href: string }>; currentPath: string }
const { lang, alternates, currentPath } = Astro.props;
const t = pick(lang, common);
const isActive = (href: string) => href !== '/' && href !== '/ru/' && href !== '/en/' && currentPath.startsWith(href);
const allServices = pick(lang, { uz: 'Barcha xizmatlar', ru: 'Все услуги', en: 'All services' });
const daysFor = (key: string) => key === 'truck' || key === 'air' || key === 'rail' ? fmtRange(tariffs[key].days[0], tariffs[key].days[1], t.strings.days, lang) : '';
---
<header class="site-header" id="site-header" data-scrolled="false">
  <div class="container header-inner">
    <a href={pagePath(lang, 'home')} class="brand" aria-label={`${site.name} — ${t.breadcrumbHome}`}>
      <Logo size={30} />
    </a>
    <nav class="nav-desktop" aria-label={t.header.navLabel}>
      <ul role="list">
        {t.nav.map((n) => { const href = pagePath(lang, n.key); const mega = n.key === 'services'; return (
          <li class:list={[mega && 'has-mega']}>
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{n.label}</a>
            {mega && <button type="button" class="mega-toggle" aria-expanded="false" aria-controls="mega-services" aria-label={allServices}><Icon name="chevron-down" size={14} /></button>}
            {mega && (
              <div class="mega" id="mega-services">
                <ul role="list" class="mega-grid">
                  {services.map((s) => (
                    <li>
                      <a href={itemPath(lang, 'services', s.slug)} class="mega-item">
                        <Icon name={s.icon} size={20} class="mega-icon" />
                        <span class="mega-body"><span class="mega-name">{pick(lang, s.name)}</span><span class="mega-short">{pick(lang, s.short)}</span>{daysFor(s.key) && <span class="mega-days tnum">{daysFor(s.key)}</span>}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a href={href} class="mega-all link">{allServices}</a>
              </div>
            )}
          </li>
        ); })}
      </ul>
    </nav>
    <div class="header-actions">
      <LangSwitcher lang={lang} alternates={alternates} variant="menu" />
      <a href={phoneUrl} class="phone" aria-label={`${t.header.phoneLabel}: ${site.phoneDisplay}`}><Icon name="phone" size={18} /><span class="tnum" dir="ltr">{site.phoneDisplay}</span></a>
      <a href={telegramChat(t.telegramDraft.general)} class="btn btn-primary btn-sm header-cta" target="_blank" rel="noopener" data-picker><Icon name="telegram" size={16} />{t.cta.telegram}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.header.menu} data-menu-toggle>
        <Icon name="menu" size={22} class="icon-open" /><Icon name="x" size={22} class="icon-close" />
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label={t.header.menu} class="container">
      <ul role="list" class="mobile-nav">
        {t.nav.map((n) => { const href = pagePath(lang, n.key); return <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}>{n.label}<Icon name="chevron-right" size={18} /></a></li>; })}
      </ul>
      <div class="mobile-menu-foot">
        <a href={telegramChat(t.telegramDraft.general)} class="btn btn-primary btn-block" target="_blank" rel="noopener" data-picker><Icon name="telegram" size={18} />{t.cta.telegram}</a>
        <a href={phoneUrl} class="btn btn-outline btn-block"><Icon name="phone" size={18} /><span class="tnum" dir="ltr">{site.phoneDisplay}</span></a>
        <LangSwitcher lang={lang} alternates={alternates} variant="grid" />
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: transparent; border-bottom: 1px solid transparent; color: var(--fg); transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .site-header[data-scrolled='true'] { background: rgb(255 255 255 / 0.94); border-bottom-color: var(--border-soft); }
  @media (min-width: 900px) { .site-header[data-scrolled='true'] { -webkit-backdrop-filter: saturate(180%) blur(12px); backdrop-filter: saturate(180%) blur(12px); background: rgb(255 255 255 / 0.92); } }
  /* Mobile sheet open: header must be fully opaque so the page cannot bleed through the 64px strip above the sheet. */
  :global(body.menu-open) .site-header { background: var(--bg) !important; border-bottom-color: var(--border-soft); -webkit-backdrop-filter: none !important; backdrop-filter: none !important; transition: none; }
  .site-header[data-over-dark='true'] { background: rgb(11 11 13 / 0.92) !important; border-bottom-color: rgb(255 255 255 / 0.08); color: var(--gray-100); -webkit-backdrop-filter: none !important; backdrop-filter: none !important; --fg: var(--gray-100); --fg-2: var(--gray-300); --muted: #a1a1a6; --card: var(--gray-900); --bg: var(--black); }
  .nav-desktop > ul > li > a[aria-current='page']::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 2px; background: var(--red-600); border-radius: 2px; }
  .site-header[data-over-dark='true'] .nav-desktop > ul > li > a[aria-current='page']::after { background: var(--red-300); }
  .header-inner { display: flex; align-items: center; gap: 12px; min-height: var(--header-h); min-width: 0; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; color: var(--fg); margin-inline-end: 8px; }
  .nav-desktop { display: none; flex: 1 1 auto; }
  .nav-desktop > ul { display: flex; gap: 2px; align-items: center; }
  .nav-desktop > ul > li > a { position: relative; display: inline-flex; align-items: center; white-space: nowrap; min-height: 40px; padding: 0 10px; border-radius: var(--radius-pill); font-size: 0.9375rem; font-weight: 500; color: var(--fg-2); transition: background var(--dur) var(--ease), color var(--dur) var(--ease); }
  .nav-desktop > ul > li > a:hover { background: color-mix(in oklab, var(--fg), transparent 93%); color: var(--fg); }
  .nav-desktop > ul > li > a[aria-current='page'] { color: var(--fg); }
  .has-mega { position: relative; display: inline-flex; align-items: center; }
  .mega-toggle { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 40px; margin-inline-start: -8px; color: var(--muted); border-radius: var(--radius-pill); }
  .mega-toggle:hover, .mega-toggle[aria-expanded='true'] { color: var(--fg); }
  /* Opens from the Services item toward the inline end: rightwards on LTR pages, leftwards on the RTL
     one. Services is always the first item after the 170px logo, so its inline-start edge sits ~214px
     from the viewport edge; the width keeps the panel's far edge a gutter inside the viewport from
     900px (the full logo leaves it ~26px short of 720 there) and is 720px from ~955px up. */
  .mega { position: absolute; top: calc(100% + 8px); inset-inline-start: -8px; width: min(720px, calc(100vw - 232px)); padding: 12px; background: var(--card); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); box-shadow: var(--shadow-float); opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), visibility 0s linear var(--dur); z-index: 5; }
  /* Without JS the panel opens on hover and focus alone. Once the script boots it adds .mega-js and
     takes over, so Escape can actually close a panel the pointer or focus is still inside. */
  .has-mega.is-open .mega, .has-mega:not(.mega-js):hover .mega, .has-mega:not(.mega-js):focus-within .mega { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .mega-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .mega-item { display: flex; gap: 12px; padding: 10px 12px; border-radius: var(--radius); color: var(--fg); min-height: 0; }
  .mega-item:hover { background: var(--bg-2); }
  /* :global() is required — Astro does not stamp this component's scope onto an <svg> rendered by a
     child component, so a bare `.mega-icon` never matches and the icon was flex-shrunk to 14–18px. */
  .mega-item :global(.mega-icon) { flex: none; margin-top: 2px; }
  .mega-body { display: grid; gap: 2px; }
  .mega-name { font-weight: 600; font-size: 0.9375rem; white-space: normal; }
  .mega-short { font-size: 0.8125rem; color: var(--muted); white-space: normal; line-height: 1.35; }
  .mega-days { font-size: 0.75rem; color: var(--meta); }
  .mega-all { display: inline-flex; margin: 8px 12px 4px; font-size: var(--text-small); }
  .site-header[data-over-dark='true'] .mega { background: var(--gray-900); border-color: rgb(255 255 255 / 0.08); }
  .site-header[data-over-dark='true'] .mega-item:hover { background: rgb(255 255 255 / 0.06); }
  .header-actions { display: flex; align-items: center; gap: 8px; margin-inline-start: auto; }
  .phone { display: none; align-items: center; white-space: nowrap; gap: 8px; font-weight: 600; font-size: 0.9375rem; padding: 0 10px; min-height: 40px; border-radius: var(--radius-pill); color: var(--fg); }
  .phone:hover { background: color-mix(in oklab, var(--fg), transparent 93%); }
  .header-cta { display: none; white-space: nowrap; }
  .menu-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: var(--radius-pill); color: var(--fg); }
  .menu-btn:hover { background: color-mix(in oklab, var(--fg), transparent 93%); }
  .menu-btn :global(.icon-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.icon-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.icon-close) { display: block; }
  .mobile-menu { position: fixed; inset: var(--header-h) 0 0 0; z-index: 99; background: var(--bg); overflow-y: auto; padding-block: 8px 24px; }
  .mobile-nav li { border-bottom: 1px solid var(--border-soft); }
  .mobile-nav a { display: flex; align-items: center; justify-content: space-between; min-height: 56px; font-size: 1.125rem; font-weight: 600; color: var(--fg); }
  .mobile-nav a[aria-current='page'] { color: var(--accent-text); }
  .mobile-menu-foot { display: grid; gap: 12px; padding-top: 20px; }
  @media (min-width: 900px) { .nav-desktop { display: block; } .menu-btn { display: none; } .mobile-menu { display: none !important; } }
  @media (min-width: 1280px) { .header-cta { display: inline-flex; } }
  :global(html:lang(ru)) .nav-desktop > ul > li > a { font-size: 0.875rem; padding: 0 8px; }
  /* 900–1023px: logo + nav + language trigger in ~850px. The two Uzbek navs are the longest (Latin
     615px, Cyrillic 676px at 15px/10px; ru 569, fa 550, en 548, zh 513), so below 1024px they tighten
     like the ru nav does everywhere — Latin to 14px/8px (556px), Cyrillic to 13px/6px (552px) —
     which leaves every locale ≥8px spare at 900px. From 1024px all six fit as they are. */
  @media (min-width: 900px) and (max-width: 1023px) {
    :global(html:lang(uz-Latn)) .nav-desktop > ul > li > a { font-size: 0.875rem; padding: 0 8px; }
    :global(html:lang(uz-Cyrl)) .nav-desktop > ul > li > a { font-size: 0.8125rem; padding: 0 6px; }
  }
  /* Below the desktop breakpoint the bar holds the logo, the language trigger and the menu button;
     the compact trigger (LangSwitcher.astro) is what lets all three fit a 320px phone at full size. */
  @media (max-width: 899px) {
    .header-inner { gap: 8px; }
    .brand { margin-inline-end: 0; }
  }
  /* Under 360px the trigger loses its globe and the actions close up, so the widest label (中文)
     still leaves the 30px logo mark ~6px to spare at 320px. */
  @media (max-width: 359px) { .header-actions { gap: 4px; } }
  @media (min-width: 1520px) { .phone { display: inline-flex; } }
  :global(body.menu-open) { overflow: hidden; }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open; document.body.classList.toggle('menu-open', open); };
    // `hidden` is typed `boolean | 'until-found'` by lib.dom; this element's is only ever written
    // by `set` two lines up, which writes a boolean.
    btn.addEventListener('click', () => set(menu.hidden as boolean));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
  const megaToggle = document.querySelector<HTMLButtonElement>('.mega-toggle');
  const megaHost = megaToggle?.closest<HTMLElement>('.has-mega');
  if (megaToggle && megaHost) {
    // One open state drives both the class and aria-expanded, so a screen reader never hears
    // "collapsed" while the links inside are focusable, and Escape closes even under hover or focus.
    megaHost.classList.add('mega-js');
    let hover = false;
    let focus = false;
    let pinned = false;
    let dismissed = false;
    const apply = () => {
      const open = !dismissed && (hover || focus || pinned);
      megaHost.classList.toggle('is-open', open);
      megaToggle.setAttribute('aria-expanded', String(open));
    };
    megaToggle.addEventListener('click', () => { dismissed = false; pinned = !pinned; apply(); });
    megaHost.addEventListener('pointerenter', () => { dismissed = false; hover = true; apply(); });
    megaHost.addEventListener('pointerleave', () => { hover = false; apply(); });
    megaHost.addEventListener('focusin', () => { focus = true; apply(); });
    megaHost.addEventListener('focusout', (e) => {
      if (megaHost.contains(e.relatedTarget as Node)) return;
      focus = false; pinned = false; dismissed = false; apply();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !megaHost.classList.contains('is-open')) return;
      // move focus out before hiding, or it would be left on a visibility:hidden link
      if (megaHost.contains(document.activeElement)) megaToggle.focus();
      dismissed = true; pinned = false; apply();
    });
    document.addEventListener('click', (e) => { if (!megaHost.contains(e.target as Node)) { pinned = false; hover = false; apply(); } });
  }
  const header = document.getElementById('site-header');
  if (header) {
    // one rAF-batched write per frame, and only on an actual state change — the naive version wrote an
    // attribute (and invalidated style) on every scroll event, alongside the journey's scrub
    let scrolled: boolean | null = null;
    let queued = false;
    const applyScrolled = () => {
      queued = false;
      const next = window.scrollY > 8;
      if (next === scrolled) return;
      scrolled = next;
      header.setAttribute('data-scrolled', String(next));
    };
    const onScroll = () => { if (queued) return; queued = true; requestAnimationFrame(applyScrolled); };
    applyScrolled();
    window.addEventListener('scroll', onScroll, { passive: true });

    // White glass over a dark band composites to mud and drops the nav below 4.5:1, so the header
    // switches to its dark treatment whenever any .dark section sits under the header strip. The
    // negative bottom margin shrinks the observation root to exactly that strip.
    const darkEls = document.querySelectorAll('.dark');
    if (darkEls.length && 'IntersectionObserver' in window) {
      const over = new Set<Element>();
      let io: IntersectionObserver | null = null;
      const observe = () => {
        io?.disconnect();
        over.clear();
        const strip = header.offsetHeight || 64;
        io = new IntersectionObserver((entries) => {
          for (const e of entries) { if (e.isIntersecting) over.add(e.target); else over.delete(e.target); }
          header.setAttribute('data-over-dark', String(over.size > 0));
        }, { rootMargin: `0px 0px -${Math.max(0, window.innerHeight - strip)}px 0px`, threshold: 0 });
        darkEls.forEach((el) => io!.observe(el));
      };
      observe();
      let resizeTimer = 0;
      window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(observe, 200); });
    }
  }
</script>
