---
/**
 * Lead form (DESIGN_BRIEF §7.4). Fields: name, phone (+998, light mask), service select,
 * cargo textarea, consent checkbox → privacy page, honeypot.
 *
 * Phone, by locale. uz, uzc, ru, en: the +998 mask (prefilled on focus, forced, +998 XX XXX XX XX).
 * zh and fa (decision of 2026-11-10): any international number — "+" prefilled on focus, no country
 * forced, a leading 00 read as +, valid when the digits after the + make an E.164 number
 * (^\+[1-9]\d{6,14}$ once the spaces are removed). Every mode reads Persian, Arabic-Indic and
 * full-width digits and keeps ASCII in the field, so the number reaches the manager dialable. The
 * phone input is an LTR island (dir="ltr"); on an RTL page it sits on the start side (text-align: right).
 *
 * Submit flow (bundled script): validate, then hand the answers to the chat flow every Telegram
 * button uses (a "gsr:lead" event → components/ContactPicker.astro). That asks GSR's system for the
 * least busy manager of the chosen service's team, shows the manager and the message — «Kod: GSR-…»
 * over one line: name · phone · service · cargo — and opens Telegram. Owner, 2026-09-26: GSR's own
 * system is where leads live, so the form no longer posts anywhere itself (it used to POST to
 * /api/lead, a Cloudflare function that GitHub Pages never ran). The site stores nothing.
 * The cargo field is short on purpose: GSR asks for the whole message to stay near 300 characters.
 * Without JS the form is a plain GET to the company's Telegram chat: the textarea is named `text`,
 * which t.me reads as the draft; other fields travel as harmless extra params.
 * Props: { lang, id?, dark? }.
 */
import { pick, langMeta, type Locale } from '@/i18n/config';
import { contact } from '@/i18n/contact';
import { pagePath } from '@/i18n/routes';
import { site, telegramChat } from '@/lib/site';
import { serviceTeam } from '@/lib/leads';
import Icon from '@/components/ui/Icon.astro';

interface Props { lang: Locale; id?: string; dark?: boolean }
const { lang, id = 'lead', dark = false } = Astro.props;
/** The locales whose visitors leave any country's number (see the header); every other keeps the +998 mask. */
const INTL_PHONE: readonly Locale[] = ['zh', 'fa'];
const intlPhone = INTL_PHONE.includes(lang);
/** On an RTL page a Latin name or a pasted list should align as typed. */
const textDir = langMeta[lang].dir === 'rtl' ? 'auto' : undefined;
const t = pick(lang, contact).form;
const uid = (s: string) => `${id}-${s}`;
const privacyHref = pagePath(lang, 'privacy');
const [consentBefore, consentAfter] = t.consent.split('{link}');
const routes = [
  { value: 'truck', label: t.routeOptions.truck },
  { value: 'air', label: t.routeOptions.air },
  { value: 'rail', label: t.routeOptions.rail },
  { value: 'sourcing', label: t.routeOptions.sourcing },
  { value: 'other', label: t.routeOptions.other },
];
/** Which team gets the lead for each route choice — the same split as the service pages. */
const routeTeam = { truck: serviceTeam.truck, air: serviceTeam.air, rail: serviceTeam.rail, sourcing: serviceTeam.sourcing, other: 'general' };
const i18n = JSON.stringify({ errors: t.errors, draft: t.draft, routes: Object.fromEntries(routes.map((r) => [r.value, r.label])) });
---
<form
  class:list={['lead', dark && 'is-dark']}
  id={id}
  method="get"
  action={telegramChat()}
  data-lead
  data-lang={lang}
  data-phone={intlPhone ? 'intl' : undefined}
  data-tg={site.telegramDirect}
  data-route-team={JSON.stringify(routeTeam)}
  data-i18n={i18n}
  aria-labelledby={uid('title')}
>
  <div class="lead-head">
    <h2 id={uid('title')} class="lead-title">{t.title}</h2>
    <p class="lead-lead">{t.lead}</p>
  </div>

  <div class="lead-fields" data-el="fields">
    <div class="field">
      <label for={uid('name')}>{t.name}</label>
      <input class="input" id={uid('name')} name="name" type="text" autocomplete="name" placeholder={t.namePlaceholder} required maxlength="60" data-el="name" dir={textDir} aria-describedby={uid('name-err')} />
      <p class="err" id={uid('name-err')} data-err="name" hidden></p>
    </div>

    <div class="field">
      <label for={uid('phone')}>{t.phone}</label>
      <input class="input tnum" id={uid('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" placeholder={intlPhone ? '+' : '+998'} required maxlength={intlPhone ? 24 : 20} data-el="phone" aria-describedby={`${uid('phone-hint')} ${uid('phone-err')}`} />
      <p class="hint" id={uid('phone-hint')}>{t.phoneHint}</p>
      <p class="err" id={uid('phone-err')} data-err="phone" hidden></p>
    </div>

    <div class="field">
      <label for={uid('route')}>{t.route}</label>
      <select class="select" id={uid('route')} name="route" data-el="route">
        <option value="">{t.routePlaceholder}</option>
        {routes.map((r) => <option value={r.value}>{r.label}</option>)}
      </select>
    </div>

    <div class="field">
      <label for={uid('text')}>{t.cargo}</label>
      <textarea class="textarea" id={uid('text')} name="text" rows="4" placeholder={t.cargoPlaceholder} required maxlength="180" data-el="text" dir={textDir} aria-describedby={`${uid('text-hint')} ${uid('text-err')}`}></textarea>
      <p class="hint" id={uid('text-hint')}>{t.cargoHint}</p>
      <p class="err" id={uid('text-err')} data-err="cargo" hidden></p>
    </div>

    <!-- Honeypot: hidden from people, filled by bots. Never labelled as a real field. -->
    <div class="hp" aria-hidden="true">
      <label for={uid('website')}>Website</label>
      <input id={uid('website')} name="website" type="text" tabindex="-1" autocomplete="off" data-el="hp" />
    </div>

    <div class="field">
      <label class="checkbox" for={uid('consent')}>
        <input id={uid('consent')} name="consent" type="checkbox" value="yes" required data-el="consent" aria-describedby={uid('consent-err')} />
        <span>{consentBefore}<a href={privacyHref} class="consent-link">{t.consentLink}</a>{consentAfter}</span>
      </label>
      <p class="err" id={uid('consent-err')} data-err="consent" hidden></p>
    </div>

    <input type="hidden" name="page" value={Astro.url.pathname} data-el="page" />
    <input type="hidden" name="lang" value={lang} />

    <div class="lead-actions">
      <button type="submit" class="btn btn-primary" data-el="submit"><Icon name="telegram" size={18} />{t.submit}</button>
      <noscript><p class="hint nojs">{t.noJs}</p></noscript>
    </div>
  </div>

  <div class="panel panel-ok" data-el="success" role="status" aria-live="polite" tabindex="-1" hidden>
    <span class="panel-glyph"><Icon name="check-circle" size={24} /></span>
    <p class="panel-title">{t.success.title}</p>
    <p class="panel-text">{t.success.text}</p>
    <button type="button" class="link" data-el="again">{t.success.again}</button>
  </div>

</form>

<style>
  .lead { display: grid; gap: 20px; }
  .lead-title { font-size: var(--text-h3); font-weight: 600; }
  .lead-lead { margin-top: 8px; color: var(--muted); text-wrap: pretty; }
  .lead-fields { display: grid; gap: 18px; }
  .err { font-size: var(--text-small); color: #d93025; }
  .lead.is-dark .err { color: #ff7a7d; }
  .lead :global(.input[aria-invalid='true']), .lead :global(.textarea[aria-invalid='true']) { border-color: #d93025; }
  /* inset-inline-start: in RTL the far left is the scrollable side, so a physical left: -10000px gave
     the contact page 10 000px of horizontal overflow; the start side is never scrollable. */
  .hp { position: absolute; inset-inline-start: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  /* The phone is an LTR island (dir="ltr"); on an RTL page it still sits on the start side, under its label. */
  :global([dir='rtl']) .lead input[type='tel'] { text-align: right; }
  .checkbox { cursor: pointer; }
  .consent-link { text-decoration: underline; text-underline-offset: 3px; color: var(--fg); }
  .lead-actions { display: grid; gap: 10px; }
  .lead-actions :global(.btn) { width: 100%; }
  .nojs { margin-top: 4px; }
  .panel { display: grid; gap: 10px; padding: 24px; border: 1px solid var(--border-soft); border-radius: var(--radius-lg); background: var(--bg-3); }
  .lead.is-dark .panel { background: rgb(255 255 255 / 0.04); border-color: rgb(255 255 255 / 0.1); }
  .panel-glyph { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border-radius: 50%; background: var(--bg); border: 1px solid var(--border-soft); color: var(--fg); }
  .lead.is-dark .panel-glyph { background: rgb(255 255 255 / 0.06); border-color: rgb(255 255 255 / 0.1); }
  .panel-title { font-weight: 600; font-size: var(--text-h4); }
  .panel-text { color: var(--muted); text-wrap: pretty; }
  .panel .link { justify-self: start; min-height: 44px; }
  @media (min-width: 900px) {
    /* start, or a row's shorter control stretches to the taller one and their top edges disagree */
    .lead-fields { grid-template-columns: 1fr 1fr; align-items: start; }
    .lead-fields > .field:nth-child(3), .lead-fields > .field:nth-child(4), .lead-fields > .field:nth-child(6), .lead-actions { grid-column: 1 / -1; }
    .lead-actions :global(.btn) { width: auto; justify-self: start; }
  }
</style>

<script>
  interface LeadI18n {
    errors: { name: string; phone: string; cargo: string; consent: string };
    draft: { intro: string; name: string; phone: string; route: string; cargo: string; page: string };
    routes: Record<string, string>;
  }
  interface LeadEventDetail { team: string; topic?: string; summary: string; trigger?: HTMLElement; handled?: boolean }

  import { sep, toAsciiDigits } from '@/lib/format';
  import type { Locale } from '@/i18n/config';

  const forms = document.querySelectorAll<HTMLFormElement>('form[data-lead]');

  /** Light +998 mask: keeps digits (any digit set — a Persian keypad's ۹۰ is 90), forces the 998 prefix, groups as +998 XX XXX XX XX. */
  function formatPhone(raw: string): string {
    let d = toAsciiDigits(raw).replace(/\D/g, '');
    // Strip repeated country prefixes: the field pre-fills '+998 ', so a pasted '+998 90 …' or
    // '998901234567' would otherwise leave a doubled 998 in front of the subscriber number.
    while (d.startsWith('998') && d.length > 9) d = d.slice(3);
    if (d.startsWith('8') && d.length === 10) d = d.slice(1);
    d = d.slice(0, 9);
    const parts = [d.slice(0, 2), d.slice(2, 5), d.slice(5, 7), d.slice(7, 9)].filter(Boolean);
    return '+998' + (parts.length ? ' ' + parts.join(' ') : '');
  }
  const phoneOk = (v: string) => /^\+998\d{9}$/.test(v.replace(/\s/g, ''));

  /**
   * zh and fa: any international number, as typed. ASCII digits; a single leading "+" (a leading 00,
   * the international prefix, becomes it); spaces, brackets and dashes kept as the visitor groups them;
   * nothing else. No country is assumed and nothing is regrouped.
   */
  function cleanIntl(raw: string): string {
    let s = toAsciiDigits(raw).replace(/[^\d\s()+-]/g, '').replace(/\s+/g, ' ').replace(/^\s+/, '');
    s = s.replace(/^\+?00(?=\d)/, '+'); // "0098…", or "+0098…" typed after the prefilled "+"
    const lead = s.startsWith('+') ? '+' : '';
    return lead + s.replace(/\+/g, '');
  }
  /** E.164: a "+", a country code that does not start with 0, 7 to 15 digits in all. */
  const intlOk = (v: string) => /^\+[1-9]\d{6,14}$/.test(cleanIntl(v).replace(/[\s()-]/g, ''));

  forms.forEach((form) => {
    const i18n = JSON.parse(form.dataset.i18n || '{}') as LeadI18n;
    const q = <T extends HTMLElement>(sel: string) => form.querySelector<T>(`[data-el="${sel}"]`)!;
    const fields = q<HTMLElement>('fields');
    const name = q<HTMLInputElement>('name');
    const phone = q<HTMLInputElement>('phone');
    const route = q<HTMLSelectElement>('route');
    const text = q<HTMLTextAreaElement>('text');
    const hp = q<HTMLInputElement>('hp');
    const consent = q<HTMLInputElement>('consent');
    const submit = q<HTMLButtonElement>('submit');
    const success = q<HTMLElement>('success');
    const tgBase = form.dataset.tg || '';
    const routeTeam: Record<string, string> = (() => { try { return JSON.parse(form.dataset.routeTeam || '{}'); } catch { return {}; } })();

    const lang = (form.dataset.lang || 'uz') as Locale;
    /** zh/fa: any international number (data-phone="intl"); everywhere else the +998 mask. */
    const intl = form.dataset.phone === 'intl';

    // Progressive enhancement: JS owns submission from here on; keep the GET action only as a no-JS path.
    form.setAttribute('data-enhanced', 'true');
    form.noValidate = true; // JS owns validation and its localized messages; no-JS keeps the native one
    if (intl) {
      phone.addEventListener('focus', () => { if (!phone.value) phone.value = '+'; });
      phone.addEventListener('input', () => {
        const typed = phone.value;
        const next = cleanIntl(typed);
        if (next === typed) return;
        // Keep the caret where the visitor is typing: what survives of the text before it.
        const caret = cleanIntl(typed.slice(0, phone.selectionStart ?? typed.length)).length;
        phone.value = next;
        try { phone.setSelectionRange(caret, caret); } catch { /* the field is not focused */ }
      });
      phone.addEventListener('blur', () => { const v = cleanIntl(phone.value).trim(); phone.value = v === '+' ? '' : v; });
    } else {
      phone.addEventListener('focus', () => { if (!phone.value) phone.value = '+998 '; });
      phone.addEventListener('input', () => { phone.value = formatPhone(phone.value); });
      phone.addEventListener('blur', () => { if (phone.value.trim() === '+998') phone.value = ''; });
    }

    const setError = (key: string, el: HTMLElement | null, msg: string) => {
      const box = form.querySelector<HTMLElement>(`[data-err="${key}"]`);
      if (box) { box.textContent = msg; box.hidden = !msg; }
      if (el) { if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid'); }
    };
    const validate = (): boolean => {
      let firstBad: HTMLElement | null = null;
      const check = (ok: boolean, key: string, el: HTMLElement, msg: string) => { setError(key, el, ok ? '' : msg); if (!ok && !firstBad) firstBad = el; };
      check(name.value.trim().length >= 2, 'name', name, i18n.errors.name);
      if (intl) phone.value = cleanIntl(phone.value).trim(); // an autofilled or pasted value, normalised before it is checked and sent
      check(intl ? intlOk(phone.value) : phoneOk(phone.value), 'phone', phone, i18n.errors.phone);
      check(text.value.trim().length >= 5, 'cargo', text, i18n.errors.cargo);
      check(consent.checked, 'consent', consent, i18n.errors.consent);
      if (firstBad) (firstBad as HTMLElement).focus();
      return !firstBad;
    };

    /** The one line the manager reads on the lead: name · phone · service · cargo (fa joins with " • "). */
    const summary = () => [name.value, phone.value, route.value ? i18n.routes[route.value] ?? '' : '', text.value]
      .map((v) => v.replace(/\s+/g, ' ').trim()).filter(Boolean).join(sep(lang));
    /** The labelled message, for the one case the chat flow is missing from the page. */
    const compose = (): string => {
      const d = i18n.draft;
      const lines = [d.intro, `${d.name}: ${name.value.trim()}`, `${d.phone}: ${phone.value.trim()}`];
      if (route.value) lines.push(`${d.route}: ${i18n.routes[route.value] ?? route.value}`);
      lines.push(`${d.cargo}: ${text.value.trim()}`);
      lines.push(`${d.page}: ${location.origin}${location.pathname}`);
      return lines.join('\n');
    };
    const show = (panel: HTMLElement) => { fields.hidden = true; success.hidden = panel !== success; panel.focus?.(); };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validate()) return;
      if (hp.value) { show(success); return; } // bot: pretend success, send nothing, ask GSR for no one
      const detail: LeadEventDetail = { team: routeTeam[route.value] || 'general', topic: 'ariza', summary: summary(), trigger: submit };
      document.dispatchEvent(new CustomEvent('gsr:lead', { detail }));
      if (!detail.handled) location.assign(`${tgBase}?text=${encodeURIComponent(compose())}`);
    });

    form.querySelectorAll<HTMLButtonElement>('[data-el="again"]').forEach((b) => b.addEventListener('click', () => {
      form.reset(); fields.hidden = false; success.hidden = true; name.focus();
    }));
  });
</script>
