---
import { langMeta, locales, type Locale } from '@/i18n/config';
import { alternates, pageUrl, subFor, type PageKey } from '@/i18n/routes';
import { site } from '@/lib/site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Route key + per-locale item slugs, used for canonical + hreflang. */
  pageKey: PageKey;
  subs?: Partial<Record<Locale, string>>;
  ogImage?: string; // absolute or site-relative
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}
const { lang, title, description, pageKey, subs, ogImage = '/og/default.png', ogType = 'website', noindex = false, publishedTime, modifiedTime } = Astro.props;
const siteUrl = Astro.site ?? new URL(site.url);
// `subFor`, not `subs?.[lang]`: a `subs` map built from content has no uzc entry, and the
// canonical of /kirill/хизматлар/авто-карго/ would collapse to the services index.
const canonical = pageUrl(siteUrl, lang, pageKey, subs && subFor(lang, pageKey, subs));
const alts = alternates(siteUrl, pageKey, subs);
const ogImageAbs = new URL(ogImage, siteUrl).toString();
/**
 * <title> must stay legible in a SERP (~580px) while the page keeps its long, question-shaped H1
 * for humans and AI answer engines. So: cut a long title at its first natural boundary (?, :, —),
 * and append the brand only when there is room.
 *
 * The budget is in characters because that is what we can count here, but Google cuts on pixels,
 * and Cyrillic runs about 11% wider per character than Latin. Measured across the 29 page titles:
 * at one shared budget of 62, Uzbek Latin put 2 titles over 580px and Uzbek Cyrillic put 16. So
 * the Cyrillic locale gets its own, narrower one. uz/ru/en keep 62 exactly, by construction.
 */
const titleBudget = lang === 'uzc' ? 56 : 62;
const shortTitle = (() => {
  if (title.length <= titleBudget) return title;
  const m = title.match(new RegExp(`^(.{25,${titleBudget}}?[?:—])\\s`));
  if (m) return m[1].replace(/[:—]$/, '').trim();
  const cut = title.slice(0, titleBudget);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s|,:—]+(?:GSR|\S{1,2})$/u, '').replace(/[,:—|]$/, '').trim() + '…';
})();
const fullTitle = shortTitle.includes(site.name) || shortTitle.length > 48 ? shortTitle : `${shortTitle} — ${site.name}`;
// Meta description: trim to ≤160 chars at a sentence/clause boundary (the page keeps the full text in its intro).
const metaDescription = (() => {
  if (description.length <= 160) return description;
  const cut = description.slice(0, 158);
  const at = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('; '), cut.lastIndexOf(' — '), cut.lastIndexOf(', '));
  return (at > 90 ? cut.slice(0, at + 1).trim().replace(/[,;]$/, '…') : cut.replace(/\s+\S*$/, '') + '…').trim();
})();
---
<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
{alts.map((a) => <link rel="alternate" hreflang={langMeta[a.lang].htmlLang} href={a.href} />)}
{alts.find((a) => a.lang === 'uz') && <link rel="alternate" hreflang="x-default" href={alts.find((a) => a.lang === 'uz')!.href} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={langMeta[lang].ogLocale} />
{locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={langMeta[l].ogLocale} />)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageAbs} />
