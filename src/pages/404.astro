---
/**
 * The 404 in every locale. One <h1> only: the Uzbek Latin copy is in the markup and a tiny inline
 * script swaps the strings (and the block's lang) when the URL sits under /ru/, /en/ or /kirill/.
 * Rendering four blocks and hiding three put four <h1> elements in the document, which every
 * validator and h1-counting check flags.
 *
 * The Cyrillic copy is not hand-written: `pick()` transliterates the Uzbek branch, exactly as every
 * /kirill/ page does, so the 404 can never drift out of step with the locale it belongs to.
 *
 * The script tests `/kirill` without a trailing slash as well, so that a 404 served for the locale's
 * own root is recognised too; `/ru/` and `/en/` never need that because neither is ever the last
 * segment of a missing path that a reader would land on.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import { locales, langMeta, pick } from '@/i18n/config';
import { common } from '@/i18n/common';
import { pagePath } from '@/i18n/routes';
import { telegramChat } from '@/lib/site';

const copy = Object.fromEntries(
  locales.map((l) => {
    const c = pick(l, common);
    return [
      l,
      {
        lang: langMeta[l].htmlLang,
        title: c.notFound.title,
        text: c.notFound.text,
        home: c.notFound.home,
        homeHref: pagePath(l, 'home'),
        tg: c.cta.telegram,
        tgHref: telegramChat(c.telegramDraft.general),
      },
    ];
  }),
);
const uz = copy.uz;
---
<Base lang="uz" title="404 — Sahifa topilmadi" description="Bu sahifa topilmadi." pageKey="home" noindex hideMobileBar>
  <section class="section nf">
    <div class="container">
      <div class="nf-block" lang={uz.lang} data-nf={JSON.stringify(copy)}>
        <p class="eyebrow">404</p>
        <h1 class="display-2 measure-head" data-nf-title>{uz.title}</h1>
        <p class="intro" style="max-width:52ch;margin-top:16px" data-nf-text>{uz.text}</p>
        <div class="cluster" style="margin-top:32px">
          <a href={uz.homeHref} class="btn btn-primary" data-nf-home>{uz.home}</a>
          <a href={uz.tgHref} class="btn btn-secondary" target="_blank" rel="noopener" data-nf-tg><Icon name="telegram" size={18} /><span data-nf-tg-label>{uz.tg}</span></a>
        </div>
      </div>
      <svg class="nf-van" viewBox="0 0 240 80" width="240" height="80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 62h236" stroke-dasharray="4 6" opacity=".5"></path>
        <path d="M60 58V30h56l16 12v16H60Z"></path><path d="M116 30v12h16M70 58v-8h30v8"></path>
        <circle cx="76" cy="60" r="6"></circle><circle cx="118" cy="60" r="6"></circle>
        <path d="M150 42h10M150 36h18M150 48h6" opacity=".6"></path>
      </svg>
    </div>
  </section>
  <script is:inline>
    (function () {
      var w = document.querySelector('[data-nf]');
      if (!w) return;
      var p = location.pathname;
      var l = p.indexOf('/ru/') === 0 ? 'ru' : p.indexOf('/en/') === 0 ? 'en' : p === '/kirill' || p.indexOf('/kirill/') === 0 ? 'uzc' : 'uz';
      if (l === 'uz') return;
      var d;
      try { d = JSON.parse(w.getAttribute('data-nf'))[l]; } catch (e) { return; }
      if (!d) return;
      w.setAttribute('lang', d.lang);
      document.documentElement.setAttribute('lang', d.lang);
      w.querySelector('[data-nf-title]').textContent = d.title;
      w.querySelector('[data-nf-text]').textContent = d.text;
      var home = w.querySelector('[data-nf-home]');
      home.textContent = d.home;
      home.setAttribute('href', d.homeHref);
      var tg = w.querySelector('[data-nf-tg]');
      tg.setAttribute('href', d.tgHref);
      w.querySelector('[data-nf-tg-label]').textContent = d.tg;
    })();
  </script>
</Base>
<style>
  .nf { min-height: 70svh; display: grid; align-items: center; }
  .nf-van { margin-top: 48px; color: var(--meta); }
</style>
